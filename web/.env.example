# ModoOps — sin Formspree (contacto directo mailto + WhatsApp)
# Ver docs/marketing-one-pager.md y CONTEXT.md para precios USD canónicos.
PUBLIC_SITE_URL=http://localhost:4321
ODOO_URL=http://localhost:8070
ODOO_DB=modoops_master
BFF_SESSION_DIR=.data/bff-sessions
# Sesiones (G6): memory | file | cookie (default cookie, serverless-safe).
# BFF_SESSION_STORE=cookie
# HMAC de sesiones cookie: OBLIGATORIO en prod (sin esto no bootea).
# BFF_SESSION_SECRET=cambia-esto-en-produccion
# Gate de suspensión por request (G3): TTL del cache en ms (default 45000).
# BFF_GATE_TTL_MS=45000
# Servicio master (G4): OBLIGATORIAS, sin default silencioso (503 si faltan).
# ODOO_ADMIN_LOGIN=admin
# ODOO_ADMIN_PASSWORD=cambia-esto
# Tenants IA — apiKey por tenant (BFF Orquestador, CONTEXT.md:268)
# Servigas ya armado para probar IA: db=modoops_servigas
MODOOPS_AGENT_API_KEY_SERVIGAS=dev-servigas-key-123
MODOOPS_AGENT_API_KEY_DEFAULT=dev-key
MODOOPS_AGENT_QUOTA_DEFAULT=200
MODOOPS_FISCAL_ENABLED=1
# Video-IA S1 — link externo del generador (sin esto la API responde 503 cerrado)
# VIDEO_ACCESS_URL=https://video.stub/nuevo
