---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Button from "../../../components/ui/Button.astro";
import { BffError } from "../../../lib/bff/errors.ts";
import { invalidateBffSession } from "../../../lib/bff/http.ts";
import { loadTenantLauncher } from "../../../lib/bff/launcher.ts";
import { withMasterSession } from "../../../lib/bff/tenant-status.ts";
import { resumenHome } from "../../../lib/bff/home.ts";


export const prerender = false;

// Hub 2 — launcher por tenant (q2 recomendado): /tenant/[slug]/app tenant-scoped
const slug = String(Astro.params.slug || "").trim();
if (!slug || !/^[a-z0-9_]+$/.test(slug)) {
  return new Response("slug inválido", { status: 400 });
}

const _sessT = (Astro.locals as Record<string, unknown>).session as { name?: string; login?: string } | undefined;
const _odooT = (Astro.locals as Record<string, unknown>).odooSessionId as string | undefined;
if (!_odooT) return Astro.redirect("/login");
let odooSessionId: string = _odooT;
let userName = _sessT?.name || _sessT?.login || "";

// Solo interno Hub1 q5: si no es admin/modoops, igual allow para demo — en prod check groups_id
let tenant: import("../../../lib/bff/backend-client.ts").TenantRow | null = null;
let tenantError = "";
let tiles: import("../../../lib/bff/types.ts").LauncherTile[] = [];
let launcherError = "";
// G8 launcher real: metadata vía master + tiles vía DB del tenant, sin
// fallback silencioso a master. Si la DB tenant no responde, se muestra
// estado explícito en vez de tiles ficticios.
try {
  const res = await loadTenantLauncher(slug, odooSessionId);
  tenant = res.tenant;
  tiles = res.tiles;
} catch (cause) {
  if (cause instanceof BffError && cause.code === "unauthorized") {
    invalidateBffSession(Astro.cookies);
    return Astro.redirect("/login");
  }
  if (cause instanceof BffError && cause.code === "not_found") {
    tenantError = cause.message;
  } else {
    // La metadata puede estar bien aunque el launcher falle: re-resolver
    // el tenant solo para el encabezado, y mostrar el error del launcher.
    try {
      tenant = await withMasterSession((master, sessionId) => master.getTenantBySlug(sessionId, slug));
      if (!tenant) tenantError = `Tenant '${slug}' no existe en modoops_master`;
    } catch {
      tenantError = `Tenant '${slug}' no existe en modoops_master`;
    }
    if (!tenantError) {
      const raw = (cause as Error)?.message || "No se pudo cargar launcher";
      launcherError =
        cause instanceof BffError && cause.code === "odoo_unavailable"
          ? `DB del tenant no responde — ${raw}`
          : raw;
    }
  }
}

function accentVar(key: string): string {
  const map: Record<string, string> = {
    "flame-yellow": "var(--sg-flame-yellow)",
    "flame-orange": "var(--sg-flame-orange)",
    "flame-deep": "var(--sg-flame-deep)",
    "flame-rust": "var(--sg-flame-rust)",
    "ember-amber": "var(--sg-ember-amber)",
    "ember-coral": "var(--sg-ember-coral)",
    "ember-scarlet": "var(--sg-ember-scarlet)",
    "ember-wine": "var(--sg-ember-wine)",
  };
  return map[key] || "var(--sg-flame-orange)";
}

const hasIA = tenant?.modules_installed?.includes("IA ModoOps") ?? false;

// Home operativa (spec home-hub, slice 3): tabs por URL (?tab=), estática.
// resumenHome({}) nunca falla (ancla por defecto); los números vivos llegan en el slice 4.
const homeTabParam = Astro.url.searchParams.get("tab") || "";
const homeRes = resumenHome({ tab: homeTabParam });
const homeTabs = homeRes.ok ? homeRes.home.tabs : [];
const homeTabLabel = homeRes.ok ? homeRes.home.tabs.find((t) => t.id === homeRes.home.tab)?.label ?? "" : "";
---

<BaseLayout title={`${tenant?.name ?? slug} — ModoOps`} description={`Tenant ${slug} — ModoOps`}>
  <main class:list={["mo-tenant", tenant && !tenantError && "with-nav"]}>
    <header class="mo-tenant__topbar">
      <div>
        <p class="mo-tenant__eyebrow">ModoOps · Control Plane → Tenant</p>
        <h1>{tenant?.name ?? slug} <code class="mo-tenant__db">{tenant?.db_name ?? `modoops_${slug}`}</code></h1>
        <p class="mo-tenant__meta">
          {tenant ? `${tenant.vertical} · ` : ""}<span class:list={["mo-badge", `is-${tenant?.state ?? "activo"}`]}>{tenant?.state ?? "—"}</span>
          {` · ${tenant?.modules_installed_count ?? 0} módulos`}
          {hasIA ? <span class="mo-badge is-ia">IA activa</span> : <span class="mo-badge is-ia-off">IA no instalada</span>}
          {tenant?.abono_due_date ? ` · vto abono ${tenant.abono_due_date}` : ""}
        </p>
        <p class="mo-tenant__user">{userName} · <a href="/admin/tenants">← Admin tenants (Hub 1)</a></p>
      </div>
      <div class="mo-tenant__actions">
        <a href="/admin/tenants" class="mo-btn-ghost">← Tenants</a>
        <button type="button" data-logout class="mo-btn-ghost">Cerrar sesión</button>
      </div>
    </header>

    {tenantError ? <p class="mo-tenant__error">{tenantError} — <a href="/admin/tenants">volver a lista</a></p> : null}

    {tenant && !tenantError ? (
      <>
        <section class="mo-home" aria-label="Home operativa">
          <p class="mo-home__saludo">Hola, <strong>{tenant.name}</strong> · así viene tu día</p>
          <div role="tablist" aria-label="Módulos" class="mo-tabs">
            {homeTabs.map((t) => (
              <a role="tab" aria-selected={t.active ? "true" : "false"} href={`/tenant/${slug}/app?tab=${t.id}`} class:list={["mo-tab", t.active && "is-active"]}>{t.label}</a>
            ))}
          </div>
          <p class="mo-home__tab" data-home-estado aria-live="polite">Viendo: {homeTabLabel} — cargando números…</p>
          <div class="mo-home__saldo" data-home-saldo>
            <p class="mo-home__caja-line">
              <span data-home-caja class="mo-home__caja" style="font-variant-numeric: tabular-nums;">—</span>
              <button type="button" data-home-ojito aria-pressed="false" aria-label="Ocultar montos" class="mo-home__ojito">👁</button>
            </p>
            <p class="mo-home__vs" data-home-vs></p>
          </div>
          <div class="mo-home__cards">
            <div class="mo-home__card"><h3>Por cobrar</h3><p data-home-porcobrar style="font-variant-numeric: tabular-nums;">—</p></div>
            <div class="mo-home__card"><h3>Stock valorizado</h3><p data-home-stock style="font-variant-numeric: tabular-nums;">—</p></div>
          </div>
          <div class="mo-home__acciones">
            <Button href="/oficina" variant="primary">Armar borrador</Button>
            <Button href="/admin/leads" variant="ghost-dark">Ver leads</Button>
            <Button href="#launcher" variant="ghost-dark">Mis módulos</Button>
          </div>
        </section>
        <section class="mo-tenant__panel">
          <h2>Armar sistema — Módulos ModoOps del Catálogo</h2>
          <p class="mo-tenant__hint">Instalá/quita módulos para <code>{tenant.db_name}</code>. IA es un módulo más del Catálogo (q4). Preview <code>odoo-bin -d {tenant.db_name} -i/-u &lt;mod&gt;</code> auditado en <code>modoops.tenant.log</code>.</p>
          <div id="tenant-install-root" data-tenant-id={tenant.id} data-db={tenant.db_name} data-installed={tenant.modules_installed ?? ""}></div>
          <dialog id="tenant-install-dialog" class="mo-dialog">
            <form method="dialog" id="tenant-install-form">
              <h3>Gestionar módulos — {tenant.name}</h3>
              <p class="mo-dialog__db">{tenant.db_name}</p>
              <div class="mo-dialog__grid" id="tenant-install-grid"></div>
              <label class="mo-dialog__notes">Notas <input name="notes" placeholder="ticket, motivo" /></label>
              <div class="mo-dialog__actions">
                <label>Acción <select name="action"><option value="install">Instalar</option><option value="remove">Quitar</option></select></label>
                <button type="submit">Confirmar</button>
                <button type="button" id="tenant-install-cancel">Cancelar</button>
              </div>
              <pre id="tenant-install-preview" class="mo-dialog__preview"></pre>
              <span id="tenant-install-msg" class="mo-admin__msg"></span>
            </form>
          </dialog>
          <div class="mo-tenant__cta">
            <button type="button" id="tenant-install-open" class="mo-btn-primary">Gestionar módulos / IA</button>
            <a href="/admin/tenants" class="mo-btn-ghost">+ Nuevo Tenant</a>
            <span class="mo-tenant__modules">{tenant.modules_installed ? `Instalados: ${tenant.modules_installed}` : "0 módulos — armar sistema"}</span>
          </div>
          {!hasIA ? <p class="mo-tenant__ia-cta">¿Agregar IA? Tildá <strong>IA ModoOps — Agente herramental</strong> en “Gestionar módulos / IA” → hidrata <em>Mostrador, Depósito Inteligente, Compras, Fiscal AR, Taller, etc.</em> vía Tools <code>stock.consulta</code>/<code>ot.cobro</code> + Memoria tenant 90d.</p> : <p class="mo-tenant__ia-ok">IA activa — Tools: <a href={`/api/modoops/${tenant.db_name}/agent/tools`} target="_blank"><code>GET /api/modoops/{tenant.db_name}/agent/tools</code></a> · Techo 200/mes Log → 429.</p>}
          {hasIA ? (
            <div class="mo-tenant__chat" id="ia-chat-root" data-db={tenant.db_name}>
              <h3>Chat IA — Agente herramental (mock free + Ollama opcional)</h3>
              <p class="mo-tenant__hint">Escribí natural: “stock del producto 42”, “cobrar OT 5 $100”, o “hola”. El BFF hidrata a <code>stock.consulta</code>/<code>ot.cobro</code>/<code>echo</code> vía <code>llm.ts</code> (mock si Ollama sin modelo).</p>
              <div id="ia-chat-log" class="mo-chat__log" aria-live="polite"></div>
              <form id="ia-chat-form" class="mo-chat__form">
                <input id="ia-chat-input" name="message" placeholder="Ej: stock producto 42" autocomplete="off" aria-label="Mensaje para la IA" />
                <button type="submit" class="mo-btn-primary">Enviar</button>
              </form>
              <pre id="ia-chat-debug" class="mo-chat__debug"></pre>
            </div>
          ) : null}
        </section>

        <section id="launcher">
          <h2 class="mo-tenant__h2">Launcher — {tenant.name} (tiles {tiles.length})</h2>
          {launcherError ? <p class="mo-tenant__error">{launcherError}</p> : tiles.length === 0 ? <p class="mo-tenant__empty">Sin tiles visibles para este usuario en este tenant.</p> : (
            <div class="mo-app__grid">
              {tiles.map((t) => (
                <div class="mo-tile sg-glass" data-accent={t.accent_key} style={`--tile-accent: ${accentVar(t.accent_key)}`}>
                  <span class="mo-tile__icon">{t.label.trim().slice(0,1).toUpperCase()}</span>
                  <span class="mo-tile__copy"><span class="mo-tile__label">{t.label}</span><span class="mo-tile__hint">{t.hint}</span></span>
                  <span class="mo-tile__kpi"><span class="mo-tile__value">{t.value ?? "—"}</span></span>
                  <span class="mo-tile__enter">{t.enter_label || "Abrir"} →</span>
                </div>
              ))}
            </div>
          )}
        </section>

        <nav aria-label="Principal" class="mo-bottomnav">
          <a href={`/tenant/${slug}/app`} aria-current="page"><span aria-hidden="true">◉</span><span>Cuenta</span></a>
          <a href="#launcher"><span aria-hidden="true">▦</span><span>Módulos</span></a>
          <a href="/oficina" aria-label="Oficina: armar borrador"><span class="mo-qr" aria-hidden="true">⌂</span></a>
          <a href="/admin/leads"><span aria-hidden="true">✉</span><span>Leads</span></a>
          <a href="/admin/tenants"><span aria-hidden="true">⋯</span><span>Más</span></a>
        </nav>
      </>
    ) : null}
  </main>
</BaseLayout>

<script>
  import { CATALOGO_LABELS } from "../../../lib/catalogo.generated.ts";
  import { describeJobState, shouldPollJob } from "../../../lib/bff/install-job.ts";
  const CATALOGO = Object.entries(CATALOGO_LABELS) as unknown as readonly (readonly [string, string])[];

  const root = document.getElementById("tenant-install-root") as HTMLDivElement | null;
  const dlg = document.getElementById("tenant-install-dialog") as HTMLDialogElement | null;
  const grid = document.getElementById("tenant-install-grid") as HTMLDivElement | null;
  const previewEl = document.getElementById("tenant-install-preview") as HTMLPreElement | null;
  const msgEl = document.getElementById("tenant-install-msg") as HTMLSpanElement | null;
  const form = document.getElementById("tenant-install-form") as HTMLFormElement | null;
  const openBtn = document.getElementById("tenant-install-open") as HTMLButtonElement | null;
  const cancelBtn = document.getElementById("tenant-install-cancel") as HTMLButtonElement | null;

  const tenantId = root ? Number(root.dataset.tenantId) : NaN;
  const db = root ? String(root.dataset.db || "modoops_<slug>") : "modoops_<slug>";

  function renderGrid() {
    if (!grid) return;
    grid.innerHTML = "";
    for (const [key, label] of CATALOGO) {
      const lbl = document.createElement("label");
      lbl.className = "mo-check";
      lbl.innerHTML = `<input type="checkbox" value="${key}" data-mod /> ${label} <code>${key}</code>`;
      grid.appendChild(lbl);
    }
  }
  renderGrid();

  function updatePreview() {
    if (!grid || !previewEl || !form) return;
    const mods = [...grid.querySelectorAll<HTMLInputElement>("[data-mod]:checked")].map(i=>i.value);
    const action = (form.querySelector('select[name="action"]') as HTMLSelectElement)?.value || "install";
    const flag = action === "install" ? "-i" : "-u";
    previewEl.textContent = mods.length ? `odoo-bin -d ${db} ${flag} ${mods.join(", ")}  # batch ${mods.length}` : "— seleccioná módulos —";
  }
  grid?.addEventListener("change", updatePreview);
  form?.querySelector('select[name="action"]')?.addEventListener("change", updatePreview);
  openBtn?.addEventListener("click", () => {
    if (!dlg || !grid || !previewEl || !msgEl) return;
    msgEl.textContent = "";
    previewEl.textContent = "— seleccioná módulos —";
    grid.querySelectorAll<HTMLInputElement>("[data-mod]").forEach(i=>i.checked=false);
    dlg.showModal();
  });
  let pollActiva = false;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!Number.isFinite(tenantId) || !grid || !msgEl || !previewEl || !form) return;
    const mods = [...grid.querySelectorAll<HTMLInputElement>("[data-mod]:checked")].map(i=>i.value);
    if (!mods.length) { msgEl.textContent = "Seleccioná al menos un módulo"; return; }
    const fd = new FormData(form);
    const action = String(fd.get("action")||"install");
    const notes = String(fd.get("notes")||"");
    msgEl.textContent = "Ejecutando…";
    const res = await fetch(`/api/admin/tenants/${tenantId}/install`, { method:"POST", headers:{"content-type":"application/json"}, body: JSON.stringify({ modules: mods, action, notes }) });
    const data = await res.json().catch(()=>({})) as { preview_command?: string; job_id?: number | null; job_state?: string; error?: { message?: string } };
    if (!res.ok) { msgEl.textContent = data?.error?.message || "Error"; return; }
    previewEl.textContent = data.preview_command || previewEl.textContent;
    // G7: install real = job async; remove mock recarga directo
    if (typeof data.job_id !== "number") {
      msgEl.textContent = "OK — recargando…";
      setTimeout(()=> window.location.reload(), 700);
      return;
    }
    const jobId = data.job_id;
    pollActiva = true;
    msgEl.textContent = describeJobState(data.job_state || "pendiente");
    while (pollActiva) {
      await new Promise((r) => setTimeout(r, 5000));
      if (!pollActiva) return;
      try {
        const jr = await fetch(`/api/admin/tenants/${tenantId}/install/${jobId}`);
        const jd = await jr.json().catch(()=>({})) as { state?: string; output?: string };
        if (!jr.ok) { msgEl.textContent = "No se pudo leer el job"; return; }
        const estado = String(jd.state || "");
        msgEl.textContent = describeJobState(estado);
        if (jd.output) previewEl.textContent = String(jd.output).slice(-1500);
        if (!shouldPollJob(estado)) {
          if (estado === "hecho") {
            msgEl.textContent = describeJobState(estado) + " Recargando…";
            setTimeout(()=> window.location.reload(), 900);
          }
          return;
        }
      } catch { msgEl.textContent = "Sin conexión — reintentando…"; }
    }
  });
  cancelBtn?.addEventListener("click", () => { pollActiva = false; dlg?.close(); });
  document.querySelector("[data-logout]")?.addEventListener("click", async()=>{ await fetch("/api/auth/logout",{method:"POST"}); window.location.assign("/login"); });

  // Home viva (spec home-hub, slice 4): montos desde GET home del tenant,
  // toggle ocultar en memoria (nunca se persiste el oculto).
  {
    const estadoEl = document.querySelector("[data-home-estado]");
    const cajaEl = document.querySelector("[data-home-caja]");
    const porCobrarEl = document.querySelector("[data-home-porcobrar]");
    const stockEl = document.querySelector("[data-home-stock]");
    const vsEl = document.querySelector("[data-home-vs]");
    const ojoBtn = document.querySelector("[data-home-ojito]");
    if (estadoEl && cajaEl && ojoBtn instanceof HTMLButtonElement) {
      const slugM = window.location.pathname.match(/^\/tenant\/([^/]+)\/app/);
      const homeSlug = slugM ? slugM[1] : "";
      const homeTab = new URLSearchParams(window.location.search).get("tab") || "";
      const fmtARS = new Intl.NumberFormat("es-AR", { style: "currency", currency: "ARS", maximumFractionDigits: 0 });
      let montos: { cajaHoy: number; porCobrar: number; stockValorizado: number; vsAyerPct: number } | null = null;
      let oculto = false;
      const pinta = () => {
        const txt = (v: number) => (oculto ? "$ ∗∗∗" : fmtARS.format(v));
        cajaEl.textContent = montos ? txt(montos.cajaHoy) : "—";
        if (porCobrarEl) porCobrarEl.textContent = montos ? txt(montos.porCobrar) : "—";
        if (stockEl) stockEl.textContent = montos ? txt(montos.stockValorizado) : "—";
        if (vsEl instanceof HTMLElement && montos) {
          const p = montos.vsAyerPct;
          vsEl.textContent = p === 0 ? "" : `${p > 0 ? "↑" : "↓"} ${Math.abs(p)}% vs ayer en ventas`;
          vsEl.classList.toggle("is-neg", p < 0);
        }
      };
      ojoBtn.addEventListener("click", () => {
        oculto = !oculto;
        ojoBtn.setAttribute("aria-pressed", String(oculto));
        ojoBtn.setAttribute("aria-label", oculto ? "Mostrar montos" : "Ocultar montos");
        pinta();
      });
      (async () => {
        try {
          const res = await fetch(`/api/tenant/${homeSlug}/home?tab=${encodeURIComponent(homeTab)}`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = (await res.json()) as { home?: typeof montos };
          if (!data.home) throw new Error("sin home");
          montos = data.home;
          estadoEl.textContent = "Números al día.";
          pinta();
        } catch {
          estadoEl.textContent = "No se pudieron cargar los números.";
        }
      })();
    }
  }

  // Chat IA herramental — hidrata BFF /api/modoops/:db/agent/run con {message, requestId}
  const chatRoot = document.getElementById("ia-chat-root") as HTMLDivElement | null;
  const chatLog = document.getElementById("ia-chat-log") as HTMLDivElement | null;
  const chatForm = document.getElementById("ia-chat-form") as HTMLFormElement | null;
  const chatInput = document.getElementById("ia-chat-input") as HTMLInputElement | null;
  const chatDebug = document.getElementById("ia-chat-debug") as HTMLPreElement | null;
  const chatDb = chatRoot?.dataset.db || db;
  function uuidv4(){ return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c=>{ const r=Math.random()*16|0, v=c==="x"?r:(r&0x3|0x8); return v.toString(16); }); }
  function appendChat(role: string, text: string){
    if(!chatLog) return;
    const div=document.createElement("div");
    div.className=`mo-chat__msg is-${role}`;
    div.textContent=`${role}: ${text}`;
    chatLog.appendChild(div);
    chatLog.scrollTop=chatLog.scrollHeight;
  }
  chatForm?.addEventListener("submit", async(e)=>{
    e.preventDefault();
    const msg=(chatInput?.value||"").trim();
    if(!msg) return;
    appendChat("user", msg);
    if(chatInput) chatInput.value="";
    if(chatDebug) chatDebug.textContent="pensando…";
    const requestId=uuidv4();
    try{
      const res=await fetch(`/api/modoops/${chatDb}/agent/run`, {method:"POST", headers:{"content-type":"application/json"}, body: JSON.stringify({message: msg, requestId})});
      const data=await res.json() as {status?:string; output?:{tool?:string; echo?:unknown; llmSource?:string}; llmSource?:string; error?:string};
      if(!res.ok){ appendChat("error", data.error || `HTTP ${res.status}`); if(chatDebug) chatDebug.textContent=JSON.stringify(data,null,2); return; }
      const tool=data.output?.tool || (data as {tool?:string}).tool || "—";
      const src=data.llmSource || data.output?.llmSource || "—";
      appendChat("agent", `tool=${tool} (llm:${src}) → ${JSON.stringify(data.output?.echo ?? data.output)}`);
      if(chatDebug) chatDebug.textContent=JSON.stringify(data,null,2);
    }catch(err){ appendChat("error", String(err)); if(chatDebug) chatDebug.textContent=String(err); }
  });
</script>

<style>
  .mo-tenant { max-width:78rem; margin:0 auto; padding:2rem 1rem 3rem; }
  .with-nav { padding-bottom:6rem; }
  .mo-home { border:1px solid var(--sg-glass-border); border-radius:1rem; padding:1.1rem; background:var(--sg-glass-fill); margin-bottom:1.25rem; }
  .mo-home__saludo { margin:0 0 .6rem; color:var(--sg-text-muted-dark); font-size:.9rem; }
  .mo-home__saludo strong { color:var(--color-core-cream); }
  .mo-tabs { display:flex; gap:.4rem; flex-wrap:wrap; }
  .mo-tab { display:inline-flex; align-items:center; min-height:44px; padding:.5rem 1rem; border-radius:999px; font-size:.85rem; color:var(--sg-text-muted-dark); text-decoration:none; transition:color .15s ease, background-color .15s ease; }
  .mo-tab.is-active { background:var(--color-brand-accent); color:var(--color-space-void); font-weight:600; }
  .mo-home__tab { font-size:.85rem; color:var(--sg-text-muted-dark); margin:.6rem 0 0; }
  .mo-home__saldo { margin-top:.8rem; }
  .mo-home__caja-line { display:flex; align-items:center; gap:.6rem; margin:0; }
  .mo-home__caja { font-size:2rem; font-weight:700; letter-spacing:-.02em; }
  .mo-home__ojito { display:inline-flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; font-size:1.3rem; background:transparent; border:0; cursor:pointer; }
  .mo-home__vs { margin:.2rem 0 0; font-size:.85rem; font-weight:600; color:#4ade80; }
  .mo-home__vs.is-neg { color:#f87171; }
