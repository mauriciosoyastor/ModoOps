---
import { sessionCloseCopy } from '../../../lib/control-plane-vista.ts';
import LightAppLayout from '../../../layouts/LightAppLayout.astro';
import { BffError } from '../../../lib/bff/errors.ts';
import { invalidateBffSession } from '../../../lib/bff/http.ts';
import { loadTenantLauncher } from '../../../lib/bff/launcher.ts';
import { withMasterSession } from '../../../lib/bff/tenant-status.ts';
import { resumenHome } from '../../../lib/bff/home.ts';
import { composicionInicio, modulosAnclaDesdeTiles, type ModuloAncla } from '../../../lib/bff/inicio.ts';
import { sesionDelPuesto } from '../../../lib/bff/sesion-puesto.ts';
import InicioMosaico from '../../../components/inicio/InicioMosaico.astro';

export const prerender = false;

const slug = String(Astro.params.slug || '').trim();
if (!slug || !/^[a-z0-9_]+$/.test(slug)) {
  return new Response('slug inválido', { status: 400 });
}

const _sessT = (Astro.locals as Record<string, unknown>).session as { name?: string; login?: string } | undefined;
const _odooT = (Astro.locals as Record<string, unknown>).odooSessionId as string | undefined;
if (!_odooT) return Astro.redirect('/login');
const odooSessionId: string = _odooT;
const userName = _sessT?.name || _sessT?.login || '';

let tenant: import('../../../lib/bff/backend-client.ts').TenantRow | null = null;
let tenantError = '';
let tiles: import('../../../lib/bff/types.ts').LauncherTile[] = [];
let launcherError = '';

try {
  const res = await loadTenantLauncher(slug, odooSessionId);
  tenant = res.tenant;
  tiles = res.tiles;
} catch (cause) {
  if (cause instanceof BffError && cause.code === 'unauthorized') {
    invalidateBffSession(Astro.cookies);
    return Astro.redirect('/login');
  }
  if (cause instanceof BffError && cause.code === 'not_found') {
    tenantError = cause.message;
  } else {
    try {
      tenant = await withMasterSession((master, sessionId) => master.getTenantBySlug(sessionId, slug));
      if (!tenant) tenantError = `Tenant '${slug}' no existe en modoops_master`;
    } catch {
      tenantError = `Tenant '${slug}' no existe en modoops_master`;
    }
    if (!tenantError) {
      const raw = (cause as Error)?.message || 'No se pudo cargar launcher';
      launcherError =
        cause instanceof BffError && cause.code === 'odoo_unavailable'
          ? `DB del tenant no responde — ${raw}`
          : raw;
    }
  }
}

const homeTabParam = Astro.url.searchParams.get('tab') || '';
const ancla: readonly ModuloAncla[] = ['mostrador', 'deposito', 'compras', 'fiscal_ar'];
const enInicio = !ancla.includes(homeTabParam as ModuloAncla);
const seccion = enInicio ? 'inicio' : (homeTabParam as ModuloAncla);
const hoy = new Date();
const hoyIso = `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`;
const inicio = composicionInicio({
  superficie: 'shell',
  usuario: userName,
  cliente: tenant?.name || slug,
  slug,
  hoy: hoyIso,
  modulos: modulosAnclaDesdeTiles(tiles),
  seccion,
});
const homeRes = resumenHome({ tab: homeTabParam });
const homeTabs = homeRes.ok ? homeRes.home.tabs : [];
const homeTabLabel = homeRes.ok ? homeRes.home.tabs.find((t) => t.id === homeRes.home.tab)?.label ?? '' : '';
const tabHref = (id: string) => `/tenant/${slug}/app?tab=${id}`;
const cerrarSesion = sessionCloseCopy('shell', tenant?.name || slug);
const puesto = sesionDelPuesto({ persona: userName });
---

<LightAppLayout title={`${tenant?.name ?? slug} — ModoOps`} description={`Shell · ${slug}`} theme="papel" ops>
  <div class="mo-live" id="live-polite" aria-live="polite" aria-atomic="true"></div>

  <div id="puesto-candado" class="puesto-candado" hidden>
    <div class="puesto-candado__lienzo">
      <button type="button" class="puesto-candado__abrir" data-desbloquear aria-label="Desbloquear puesto">
        <svg width="72" height="72" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="11" width="14" height="9" rx="2"></rect>
          <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="shell" id="contenido">
    <header class="app-bar">
      <p class="app-bar__brand" translate="no">ModoOps</p>
      <div class="app-bar__pills">
        <nav class="app-bar__nav" aria-label="Módulos">
          {inicio.nav.map((item) => (
            <a class="app-link" href={item.href} aria-current={item.actual ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="app-bar__sesion">
          <p class="app-bar__aviso" data-puesto-aviso role="status" tabindex="-1" hidden>{puesto.aviso}</p>
          <a class="app-bar__accion" href={`/tenant/${slug}/configuracion`}>Configuración</a>
          <button type="button" class="app-bar__accion" data-logout>{inicio.cerrarSesion}</button>
        </div>
      </div>
      <button type="button" class="app-bar__candado" data-bloquear aria-pressed="false" aria-label={puesto.bloquear} data-abierto={puesto.bloquear} data-cerrado={puesto.desbloquear}>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="5" y="11" width="14" height="9" rx="2"></rect>
          <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
        </svg>
      </button>
    </header>

    <div class="page" id="puesto-trabajo">

    {tenantError ? (
      <p class="mo-banner mo-banner--danger" role="alert">
        {tenantError} — <a class="app-link" href="/admin/tenants">volver a lista</a>
      </p>
    ) : null}

    {tenant && !tenantError && enInicio ? <InicioMosaico inicio={inicio} plano color captura /> : null}

    {tenant && !tenantError && !enInicio ? (
      <>
        <nav class="mo-tabs tabs" aria-label="Módulos" role="tablist">
          {homeTabs.map((t) => (
            <a
              role="tab"
              href={tabHref(t.id)}
              aria-selected={t.active ? 'true' : 'false'}
              aria-current={t.active ? 'true' : undefined}
            >
              {t.label}
            </a>
          ))}
        </nav>

        <section class="panel-block" aria-label="Atajos operativos">
          <p class="mo-section-label">Empezá por acá</p>
          <div class="tiles">
            <button type="button" class="mo-tile mo-tile--now" data-sheet="caja1">
              <span>
                <p class="mo-tile__label">Abrir caja 1</p>
                <p class="mo-tile__hint">Turno en curso · listo para cobrar</p>
              </span>
              <span class="mo-pill mo-pill--quiet" aria-hidden="true">Abrir</span>
            </button>
            <button type="button" class="mo-tile" data-sheet="caja2">
              <span>
                <p class="mo-tile__label">Abrir caja 2</p>
                <p class="mo-tile__hint">Cerrada · listo para arrancar</p>
              </span>
              <span class="mo-pill mo-pill--quiet" aria-hidden="true">Abrir</span>
            </button>
            <button type="button" class="mo-tile" data-sheet="stock">
              <span>
                <p class="mo-tile__label">Consultar stock</p>
                <p class="mo-tile__hint">Por código o nombre</p>
              </span>
              <span class="mo-pill mo-pill--quiet" aria-hidden="true">Buscar</span>
            </button>
            <button type="button" class="mo-tile" data-sheet="cobrar">
              <span>
                <p class="mo-tile__label">Cobrar una OT</p>
                <p class="mo-tile__hint">Monto + efectivo/transferencia</p>
              </span>
              <span class="mo-pill mo-pill--quiet" aria-hidden="true">Cobrar</span>
            </button>
          </div>
        </section>

        <section class="panel-block" aria-label="Resumen del día">
          <div class="day-head">
            <p class="mo-section-label" data-home-estado>Hoy · {homeTabLabel}</p>
            <button type="button" class="mo-btn mo-btn--ghost day-head__toggle" data-home-ojito hidden aria-pressed="false">
              Ocultar montos
            </button>
            <span class="sr-only" aria-live="polite" data-home-ojito-msg></span>
          </div>
          <div class="widgets" data-home-skeleton>
            <div class="mo-skeleton mo-skeleton--kpi" aria-hidden="true"></div>
            <div class="mo-skeleton mo-skeleton--kpi" aria-hidden="true"></div>
            <div class="mo-skeleton mo-skeleton--kpi" aria-hidden="true"></div>
          </div>
          <p class="mo-banner mo-banner--danger" data-home-error role="alert" hidden>
            No se pudieron cargar los números. Recargá la página.
          </p>
          <div class="widgets" data-home-ready hidden>
            <article class="mo-kpi">
              <p class="mo-kpi__label">Caja del día</p>
              <p class="mo-kpi__value" data-home-caja>—</p>
              <p class="mo-kpi__hint" data-home-vs></p>
            </article>
            <article class="mo-kpi">
              <p class="mo-kpi__label">Por cobrar</p>
              <p class="mo-kpi__value" data-home-porcobrar>—</p>
            </article>
            <article class="mo-kpi">
              <p class="mo-kpi__label">Stock valorizado</p>
              <p class="mo-kpi__value" data-home-stock>—</p>
            </article>
          </div>
        </section>

        <section class="panel-block region" id="launcher" aria-label="Aplicaciones">
          <h2 class="mo-section-label">Aplicaciones <span class="mo-count">{tiles.length}</span></h2>
          {launcherError ? <p class="mo-banner mo-banner--danger" role="status">{launcherError}</p> : null}
          {tiles.length === 0 && !launcherError ? (
            <p class="mo-empty__text">Sin aplicaciones visibles para este usuario.</p>
          ) : (
            <div class="launcher-grid">
              {tiles.map((t) => (
                <div class="launcher-row">
                  <span>
                    <p class="launcher-row__label">{t.label}</p>
                    <p class="launcher-row__hint">{t.hint}</p>
                  </span>
                  <span class="launcher-row__value">{t.value ?? '—'}</span>
                </div>
              ))}
            </div>
          )}
        </section>
      </>
    ) : null}
    </div>
  </div>

  <div class="mo-toast-region" id="toast-region" aria-relevant="additions"></div>

  <div class="mo-dialog-backdrop" id="confirm-backdrop" hidden>
    <div class="mo-dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-text">
      <h2 class="mo-dialog__title" id="confirm-title">{cerrarSesion.title}</h2>
      <p class="mo-dialog__text" id="confirm-text">{cerrarSesion.text}</p>
      <p id="confirm-error" class="mo-banner mo-banner--danger" role="alert" hidden></p>
      <div class="mo-dialog__actions">
        <button type="button" class="mo-btn mo-btn--ghost" id="confirm-cancel">{cerrarSesion.cancelLabel}</button>
        <button type="button" class="mo-btn mo-btn--primary" id="confirm-ok">{cerrarSesion.okLabel}</button>
      </div>
    </div>
  </div>

  <!-- FlowSheets -->
  <div class="mo-sheet-backdrop" id="sheet-cobrar" hidden>
    <div class="mo-sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-cobrar-title">
      <div class="mo-sheet__top">
        <h2 class="mo-sheet__title" id="sheet-cobrar-title">Cobrar una OT</h2>
        <button type="button" class="mo-btn mo-btn--ghost" data-sheet-close>Cerrar</button>
      </div>
      <p class="mo-sheet__hint">Registrá el cobro con monto en ARS.</p>
      <form class="mo-sheet__body" id="form-cobrar">
        <div class="mo-field" id="field-ot">
          <label class="mo-field__label" for="ot-num">Número de OT</label>
          <input class="mo-field__control" id="ot-num" name="ot" inputmode="numeric" autocomplete="off" spellcheck="false" aria-describedby="err-ot" />
          <p class="mo-field__error" id="err-ot" role="alert" hidden></p>
        </div>
        <div class="mo-field" id="field-monto">
          <label class="mo-field__label" for="ot-monto">Monto (ARS)</label>
          <input class="mo-field__control" id="ot-monto" name="monto" inputmode="decimal" autocomplete="off" spellcheck="false" aria-describedby="err-monto" />
          <p class="mo-field__error" id="err-monto" role="alert" hidden></p>
        </div>
        <fieldset class="mo-field">
          <legend class="mo-field__label">Medio de pago</legend>
          <div class="pay-options">
            <label><input type="radio" name="pago" value="efectivo" checked /> Efectivo</label>
            <label><input type="radio" name="pago" value="transferencia" /> Transferencia</label>
          </div>
        </fieldset>
        <div class="mo-sheet__actions">
          <button type="submit" class="mo-btn mo-btn--primary">Registrar cobro</button>
        </div>
      </form>
    </div>
  </div>

  <div class="mo-sheet-backdrop" id="sheet-caja1" hidden>
    <div class="mo-sheet mo-sheet--caja" role="dialog" aria-modal="true" aria-labelledby="sheet-caja1-title">
      <div class="mo-sheet__top">
        <h2 class="mo-sheet__title" id="sheet-caja1-title">Abrir caja 1</h2>
        <button type="button" class="mo-btn mo-btn--ghost" data-sheet-close>Cerrar</button>
      </div>
      <p class="mo-sheet__hint">Con este fondo entrás al punto de venta.</p>
      <form class="mo-sheet__body" id="form-caja1">
        <div class="mo-field" id="field-fondo1">
          <label class="mo-field__label" for="fondo1">Fondo inicial (ARS)</label>
          <input class="mo-field__control" id="fondo1" name="fondo" inputmode="decimal" autocomplete="off" spellcheck="false" aria-describedby="err-fondo1" />
          <p class="mo-field__error" id="err-fondo1" role="alert" hidden></p>
        </div>
        <div class="mo-sheet__actions">
          <button type="submit" class="mo-btn mo-btn--primary">Abrir caja</button>
        </div>
      </form>
    </div>
  </div>

  <div class="mo-sheet-backdrop" id="sheet-caja2" hidden>
    <div class="mo-sheet mo-sheet--caja" role="dialog" aria-modal="true" aria-labelledby="sheet-caja2-title">
      <div class="mo-sheet__top">
        <h2 class="mo-sheet__title" id="sheet-caja2-title">Abrir caja 2</h2>
        <button type="button" class="mo-btn mo-btn--ghost" data-sheet-close>Cerrar</button>
      </div>
      <p class="mo-sheet__hint">Con este fondo entrás al punto de venta.</p>
      <form class="mo-sheet__body" id="form-caja2">
        <div class="mo-field" id="field-fondo2">
          <label class="mo-field__label" for="fondo2">Fondo inicial (ARS)</label>
          <input class="mo-field__control" id="fondo2" name="fondo" inputmode="decimal" autocomplete="off" spellcheck="false" aria-describedby="err-fondo2" />
          <p class="mo-field__error" id="err-fondo2" role="alert" hidden></p>
        </div>
        <div class="mo-sheet__actions">
          <button type="submit" class="mo-btn mo-btn--primary">Abrir caja</button>
        </div>
      </form>
    </div>
  </div>

  <div class="mo-sheet-backdrop" id="sheet-stock" hidden>
    <div class="mo-sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-stock-title">
      <div class="mo-sheet__top">
        <h2 class="mo-sheet__title" id="sheet-stock-title">Consultar stock</h2>
        <button type="button" class="mo-btn mo-btn--ghost" data-sheet-close>Cerrar</button>
      </div>
      <form class="mo-sheet__body" id="form-stock">
        <div class="mo-field" id="field-sku">
          <label class="mo-field__label" for="sku-q">Código o nombre</label>
          <input class="mo-field__control" id="sku-q" name="q" autocomplete="off" spellcheck="false" placeholder="Código o nombre…" aria-describedby="err-sku" />
          <p class="mo-field__error" id="err-sku" role="alert" hidden></p>
        </div>
        <div class="sheet-result" id="stock-result" hidden>
          <strong id="stock-name"></strong>
          <span id="stock-meta" class="mo-empty__text"></span>
        </div>
        <div class="mo-sheet__actions">
          <button type="submit" class="mo-btn mo-btn--primary">Buscar</button>
        </div>
      </form>
    </div>
  </div>

  <style>
    .shell { min-height: 100dvh; }
    .app-bar {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 0.75rem 1rem;
      padding:
        max(0.85rem, env(safe-area-inset-top))
        max(1.35rem, env(safe-area-inset-right))
        0.85rem
        max(1.35rem, env(safe-area-inset-left));
      max-width: 72rem;
      margin: 0 auto;
      border-bottom: 1px solid var(--mo-line);
    }
    .app-bar__brand {
      margin: 0;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--mo-muted);
    }
    .app-bar__title {
      margin: 0.25rem 0 0;
      font-family: var(--mo-font);
      font-size: 1.25rem;
      font-weight: 650;
      letter-spacing: -0.02em;
      line-height: 1.2;
      text-wrap: balance;
    }
    .app-bar__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
      margin: 0.25rem 0 0;
      font-size: 0.85rem;
      color: var(--mo-muted);
    }
    .app-bar__pills {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 0.15rem;
      margin-left: auto;
      padding: 0.2rem;
      border: 1px solid var(--mo-line);
      border-radius: 999px;
      background: var(--mo-card);
    }
    .app-bar__nav,
    .app-bar__sesion {
      display: flex;
      flex-wrap: nowrap;
      gap: 0.15rem;
      align-items: center;
      margin: 0;
      padding: 0;
      border: 0;
      background: transparent;
    }
    .app-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 0.85rem;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--mo-muted);
      font: inherit;
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 500;
      cursor: pointer;
      touch-action: manipulation;
      transition: color 140ms var(--mo-ease-out), background-color 140ms var(--mo-ease-out);
    }
    @media (hover: hover) and (pointer: fine) {
      .app-link:hover,
      .app-bar__accion:hover,
      .app-bar__candado:hover { color: var(--mo-ink); }
    }
    .app-link[aria-current='page'] {
      background: var(--mo-hero);
      color: var(--mo-on-hero);
      font-weight: 650;
    }
    .puesto-candado[hidden] { display: none !important; }
    .puesto-candado__lienzo {
      position: fixed;
      inset: 0;
      z-index: 110;
      display: grid;
      place-items: center;
      background: var(--mo-wash);
    }
    .puesto-candado__abrir {
      display: grid;
      place-items: center;
      width: 5.5rem;
      height: 5.5rem;
      min-width: 44px;
      min-height: 44px;
      padding: 0;
      border: 0;
      border-radius: 1rem;
      background: transparent;
      color: var(--mo-ink);
      cursor: pointer;
      touch-action: manipulation;
    }
    .app-bar__candado {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid var(--mo-line);
      border-radius: 999px;
      background: var(--mo-card);
      color: var(--mo-ink);
      cursor: pointer;
      touch-action: manipulation;
    }
    .app-bar__aviso {
      margin: 0;
      font-size: 0.92rem;
      color: var(--mo-muted);
    }
    .app-bar__accion {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 0.85rem;
      border: 0;
      border-radius: 999px;
      background: transparent;
      color: var(--mo-muted);
      font: inherit;
      font-size: 0.92rem;
      font-weight: 500;
      cursor: pointer;
      touch-action: manipulation;
      text-decoration: none;
      transition: background-color 140ms var(--mo-ease-out), color 140ms var(--mo-ease-out);
    }
    .page {
      max-width: 72rem;
      margin: 0 auto;
      padding:
        0.75rem
        max(1.35rem, env(safe-area-inset-right))
        max(2.75rem, env(safe-area-inset-bottom))
        max(1.35rem, env(safe-area-inset-left));
    }
    .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 0.75rem; }
    .tabs {
      width: 100%;
      margin: 0.25rem 0 0.15rem;
    }
    @media (hover: hover) and (pointer: fine) {
      .tabs a:hover { color: var(--mo-ink); }
    }
    .widgets {
      display: grid;
      gap: 0.5rem;
      grid-template-columns: 1fr;
      align-items: start;
    }
    .widgets[hidden],
    .mo-banner[hidden] { display: none; }
    @media (min-width: 640px) {
      .widgets { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    .mo-kpi__value { font-variant-numeric: tabular-nums; }
    .day-head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.25rem 1rem;
    }
    .day-head .mo-section-label { margin: 0; }
    .day-head__toggle {
      min-height: 44px;
      padding-inline: 0.5rem;
    }
    .day-head__toggle[hidden] { display: none; }
    .panel-block { margin-top: 1rem; }
    .region {
      margin-top: 1.15rem;
      padding-top: 0.85rem;
      border-top: 1px solid var(--mo-line);
    }
    .mo-tile--now {
      border-left: 3px solid var(--mo-accent);
      background: var(--mo-canvas);
    }
    .mo-sheet--caja {
      min-height: 0;
    }
    .mo-sheet--caja .mo-sheet__body {
      flex: 0 0 auto;
      align-content: start;
    }
    .mo-sheet--caja .mo-field__control {
      height: 2.75rem;
    }
    .tiles { display: grid; gap: 0.5rem; grid-template-columns: 1fr; }
    @media (min-width: 720px) {
      .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    .launcher-grid {
      display: grid;
      gap: 0 1.5rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 720px) {
      .launcher-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    .launcher-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.15rem 0.75rem;
      align-items: baseline;
      min-height: 44px;
      padding: 0.4rem 0;
      border-bottom: 1px solid var(--mo-line);
      border-radius: 0;
      background: transparent;
    }
    .launcher-row__label { margin: 0; font-weight: 650; font-size: 0.92rem; }
    .launcher-row__hint { margin: 0.1rem 0 0; color: var(--mo-muted); font-size: 0.78rem; }
    .launcher-row__value { font-variant-numeric: tabular-nums; font-weight: 650; }
    .pay-options { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .pay-options label {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 44px;
    }
    .sheet-result {
      border: 1px solid var(--mo-line);
      border-radius: var(--mo-radius-sm);
      background: var(--mo-card);
      padding: 0.75rem 1rem;
      display: grid;
      gap: 0.25rem;
    }
    .sheet-result[hidden] { display: none; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .mo-dialog,
    .mo-sheet,
    .mo-install-dialog { overscroll-behavior: contain; }
    .mo-install-dialog {
      border: 1px solid var(--mo-line);
      border-radius: var(--mo-radius);
      padding: 1.25rem;
      background: var(--mo-canvas);
      color: var(--mo-ink);
      max-width: 36rem;
      width: min(36rem, calc(100% - 2rem));
    }
    .mo-install-dialog::backdrop { background: color-mix(in srgb, var(--mo-ink) 45%, transparent); }
    .mo-dialog__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin: 0.5rem 0; }
    .chat { margin-top: 1rem; display: grid; gap: 0.5rem; }
    .chat-log {
      min-height: 6rem;
      max-height: 14rem;
      overflow: auto;
      border: 1px solid var(--mo-line);
      border-radius: var(--mo-radius-sm);
      padding: 0.75rem;
      background: var(--mo-field);
    }
    .chat-form {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
      border: 1px solid var(--mo-line);
      border-radius: var(--mo-radius-sm);
      background: var(--mo-canvas);
      padding: 0.25rem 0.25rem 0.25rem 0.75rem;
    }
    .chat-form:focus-within {
      outline: 2px solid var(--mo-focus);
      outline-offset: 2px;
    }
    .chat-form .mo-field__control {
      flex: 1 1 12rem;
      border: 0;
      background: transparent;
      min-height: 44px;
      font-size: 16px;
    }
    .chat-form .mo-field__control:focus-visible { outline: none; }
    .chat-form .mo-field__error { flex: 1 1 100%; }
    .mo-dialog__grid :global(label) {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      min-height: 44px;
      font-size: 0.85rem;
      border: 1px solid var(--mo-line);
      border-radius: var(--mo-radius-sm);
      padding: 0.5rem 0.75rem;
      background: var(--mo-field);
    }
  </style>

  <script>
    import {
      resolveLeaveMs,
      openWithEnter,
      closeWithLeave,
      showToast as mountToast,
      trapTabKey,
    } from '../../../scripts/light-app-chrome.ts';
    import { textoCajaHoy, textoSinMoneda } from '../../../lib/bff/caja-pos.ts';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const LEAVE_MS = resolveLeaveMs(reduceMotion, 140);
    const live = document.getElementById('live-polite');
    const toastRegion = document.getElementById('toast-region');
    const FLUJOS = new Set(['caja1', 'caja2', 'stock', 'cobrar']);
    let lastFocus: HTMLElement | null = null;
    let openSheetEl: HTMLElement | null = null;

    function patchQuery(patch: { flujo?: string | null; modulos?: string | null }) {
      const url = new URL(window.location.href);
      if ('flujo' in patch) {
        if (patch.flujo) url.searchParams.set('flujo', patch.flujo);
        else url.searchParams.delete('flujo');
      }
      if ('modulos' in patch) {
        if (patch.modulos) url.searchParams.set('modulos', '1');
        else url.searchParams.delete('modulos');
      }
      history.replaceState(null, '', `${url.pathname}${url.search}`);
    }

    function shellDirty(): boolean {
      const fields = document.querySelectorAll('.mo-sheet input, #tenant-notes, #ia-chat-input');
      for (const node of fields) {
        if (!(node instanceof HTMLInputElement)) continue;
        if (node.type === 'radio' || node.type === 'checkbox' || node.type === 'hidden') continue;
        if (node.value.trim()) return true;
      }
      return Boolean(document.querySelector('#tenant-install-grid [data-mod]:checked'));
    }

    window.addEventListener('beforeunload', (ev) => {
      if (!shellDirty()) return;
      ev.preventDefault();
      ev.returnValue = '';
    });

    if (!sessionStorage.getItem('mo-tile-staggered') && !reduceMotion) {
      document.documentElement.classList.add('mo-tiles-stagger');
      sessionStorage.setItem('mo-tile-staggered', '1');
    }

    const STOCK = [
      { q: ['latex', 'blanco', 'ltx'], name: 'Látex interior blanco 20L', stock: 24, ubi: 'A-12' },
      { q: ['esmalte', 'negro'], name: 'Esmalte sintético negro 4L', stock: 7, ubi: 'B-03' },
      { q: ['rodillo'], name: 'Rodillo lanilla 22cm', stock: 41, ubi: 'C-01' },
    ];

    function announce(msg: string) {
      if (!live) return;
      live.textContent = '';
      requestAnimationFrame(() => {
        live.textContent = msg;
      });
    }

    function showToast(title: string, text: string, kind: 'ok' | 'danger' = 'ok') {
      if (!toastRegion) return;
      mountToast({ region: toastRegion, title, text, kind, leaveMs: LEAVE_MS, announce });
    }

    function resetSheet(el: HTMLElement) {
      el.querySelectorAll('input').forEach((node) => {
        if (!(node instanceof HTMLInputElement)) return;
        if (node.type === 'radio') return;
        node.value = '';
        node.removeAttribute('aria-invalid');
      });
      el.querySelectorAll('.is-invalid').forEach((field) => field.classList.remove('is-invalid'));
      el.querySelectorAll('.mo-field__error').forEach((err) => {
        if (!(err instanceof HTMLElement)) return;
        err.hidden = true;
        err.textContent = '';
      });
      const result = el.querySelector('#stock-result');
      if (result instanceof HTMLElement) result.hidden = true;
    }

    function openSheet(id: string, fromUrl = false) {
      const el = document.getElementById(`sheet-${id}`);
      if (!el) return;
      closeSheet(true, true);
      if (!fromUrl) patchQuery({ flujo: id, modulos: null });
      lastFocus = document.activeElement as HTMLElement | null;
      openSheetEl = el;
      openWithEnter(el);
      const focusable =
        el.querySelector('input:not([type="radio"]):not([type="hidden"]), select, textarea') ||
        el.querySelector('button.mo-btn--primary') ||
        el.querySelector('[data-sheet-close]');
      (focusable as HTMLElement | null)?.focus();
      announce(`Flujo ${id} abierto`);
    }

    function closeSheet(immediate?: boolean, keepQuery = false) {
      if (!openSheetEl) return;
      const el = openSheetEl;
      openSheetEl = null;
      resetSheet(el);
      if (!keepQuery) patchQuery({ flujo: null });
      const restore = !immediate;
      closeWithLeave(el, {
        leaveMs: immediate ? 0 : LEAVE_MS,
        onDone: () => {
          if (restore) lastFocus?.focus?.();
        },
      });
    }

    document.querySelectorAll('[data-sheet]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-sheet');
        if (id) openSheet(id);
      });
    });
    document.querySelectorAll('[data-sheet-close]').forEach((btn) => {
      btn.addEventListener('click', () => closeSheet());
    });
    document.querySelectorAll('.mo-sheet-backdrop').forEach((el) => {
      el.addEventListener('click', (ev) => {
        if (ev.target === el) closeSheet();
      });
      el.addEventListener('keydown', (ev) => {
        if ((ev as KeyboardEvent).key === 'Escape') return;
        trapTabKey(el as HTMLElement, ev as KeyboardEvent);
      });
    });
    document.addEventListener('keydown', (ev) => {
      if (ev.key !== 'Escape') return;
      if (openSheetEl) {
        ev.preventDefault();
        closeSheet();
      }
    });

    function clearErr(fieldId: string, errId: string) {
      document.getElementById(fieldId)?.classList.remove('is-invalid');
      const err = document.getElementById(errId);
      if (err) {
        err.hidden = true;
        err.textContent = '';
      }
      document.getElementById(fieldId)?.querySelectorAll('input').forEach((node) => {
        if (node instanceof HTMLInputElement) node.removeAttribute('aria-invalid');
      });
    }
    function setErr(fieldId: string, errId: string, msg: string, input?: HTMLElement | null) {
      document.getElementById(fieldId)?.classList.add('is-invalid');
      const err = document.getElementById(errId);
      if (err) {
        err.hidden = false;
        err.textContent = msg;
      }
      if (input instanceof HTMLInputElement) {
        input.setAttribute('aria-invalid', 'true');
        input.setAttribute('aria-describedby', errId);
        input.focus();
      }
    }

    document.getElementById('form-cobrar')?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      clearErr('field-ot', 'err-ot');
      clearErr('field-monto', 'err-monto');
      const ot = document.getElementById('ot-num') as HTMLInputElement | null;
      const monto = document.getElementById('ot-monto') as HTMLInputElement | null;
      const pago = document.querySelector('input[name="pago"]:checked') as HTMLInputElement | null;
      if (!ot?.value.trim()) {
        setErr('field-ot', 'err-ot', 'Escribí el número de OT.', ot);
        return;
      }
      if (!monto?.value.trim()) {
        setErr('field-monto', 'err-monto', 'Escribí el monto.', monto);
        return;
      }
      const otNum = ot.value.trim();
      const montoNum = monto.value.trim();
      const pagoVal = pago?.value || 'efectivo';
      closeSheet();
      showToast('Cobro registrado', `OT ${otNum} · ARS ${montoNum} · ${pagoVal}`);
    });

    function bindCaja(formId: string, fieldId: string, errId: string, inputId: string, caja: 1 | 2) {
      document.getElementById(formId)?.addEventListener('submit', (ev) => {
        ev.preventDefault();
        clearErr(fieldId, errId);
        const fondo = document.getElementById(inputId) as HTMLInputElement | null;
        if (!fondo?.value.trim()) {
          setErr(fieldId, errId, 'Indicá el fondo inicial.', fondo);
          return;
        }
        const fondoVal = fondo.value.trim();
        const slugM = window.location.pathname.match(/^\/tenant\/([^/]+)\/app/);
        const homeSlug = slugM ? slugM[1] : '';
        const submit = (ev.target as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement | null;
        if (submit) submit.disabled = true;
        void fetch(`/api/tenant/${homeSlug}/caja`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ caja, fondo: fondoVal }),
        })
          .then(async (res) => {
            const data = (await res.json().catch(() => null)) as { url?: string; error?: { message?: string } } | null;
            if (!res.ok || !data?.url) {
              setErr(fieldId, errId, data?.error?.message || 'No se pudo abrir el punto de venta.', fondo);
              if (submit) submit.disabled = false;
              return;
            }
            window.location.assign(data.url);
          })
          .catch(() => {
            setErr(fieldId, errId, 'No se pudo abrir el punto de venta.', fondo);
            if (submit) submit.disabled = false;
          });
      });
    }
    bindCaja('form-caja1', 'field-fondo1', 'err-fondo1', 'fondo1', 1);
    bindCaja('form-caja2', 'field-fondo2', 'err-fondo2', 'fondo2', 2);

    document.getElementById('form-stock')?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      clearErr('field-sku', 'err-sku');
      const qEl = document.getElementById('sku-q') as HTMLInputElement | null;
      const q = (qEl?.value || '').trim().toLowerCase();
      if (!q) {
        setErr('field-sku', 'err-sku', 'Escribí un código o nombre.', qEl);
        return;
      }
      const hit = STOCK.find((s) => s.q.some((k) => q.includes(k)) || s.name.toLowerCase().includes(q));
      const result = document.getElementById('stock-result');
      const nameEl = document.getElementById('stock-name');
      const metaEl = document.getElementById('stock-meta');
      if (!hit) {
        if (result) result.hidden = true;
        setErr('field-sku', 'err-sku', 'No encontramos ese ítem en el demo.', qEl);
        return;
      }
      if (nameEl) nameEl.textContent = hit.name;
      if (metaEl) metaEl.textContent = `${hit.stock} u. · ubicación ${hit.ubi}`;
      if (result) result.hidden = false;
      announce(`${hit.name}: ${hit.stock} unidades`);
    });

    const puestoTapados = () =>
      document.querySelectorAll('.mo-skip, .mo-live, .shell, #toast-region, .mo-dialog-backdrop, .mo-sheet-backdrop');

    function aplicarCandado(bloqueado: boolean) {
      const btn = document.querySelector('[data-bloquear]');
      const candado = document.getElementById('puesto-candado');
      const abrir = document.querySelector('[data-desbloquear]');
      if (!(btn instanceof HTMLButtonElement) || !(candado instanceof HTMLElement) || !(abrir instanceof HTMLButtonElement)) return;
      const abierto = btn.dataset.abierto;
      const cerrado = btn.dataset.cerrado;
      if (!abierto || !cerrado) return;
      if (bloqueado) closeSheet(true);
      btn.setAttribute('aria-pressed', bloqueado ? 'true' : 'false');
      btn.setAttribute('aria-label', bloqueado ? cerrado : abierto);
      candado.hidden = !bloqueado;
      document.documentElement.style.overflow = bloqueado ? 'hidden' : '';
      puestoTapados().forEach((el) => el.toggleAttribute('inert', bloqueado));
      if (bloqueado) abrir.focus();
      else btn.focus();
    }

    document.querySelector('[data-bloquear]')?.addEventListener('click', () => {
      aplicarCandado(true);
    });
    document.querySelector('[data-desbloquear]')?.addEventListener('click', () => {
      aplicarCandado(false);
    });

    document.querySelector('[data-logout]')?.addEventListener('click', () => {
      const backdrop = document.getElementById('confirm-backdrop');
      const confirmOk = document.getElementById('confirm-ok');
      if (!backdrop) return;
      lastFocus = document.activeElement as HTMLElement | null;
      openWithEnter(backdrop);
      confirmOk?.focus();
    });
    document.getElementById('confirm-cancel')?.addEventListener('click', () => {
      const backdrop = document.getElementById('confirm-backdrop');
      if (!backdrop) return;
      closeWithLeave(backdrop, {
        leaveMs: LEAVE_MS,
        onDone: () => lastFocus?.focus?.(),
      });
    });
    document.getElementById('confirm-ok')?.addEventListener('click', async () => {
      const confirmOk = document.getElementById('confirm-ok') as HTMLButtonElement | null;
      const confirmErr = document.getElementById('confirm-error');
      if (!confirmOk) return;
      const label = confirmOk.textContent || 'Cerrar sesión';
      confirmOk.disabled = true;
      confirmOk.textContent = 'Cerrando…';
      if (confirmErr instanceof HTMLElement) confirmErr.hidden = true;
      try {
        const res = await fetch('/api/auth/logout', { method: 'POST' });
        if (!res.ok) throw new Error('fail');
        window.location.assign('/login');
      } catch {
        confirmOk.disabled = false;
        confirmOk.textContent = label;
        if (confirmErr instanceof HTMLElement) {
          confirmErr.hidden = false;
          confirmErr.textContent = 'No se pudo cerrar la sesión. Probá de nuevo.';
        }
        confirmOk.focus();
      }
    });
    document.getElementById('confirm-backdrop')?.addEventListener('keydown', (ev) => {
      const backdrop = document.getElementById('confirm-backdrop');
      if (!backdrop) return;
      if (ev.key === 'Escape') {
        ev.preventDefault();
        closeWithLeave(backdrop, {
          leaveMs: LEAVE_MS,
          onDone: () => lastFocus?.focus?.(),
        });
        return;
      }
      trapTabKey(backdrop, ev);
    });

    // Home viva
    {
      const estadoEl = document.querySelector('[data-home-estado]');
      const cajaEl = document.querySelector('[data-home-caja]');
      const porCobrarEl = document.querySelector('[data-home-porcobrar]');
      const stockEl = document.querySelector('[data-home-stock]');
      const vsEl = document.querySelector('[data-home-vs]');
      const ojoBtn = document.querySelector('[data-home-ojito]');
      const ojoMsg = document.querySelector('[data-home-ojito-msg]');
      if (estadoEl && cajaEl && ojoBtn instanceof HTMLButtonElement) {
        const slugM = window.location.pathname.match(/^\/tenant\/([^/]+)\/app/);
        const homeSlug = slugM ? slugM[1] : '';
        const homeTab = new URLSearchParams(window.location.search).get('tab') || '';
        let montos: { cajaHoy: number; porCobrar: number; stockValorizado: number; vsAyerPct: number } | null = null;
        let oculto = false;
        const skeleton = document.querySelector('[data-home-skeleton]');
        const ready = document.querySelector('[data-home-ready]');
        const showReady = () => {
          if (skeleton instanceof HTMLElement) skeleton.hidden = true;
          if (ready instanceof HTMLElement) ready.hidden = false;
          ojoBtn.hidden = false;
        };
        const pinta = () => {
          cajaEl.textContent = montos ? textoCajaHoy(montos.cajaHoy, oculto) : '—';
          if (porCobrarEl) porCobrarEl.textContent = montos ? textoSinMoneda(montos.porCobrar, oculto) : '—';
          if (stockEl) stockEl.textContent = montos ? textoSinMoneda(montos.stockValorizado, oculto) : '—';
          if (vsEl instanceof HTMLElement && montos) {
            const p = montos.vsAyerPct;
            vsEl.textContent = p === 0 ? '' : `${p > 0 ? '↑' : '↓'} ${Math.abs(p)}% vs ayer`;
          }
        };
        ojoBtn.addEventListener('click', () => {
          oculto = !oculto;
          ojoBtn.setAttribute('aria-pressed', String(oculto));
          ojoBtn.textContent = oculto ? 'Mostrar montos' : 'Ocultar montos';
          if (ojoMsg) ojoMsg.textContent = oculto ? 'Montos ocultos.' : 'Montos visibles.';
          pinta();
        });
        (async () => {
          try {
            const res = await fetch(`/api/tenant/${homeSlug}/home?tab=${encodeURIComponent(homeTab)}`);
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = (await res.json()) as { home?: typeof montos };
            if (!data.home) throw new Error('sin home');
            montos = data.home;
            showReady();
            pinta();
          } catch {
            if (skeleton instanceof HTMLElement) skeleton.hidden = true;
            const err = document.querySelector('[data-home-error]');
            if (err instanceof HTMLElement) err.hidden = false;
          }
        })();
      }
    }

    const boot = new URLSearchParams(window.location.search);
    const flujoBoot = boot.get('flujo') || '';
    if (FLUJOS.has(flujoBoot)) openSheet(flujoBoot, true);
  </script>
</LightAppLayout>
