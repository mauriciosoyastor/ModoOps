---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { BffError } from "../../../lib/bff/errors.ts";
import { invalidateBffSession } from "../../../lib/bff/http.ts";
import { getBackend } from "../../../lib/bff/get-backend.ts";


export const prerender = false;

// Hub 2 — launcher por tenant (q2 recomendado): /tenant/[slug]/app tenant-scoped
const slug = String(Astro.params.slug || "").trim();
if (!slug || !/^[a-z0-9_]+$/.test(slug)) {
  return new Response("slug inválido", { status: 400 });
}

const _sessT = (Astro.locals as Record<string, unknown>).session as { name?: string; login?: string } | undefined;
const _odooT = (Astro.locals as Record<string, unknown>).odooSessionId as string | undefined;
if (!_odooT) return Astro.redirect("/login");
let odooSessionId: string = _odooT;
let userName = _sessT?.name || _sessT?.login || "";

// Solo interno Hub1 q5: si no es admin/modoops, igual allow para demo — en prod check groups_id
let tenant: import("../../../lib/bff/backend-client.ts").TenantRow | null = null;
let tenantError = "";
try {
  tenant = await getBackend().getTenantBySlug(odooSessionId, slug);
  if (!tenant) tenantError = `Tenant '${slug}' no existe en modoops_master`;
} catch (cause) {
  if (cause instanceof BffError && cause.code === "unauthorized") {
    invalidateBffSession(Astro.cookies);
    return Astro.redirect("/login");
  }
  tenantError = (cause as Error)?.message || "No se pudo cargar tenant";
}

let tiles: import("../../../lib/bff/types.ts").LauncherTile[] = [];
let launcherError = "";
if (tenant && !tenantError) {
  // Hub2 intenta traer launcher tenant-scoped si la DB tenant existe, fallback a master tiles
  try {
    tiles = (await getBackend().getLauncher(odooSessionId)).tiles;
  } catch (cause) {
    if (cause instanceof BffError && cause.code === "unauthorized") {
      invalidateBffSession(Astro.cookies);
      return Astro.redirect("/login");
    }
    launcherError = (cause as Error)?.message || "No se pudo cargar launcher";
  }
}

function accentVar(key: string): string {
  const map: Record<string, string> = {
    "flame-yellow": "var(--sg-flame-yellow)",
    "flame-orange": "var(--sg-flame-orange)",
    "flame-deep": "var(--sg-flame-deep)",
    "flame-rust": "var(--sg-flame-rust)",
    "ember-amber": "var(--sg-ember-amber)",
    "ember-coral": "var(--sg-ember-coral)",
    "ember-scarlet": "var(--sg-ember-scarlet)",
    "ember-wine": "var(--sg-ember-wine)",
  };
  return map[key] || "var(--sg-flame-orange)";
}

const hasIA = tenant?.modules_installed?.includes("IA ModoOps") ?? false;
---

<BaseLayout title={`${tenant?.name ?? slug} — ModoOps`} description={`Tenant ${slug} — ModoOps`}>
  <main class="mo-tenant">
    <header class="mo-tenant__topbar">
      <div>
        <p class="mo-tenant__eyebrow">ModoOps · Control Plane → Tenant</p>
        <h1>{tenant?.name ?? slug} <code class="mo-tenant__db">{tenant?.db_name ?? `modoops_${slug}`}</code></h1>
        <p class="mo-tenant__meta">
          {tenant ? `${tenant.vertical} · ` : ""}<span class:list={["mo-badge", `is-${tenant?.state ?? "activo"}`]}>{tenant?.state ?? "—"}</span>
          {` · ${tenant?.modules_installed_count ?? 0} módulos`}
          {hasIA ? <span class="mo-badge is-ia">IA activa</span> : <span class="mo-badge is-ia-off">IA no instalada</span>}
          {tenant?.abono_due_date ? ` · vto abono ${tenant.abono_due_date}` : ""}
        </p>
        <p class="mo-tenant__user">{userName} · <a href="/admin/tenants">← Admin tenants (Hub 1)</a></p>
      </div>
      <div class="mo-tenant__actions">
        <a href="/admin/tenants" class="mo-btn-ghost">← Tenants</a>
        <button type="button" data-logout class="mo-btn-ghost">Cerrar sesión</button>
      </div>
    </header>

    {tenantError ? <p class="mo-tenant__error">{tenantError} — <a href="/admin/tenants">volver a lista</a></p> : null}

    {tenant && !tenantError ? (
      <>
        <section class="mo-tenant__panel">
          <h2>Armar sistema — Módulos ModoOps del Catálogo</h2>
          <p class="mo-tenant__hint">Instalá/quita módulos para <code>{tenant.db_name}</code>. IA es un módulo más del Catálogo (q4). Preview <code>odoo-bin -d {tenant.db_name} -i/-u &lt;mod&gt;</code> auditado en <code>modoops.tenant.log</code>.</p>
          <div id="tenant-install-root" data-tenant-id={tenant.id} data-db={tenant.db_name} data-installed={tenant.modules_installed ?? ""}></div>
          <dialog id="tenant-install-dialog" class="mo-dialog">
            <form method="dialog" id="tenant-install-form">
              <h3>Gestionar módulos — {tenant.name}</h3>
              <p class="mo-dialog__db">{tenant.db_name}</p>
              <div class="mo-dialog__grid" id="tenant-install-grid"></div>
              <label class="mo-dialog__notes">Notas <input name="notes" placeholder="ticket, motivo" /></label>
              <div class="mo-dialog__actions">
                <label>Acción <select name="action"><option value="install">Instalar</option><option value="remove">Quitar</option></select></label>
                <button type="submit">Confirmar</button>
                <button type="button" id="tenant-install-cancel">Cancelar</button>
              </div>
              <pre id="tenant-install-preview" class="mo-dialog__preview"></pre>
              <span id="tenant-install-msg" class="mo-admin__msg"></span>
            </form>
          </dialog>
          <div class="mo-tenant__cta">
            <button type="button" id="tenant-install-open" class="mo-btn-primary">Gestionar módulos / IA</button>
            <a href="/admin/tenants" class="mo-btn-ghost">+ Nuevo Tenant</a>
            <span class="mo-tenant__modules">{tenant.modules_installed ? `Instalados: ${tenant.modules_installed}` : "0 módulos — armar sistema"}</span>
          </div>
          {!hasIA ? <p class="mo-tenant__ia-cta">¿Agregar IA? Tildá <strong>IA ModoOps — Agente herramental</strong> en “Gestionar módulos / IA” → hidrata <em>Mostrador, Depósito Inteligente, Compras, Fiscal AR, Taller, etc.</em> vía Tools <code>stock.consulta</code>/<code>ot.cobro</code> + Memoria tenant 90d.</p> : <p class="mo-tenant__ia-ok">IA activa — Tools: <a href={`/api/modoops/${tenant.db_name}/agent/tools`} target="_blank"><code>GET /api/modoops/{tenant.db_name}/agent/tools</code></a> · Techo 200/mes Log → 429.</p>}
        </section>

        <section>
          <h2 class="mo-tenant__h2">Launcher — {tenant.name} (tiles {tiles.length})</h2>
          {launcherError ? <p class="mo-tenant__error">{launcherError}</p> : tiles.length === 0 ? <p class="mo-tenant__empty">Sin tiles visibles para este usuario en este tenant.</p> : (
            <div class="mo-app__grid">
              {tiles.map((t) => (
                <div class="mo-tile sg-glass" data-accent={t.accent_key} style={`--tile-accent: ${accentVar(t.accent_key)}`}>
                  <span class="mo-tile__icon">{t.label.trim().slice(0,1).toUpperCase()}</span>
                  <span class="mo-tile__copy"><span class="mo-tile__label">{t.label}</span><span class="mo-tile__hint">{t.hint}</span></span>
                  <span class="mo-tile__kpi"><span class="mo-tile__value">{t.value ?? "—"}</span></span>
                  <span class="mo-tile__enter">{t.enter_label || "Abrir"} →</span>
                </div>
              ))}
            </div>
          )}
        </section>
      </>
    ) : null}
  </main>
</BaseLayout>

<script>
  import { CATALOGO_LABELS } from "../../../lib/catalogo.generated.ts";
  const CATALOGO = Object.entries(CATALOGO_LABELS) as unknown as readonly (readonly [string, string])[];

  const root = document.getElementById("tenant-install-root") as HTMLDivElement | null;
  const dlg = document.getElementById("tenant-install-dialog") as HTMLDialogElement | null;
  const grid = document.getElementById("tenant-install-grid") as HTMLDivElement | null;
  const previewEl = document.getElementById("tenant-install-preview") as HTMLPreElement | null;
  const msgEl = document.getElementById("tenant-install-msg") as HTMLSpanElement | null;
  const form = document.getElementById("tenant-install-form") as HTMLFormElement | null;
  const openBtn = document.getElementById("tenant-install-open") as HTMLButtonElement | null;
  const cancelBtn = document.getElementById("tenant-install-cancel") as HTMLButtonElement | null;

  const tenantId = root ? Number(root.dataset.tenantId) : NaN;
  const db = root ? String(root.dataset.db || "modoops_<slug>") : "modoops_<slug>";

  function renderGrid() {
    if (!grid) return;
    grid.innerHTML = "";
    for (const [key, label] of CATALOGO) {
      const lbl = document.createElement("label");
      lbl.className = "mo-check";
      lbl.innerHTML = `<input type="checkbox" value="${key}" data-mod /> ${label} <code>${key}</code>`;
      grid.appendChild(lbl);
    }
  }
  renderGrid();

  function updatePreview() {
    if (!grid || !previewEl || !form) return;
    const mods = [...grid.querySelectorAll<HTMLInputElement>("[data-mod]:checked")].map(i=>i.value);
    const action = (form.querySelector('select[name="action"]') as HTMLSelectElement)?.value || "install";
    const flag = action === "install" ? "-i" : "-u";
    previewEl.textContent = mods.length ? `odoo-bin -d ${db} ${flag} ${mods.join(", ")}  # batch ${mods.length}` : "— seleccioná módulos —";
  }
  grid?.addEventListener("change", updatePreview);
  form?.querySelector('select[name="action"]')?.addEventListener("change", updatePreview);
  openBtn?.addEventListener("click", () => {
    if (!dlg || !grid || !previewEl || !msgEl) return;
    msgEl.textContent = "";
    previewEl.textContent = "— seleccioná módulos —";
    grid.querySelectorAll<HTMLInputElement>("[data-mod]").forEach(i=>i.checked=false);
    dlg.showModal();
  });
  cancelBtn?.addEventListener("click", () => dlg?.close());
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!Number.isFinite(tenantId) || !grid || !msgEl || !previewEl || !form) return;
    const mods = [...grid.querySelectorAll<HTMLInputElement>("[data-mod]:checked")].map(i=>i.value);
    if (!mods.length) { msgEl.textContent = "Seleccioná al menos un módulo"; return; }
    const fd = new FormData(form);
    const action = String(fd.get("action")||"install");
    const notes = String(fd.get("notes")||"");
    msgEl.textContent = "Ejecutando…";
    const res = await fetch(`/api/admin/tenants/${tenantId}/install`, { method:"POST", headers:{"content-type":"application/json"}, body: JSON.stringify({ modules: mods, action, notes }) });
    const data = await res.json().catch(()=>({})) as { preview_command?: string; error?: { message?: string } };
    if (!res.ok) { msgEl.textContent = data?.error?.message || "Error"; return; }
    previewEl.textContent = (data as { preview_command?: string }).preview_command || previewEl.textContent;
    msgEl.textContent = "OK — recargando…";
    setTimeout(()=> window.location.reload(), 700);
  });
  document.querySelector("[data-logout]")?.addEventListener("click", async()=>{ await fetch("/api/auth/logout",{method:"POST"}); window.location.assign("/login"); });
</script>

<style>
  .mo-tenant { max-width:78rem; margin:0 auto; padding:2rem 1rem 3rem; }
  .mo-tenant__topbar { display:flex; justify-content:space-between; gap:1rem; margin-bottom:1.25rem; flex-wrap:wrap; }
  .mo-tenant__eyebrow { color:var(--sg-flame-orange); font-size:.7rem; letter-spacing:.14em; text-transform:uppercase; margin:0; font-weight:700; }
  .mo-tenant__db { font-size:.75rem; color:var(--sg-text-muted-dark); }
  .mo-tenant__meta { color:var(--sg-text-muted-dark); margin:.25rem 0 0; font-size:.85rem; }
  .mo-tenant__user { margin:.25rem 0 0; font-size:.85rem; }
  .mo-tenant__panel { border:1px solid var(--sg-glass-border); border-radius:1rem; padding:1.1rem; background:var(--sg-glass-fill); backdrop-filter:blur(10px); margin-bottom:1.25rem; }
  .mo-tenant__panel h2 { margin:0 0 .4rem; font-size:1.05rem; }
  .mo-tenant__hint { color:var(--sg-text-muted-dark); font-size:.85rem; margin:.25rem 0 .75rem; }
  .mo-tenant__cta { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; margin-top:.5rem; }
  .mo-btn-primary { border-radius:999px; padding:.55rem .95rem; background:#fff; color:#111; border:0; cursor:pointer; font-weight:600; }
  .mo-btn-ghost { border:1px solid var(--sg-glass-border); border-radius:999px; padding:.5rem .9rem; background:var(--sg-glass-fill); color:var(--sg-text-on-dark); text-decoration:none; cursor:pointer; }
  .mo-tenant__modules { font-size:.8rem; color:var(--sg-text-muted-dark); }
  .mo-tenant__ia-cta, .mo-tenant__ia-ok { font-size:.85rem; margin:.6rem 0 0; }
  .mo-tenant__h2 { font-size:1rem; margin:1rem 0 .5rem; }
  .mo-app__grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(18rem,1fr)); gap:1rem; }
  .mo-tile { position:relative; display:grid; min-height:12rem; grid-template-columns:1fr auto; grid-template-rows:auto 1fr auto; gap:1rem; overflow:hidden; border-radius:var(--sg-radius-card); padding:1.2rem; color:var(--sg-text-on-dark); background:var(--sg-glass-fill); border:1px solid var(--sg-glass-border); backdrop-filter:blur(10px); }
  .mo-tile__icon { display:grid; width:2.75rem; height:2.75rem; place-items:center; border-radius:.9rem; background:color-mix(in srgb, var(--tile-accent), transparent 54%); border:1px solid color-mix(in srgb, var(--tile-accent), white 22%); font-weight:700; }
  .mo-tile__label { display:block; font-weight:650; }
  .mo-tile__hint { display:block; color:var(--sg-text-muted-dark); font-size:.84rem; }
  .mo-tile__kpi { justify-self:end; background:rgba(0,0,0,.28); border:1px solid color-mix(in srgb, var(--tile-accent), white 18%); border-radius:.9rem; padding:.5rem .7rem; min-width:4rem; display:grid; justify-items:end; }
  .mo-tile__value { font-weight:700; }
  .mo-tile__enter { grid-column:1/-1; border-top:1px solid var(--sg-glass-border); padding-top:.9rem; font-size:.8rem; font-weight:600; display:flex; justify-content:space-between; }
  .mo-tenant__error { color:#f87171; } .mo-tenant__empty { color:var(--sg-text-muted-dark); }
  .mo-dialog { border:1px solid var(--sg-glass-border); border-radius:1rem; padding:1.2rem; background:#111; color:#fff; max-width:36rem; width:90%; }
  .mo-dialog::backdrop { background:rgba(0,0,0,.6); backdrop-filter:blur(4px); }
  .mo-dialog__db { color:var(--sg-flame-orange); font-family:monospace; }
  .mo-dialog__grid { display:grid; grid-template-columns:1fr 1fr; gap:.4rem; margin:.5rem 0; }
  .mo-check { display:flex; gap:.35rem; align-items:center; font-size:.85rem; border:1px solid #2b2b2b; border-radius:.5rem; padding:.4rem .5rem; background:#0a0a0a; }
  .mo-check code { font-size:.7rem; color:#aaa; margin-left:auto; }
  .mo-dialog__notes { display:flex; flex-direction:column; gap:.25rem; font-size:.85rem; }
  .mo-dialog__notes input { border:1px solid #2b2b2b; border-radius:.5rem; padding:.45rem .6rem; background:#0a0a0a; color:#fff; }
  .mo-dialog__actions { display:flex; gap:.5rem; align-items:end; margin:.5rem 0; }
  .mo-dialog__preview { background:#0a0a0a; border:1px solid #2b2b2b; border-radius:.5rem; padding:.6rem; font-size:.75rem; white-space:pre-wrap; }
  .mo-badge { border-radius:999px; padding:.15rem .5rem; font-size:.75rem; font-weight:600; }
  .mo-badge.is-activo { background:#16a34a; color:#fff; } .mo-badge.is-suspendido { background:#dc2626; color:#fff; } .mo-badge.is-baja { background:#6b7280; color:#fff; }
  .mo-badge.is-ia { background:#7c3aed; color:#fff; margin-left:.35rem; } .mo-badge.is-ia-off { background:#2b2b2b; color:#aaa; margin-left:.35rem; }
</style>
