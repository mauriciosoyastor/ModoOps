---
import LightAppLayout from '../../layouts/LightAppLayout.astro';
import { BffError } from '../../lib/bff/errors.ts';
import { invalidateBffSession } from '../../lib/bff/http.ts';
import { getBackend } from '../../lib/bff/get-backend.ts';
import type { LeadFilters } from '../../lib/bff/leads.ts';
import { formatFechaCaptura, formatTelefono } from '../../lib/bff/captacion.ts';

const _sessA = (Astro.locals as Record<string, unknown>).session as { name?: string; login?: string } | undefined;
const _odooA = (Astro.locals as Record<string, unknown>).odooSessionId as string | undefined;
if (!_odooA) return Astro.redirect('/login');
const odooSessionId: string = _odooA;
const userName = _sessA?.name || _sessA?.login || '';

const q = Astro.url.searchParams;
const filters: LeadFilters = {
  estado: (['nuevo', 'contactado', 'descartado'].includes(q.get('estado') || '') ? q.get('estado') : '') as LeadFilters['estado'],
  sinTelefono: q.get('sin_telefono') === '1',
  optOut: q.get('opt_out') === '1',
};

let leads: import('../../lib/bff/leads.ts').LeadRow[] = [];
let loadError = '';
try {
  leads = await getBackend().getLeads(odooSessionId, filters);
} catch (cause) {
  if (cause instanceof BffError && cause.code === 'unauthorized') {
    invalidateBffSession(Astro.cookies);
    return Astro.redirect('/login');
  }
  loadError = (cause as Error)?.message || 'No se pudo mostrar la lista';
}

const leadsHref = (next: { estado?: string; sinTelefono?: boolean; optOut?: boolean }) => {
  const estado = next.estado ?? filters.estado;
  const sinTelefono = next.sinTelefono ?? filters.sinTelefono;
  const optOut = next.optOut ?? filters.optOut;
  const p = new URLSearchParams();
  if (estado) p.set('estado', estado);
  if (sinTelefono) p.set('sin_telefono', '1');
  if (optOut) p.set('opt_out', '1');
  const s = p.toString();
  return s ? `/admin/leads?${s}` : '/admin/leads';
};

const countLabel = leads.length === 1 ? '1 lead' : `${leads.length} leads`;
const filtersOn = Boolean(filters.estado || filters.sinTelefono || filters.optOut);
---

<LightAppLayout title="Leads — ModoOps" description="Control Plane — leads de captación" theme="papel">
  <div class="mo-live" id="live-polite" aria-live="polite" aria-atomic="true"></div>
  <div class="shell" id="contenido">
    <header class="app-bar">
      <div class="app-bar__identity">
        <h1 class="app-bar__title">Leads</h1>
        <p class="app-bar__meta">Control Plane{userName ? ` · ${userName}` : ''}</p>
      </div>
      <nav class="app-bar__nav" aria-label="Secciones">
        <a class="app-link" href="/admin/tenants">Tenants</a>
        <a class="app-link" href="/app">App</a>
        <button type="button" class="app-link app-link--session" data-logout>Cerrar sesión</button>
      </nav>
    </header>

    <div class="tools">
      <div class="tools__view">
        <button type="button" class="mo-btn mo-btn--ghost" data-video>Video IA</button>
        <button type="button" class="mo-btn mo-btn--ghost" data-purge>Purgar vencidos</button>
      </div>
      <nav class="filters" aria-label="Filtros de leads">
        <div class="mo-pill-group" role="group" aria-label="Estado">
          <a class="mo-pill" href={leadsHref({ estado: '' })} aria-current={!filters.estado ? 'true' : undefined}>Todos</a>
          <a class:list={['mo-pill', filters.estado === 'nuevo' && 'mo-pill--ok']} href={leadsHref({ estado: 'nuevo' })} aria-current={filters.estado === 'nuevo' ? 'true' : undefined}>Nuevo</a>
          <a class:list={['mo-pill', filters.estado === 'contactado' && 'mo-pill--accent']} href={leadsHref({ estado: 'contactado' })} aria-current={filters.estado === 'contactado' ? 'true' : undefined}>Contactado</a>
          <a class="mo-pill" href={leadsHref({ estado: 'descartado' })} aria-current={filters.estado === 'descartado' ? 'true' : undefined}>Descartado</a>
        </div>
        <div class="mo-pill-group" role="group" aria-label="Teléfono y baja">
          <a class="mo-pill" href={leadsHref({ sinTelefono: !filters.sinTelefono })} aria-current={filters.sinTelefono ? 'true' : undefined}>Sin teléfono</a>
          <a class="mo-pill" href={leadsHref({ optOut: !filters.optOut })} aria-current={filters.optOut ? 'true' : undefined}>Con baja</a>
        </div>
      </nav>
    </div>

    <main class="content">
      <p class="cp-note">Sin teléfono queda visible como descartado. La baja borra el lead y audita sin datos personales. Purgar saca vencidos de más de 90 días y las bajas.</p>

      {loadError ? <p class="mo-banner mo-banner--danger" role="alert">{loadError}</p> : null}

      <section class="mo-panel" aria-label="Lista de leads">
        <div class="mo-table-chrome">
          <p class="mo-table-chrome__meta">{countLabel}</p>
        </div>
        {leads.length === 0 && !loadError ? (
          <div class="mo-empty">
            <p class="mo-empty__title">Sin leads</p>
            <p class="mo-empty__text">{filtersOn ? 'Nada coincide con estos filtros.' : 'Todavía no hay leads de captación.'}</p>
            {filtersOn ? (
              <div class="mo-empty__actions">
                <a class="mo-btn mo-btn--ghost" href="/admin/leads">Limpiar filtros</a>
              </div>
            ) : null}
          </div>
        ) : (
          <div class="table-wrap">
            <table class="mo-table">
              <thead>
                <tr>
                  <th>Nombre</th>
                  <th>Teléfono</th>
                  <th>Categoría</th>
                  <th>Estado</th>
                  <th>Baja</th>
                  <th>Captura</th>
                  <th><span class="sr-only">Acción</span></th>
                </tr>
              </thead>
              <tbody>
                {leads.map((l) => (
                  <tr>
                    <td>
                      <strong>{l.nombre}</strong>
                      {!l.telefono ? <span class="mo-badge is-warn">Sin teléfono</span> : null}
                    </td>
                    <td>{formatTelefono(l.telefono)}</td>
                    <td>{l.categoria || '—'}</td>
                    <td><span class:list={['mo-badge', `is-${l.estado}`]}>{l.estado}</span></td>
                    <td>{l.opt_out ? 'Sí' : 'No'}</td>
                    <td>{formatFechaCaptura(l.fecha_captura)}</td>
                    <td>
                      {!l.opt_out ? (
                        <button type="button" class="mo-btn mo-btn--ghost" data-optout data-lead-id={l.id} data-lead-name={l.nombre}>
                          Baja
                        </button>
                      ) : '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </section>

    </main>
  </div>

  <div class="mo-toast-region" id="toast-region" aria-relevant="additions"></div>

  <div class="mo-dialog-backdrop" id="confirm-backdrop" hidden>
    <div class="mo-dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-text">
      <h2 class="mo-dialog__title" id="confirm-title">Confirmar</h2>
      <p class="mo-dialog__text" id="confirm-text"></p>
      <div class="mo-dialog__actions">
        <button type="button" class="mo-btn mo-btn--ghost" id="confirm-cancel">Cancelar</button>
        <button type="button" class="mo-btn mo-btn--danger" id="confirm-ok">Confirmar</button>
      </div>
    </div>
  </div>

  <style>
    .shell { min-height: 100dvh; }
    .app-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      align-items: center;
      padding:
        max(0.85rem, env(safe-area-inset-top))
        max(1.35rem, env(safe-area-inset-right))
        0.85rem
        max(1.35rem, env(safe-area-inset-left));
      max-width: 72rem;
      border-bottom: 1px solid var(--mo-line);
    }
    .app-bar__title {
      margin: 0;
      font-family: var(--mo-font);
      font-size: 1.1rem;
      font-weight: 650;
      letter-spacing: -0.02em;
      line-height: 1.2;
      text-wrap: balance;
    }
    .app-bar__meta {
      margin: 0.1rem 0 0;
      font-size: 0.85rem;
      color: var(--mo-muted);
    }
    .app-bar__nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.15rem 0.35rem;
      align-items: center;
    }
    .app-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 0.35rem;
      border: 0;
      background: transparent;
      color: var(--mo-muted);
      font: inherit;
      text-decoration: underline;
      text-decoration-color: var(--mo-line-strong);
      text-underline-offset: 0.22em;
      font-size: 0.92rem;
      font-weight: 500;
      cursor: pointer;
      touch-action: manipulation;
      transition: color 140ms var(--mo-ease-out);
    }
    @media (hover: hover) and (pointer: fine) {
      .app-link:hover {
        color: var(--mo-ink);
      }
    }
    .app-link--session {
      margin-left: 0.35rem;
      padding-left: 0.85rem;
      border-left: 1px solid var(--mo-line);
    }
    .tools {
      display: grid;
      gap: 0.65rem;
      padding: 0.85rem 1.35rem 0.45rem;
      max-width: 72rem;
    }
    .tools__view {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      align-items: center;
    }
    .content {
      padding: 0 1.35rem 2rem;
      display: grid;
      gap: 1rem;
      max-width: 72rem;
    }
    .filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem 1.25rem;
    }
    .filters .mo-pill {
      min-height: 44px;
      padding-inline: 0.85rem;
    }
    /* El sólido de --mo-ok y --mo-accent no llega a AA con --mo-on-hero; se oscurece hacia --mo-hero. */
    .filters .mo-pill--ok[aria-current="true"] {
      --pill-fill: color-mix(in srgb, var(--mo-ok) 85%, var(--mo-hero));
      background: var(--pill-fill);
      border-color: var(--pill-fill);
      color: var(--mo-on-hero);
    }
    .filters .mo-pill--accent[aria-current="true"] {
      --pill-fill: color-mix(in srgb, var(--mo-accent) 65%, var(--mo-hero));
      background: var(--pill-fill);
      border-color: var(--pill-fill);
      color: var(--mo-on-hero);
    }
    .cp-note {
      margin: 0;
      max-width: 65ch;
      font-size: 0.85rem;
      color: var(--mo-muted);
    }
    .mo-table tbody tr {
      content-visibility: auto;
      contain-intrinsic-size: auto 3.25rem;
    }
    .table-wrap {
      overflow: auto;
      scroll-padding-top: 3rem;
      scroll-padding-bottom: 4.5rem;
    }
    .mo-table th,
    .mo-table td { white-space: normal; }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .mo-table td .mo-badge { margin-left: 0.45rem; }
  </style>

  <script>
    import {
      resolveLeaveMs,
      openWithEnter,
      closeWithLeave,
      showToast as mountToast,
      trapTabKey,
    } from '../../scripts/light-app-chrome.ts';
    import { sessionCloseCopy } from '../../lib/control-plane-vista.ts';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const LEAVE_MS = resolveLeaveMs(reduceMotion, 120);
    const toastRegion = document.getElementById('toast-region');
    const live = document.getElementById('live-polite');
    const backdrop = document.getElementById('confirm-backdrop');
    const confirmTitle = document.getElementById('confirm-title');
    const confirmText = document.getElementById('confirm-text');
    const confirmOk = document.getElementById('confirm-ok') as HTMLButtonElement | null;
    const confirmCancel = document.getElementById('confirm-cancel');
    let pendingAction: null | (() => Promise<boolean>) = null;
    let pendingOkLabel = 'Confirmar';
    let pendingBusyLabel = 'Confirmando…';
    let pendingFailTitle = 'No se pudo completar';
    let pendingFailBody = 'Reintentá.';
    let lastFocus: HTMLElement | null = null;

    function announce(msg: string) {
      if (!live) return;
      live.textContent = '';
      requestAnimationFrame(() => {
        live.textContent = msg;
      });
    }

    function showToast(title: string, text: string, kind: 'ok' | 'danger' = 'ok') {
      if (!toastRegion) return;
      mountToast({ region: toastRegion, title, text, kind, leaveMs: LEAVE_MS, announce });
    }

    function openConfirm(opts: {
      title: string;
      text: string;
      okLabel: string;
      busyLabel: string;
      failTitle: string;
      failBody: string;
      cancelLabel?: string;
      danger: boolean;
      onConfirm: () => Promise<boolean>;
    }) {
      if (!backdrop || !confirmTitle || !confirmText || !confirmOk || !confirmCancel) return;
      lastFocus = document.activeElement as HTMLElement | null;
      pendingAction = opts.onConfirm;
      pendingOkLabel = opts.okLabel;
      pendingBusyLabel = opts.busyLabel;
      pendingFailTitle = opts.failTitle;
      pendingFailBody = opts.failBody;
      confirmTitle.textContent = opts.title;
      confirmText.textContent = opts.text;
      confirmOk.disabled = false;
      confirmOk.textContent = opts.okLabel;
      confirmCancel.textContent = opts.cancelLabel || 'Cancelar';
      (confirmCancel as HTMLButtonElement).disabled = false;
      confirmOk.className = opts.danger ? 'mo-btn mo-btn--danger' : 'mo-btn mo-btn--primary';
      openWithEnter(backdrop);
      confirmOk.focus();
    }

    function closeConfirm() {
      if (!backdrop) return;
      closeWithLeave(backdrop, {
        leaveMs: LEAVE_MS,
        onDone: () => {
          pendingAction = null;
          lastFocus?.focus?.();
        },
      });
    }

    confirmCancel?.addEventListener('click', closeConfirm);
    confirmOk?.addEventListener('click', async () => {
      if (!confirmOk || !confirmCancel || !pendingAction) return;
      const fn = pendingAction;
      const cancelBtn = confirmCancel as HTMLButtonElement;
      confirmOk.disabled = true;
      cancelBtn.disabled = true;
      confirmOk.textContent = pendingBusyLabel;
      let done = false;
      try {
        done = await fn();
      } catch {
        done = false;
        showToast(pendingFailTitle, pendingFailBody, 'danger');
      }
      if (done) {
        closeConfirm();
        return;
      }
      confirmOk.disabled = false;
      cancelBtn.disabled = false;
      confirmOk.textContent = pendingOkLabel;
    });
    backdrop?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') {
        ev.preventDefault();
        closeConfirm();
        return;
      }
      trapTabKey(backdrop, ev);
    });
    backdrop?.addEventListener('click', (ev) => {
      if (ev.target === backdrop) closeConfirm();
    });

    document.querySelector('[data-logout]')?.addEventListener('click', () => {
      const copy = sessionCloseCopy('control-plane');
      openConfirm({
        title: copy.title,
        text: copy.text,
        okLabel: copy.okLabel,
        busyLabel: 'Cerrando…',
        failTitle: 'No se pudo cerrar la sesión',
        failBody: 'Reintentá cerrar la sesión.',
        cancelLabel: copy.cancelLabel,
        danger: false,
        onConfirm: async () => {
          const res = await fetch('/api/auth/logout', { method: 'POST' });
          if (!res.ok) {
            showToast('No se pudo cerrar la sesión', 'Reintentá cerrar la sesión.', 'danger');
            return false;
          }
          showToast('Sesión cerrada', copy.text, 'ok');
          window.setTimeout(() => window.location.assign('/login'), 400);
          return true;
        },
      });
    });

    document.querySelectorAll('[data-video]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const res = await fetch('/api/admin/tenants/video-access');
        const data = await res.json().catch(() => ({})) as { url?: string; target?: string; error?: { code?: string; message?: string } };
        if (res.ok && data.url) {
          announce(`Video listo. Se abre ${data.url}`);
          showToast('Video IA', 'Se abrió el generador.', 'ok');
          window.open(data.url, data.target || '_blank', 'noopener');
          return;
        }
        const label = data?.error?.message || 'Sin acceso al generador.';
        announce(label);
        showToast('Video IA', label, 'danger');
      });
    });

    document.querySelector('[data-purge]')?.addEventListener('click', () => {
      openConfirm({
        title: '¿Purgar leads vencidos?',
        text: 'Sacá los de más de 90 días y las bajas. Queda la auditoría de la captación.',
        okLabel: 'Purgar',
        busyLabel: 'Purgando…',
        failTitle: 'No se pudo purgar',
        failBody: 'Reintentá la purga.',
        cancelLabel: 'Cancelar',
        danger: true,
        onConfirm: async () => {
          const res = await fetch('/api/admin/leads', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ action: 'purge' }),
          });
          const data = await res.json().catch(() => ({})) as { purged?: number; error?: { message?: string } };
          if (!res.ok) {
            showToast('No se pudo purgar', 'Reintentá la purga.', 'danger');
            return false;
          }
          const n = data.purged ?? 0;
          showToast('Purga lista', n === 1 ? '1 lead purgado.' : `${n} leads purgados.`, 'ok');
          window.setTimeout(() => window.location.reload(), 700);
          return true;
        },
      });
    });

    document.querySelectorAll('[data-optout]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const id = Number(el.dataset.leadId);
        const name = el.dataset.leadName || 'este lead';
        openConfirm({
          title: `¿Dar de baja a ${name}?`,
          text: 'Se borra el lead. Queda la auditoría de la captación, sin datos personales.',
          okLabel: 'Dar de baja',
          busyLabel: 'Dando de baja…',
          failTitle: 'No se pudo dar de baja',
          failBody: 'Reintentá la baja.',
          cancelLabel: 'Cancelar',
          danger: true,
          onConfirm: async () => {
            const res = await fetch('/api/admin/leads', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ action: 'opt_out', id }),
            });
            if (!res.ok) {
              showToast('No se pudo dar de baja', 'Reintentá la baja.', 'danger');
              return false;
            }
            showToast('Lead dado de baja', name, 'ok');
            window.setTimeout(() => window.location.reload(), 500);
            return true;
          },
        });
      });
    });
  </script>
</LightAppLayout>
