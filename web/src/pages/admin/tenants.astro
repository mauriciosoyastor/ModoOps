---
import LightAppLayout from '../../layouts/LightAppLayout.astro';
import { BffError } from '../../lib/bff/errors.ts';
import { invalidateBffSession } from '../../lib/bff/http.ts';
import { getBackend } from '../../lib/bff/get-backend.ts';

const _sessA = (Astro.locals as Record<string, unknown>).session as { name?: string; login?: string } | undefined;
const _odooA = (Astro.locals as Record<string, unknown>).odooSessionId as string | undefined;
if (!_odooA) return Astro.redirect('/login');
const odooSessionId: string = _odooA;
const userName = _sessA?.name || _sessA?.login || '';

let tenants: import('../../lib/bff/backend-client.ts').TenantRow[] = [];
let loadError = '';
try {
  tenants = await getBackend().getTenants(odooSessionId);
} catch (cause) {
  if (cause instanceof BffError && cause.code === 'unauthorized') {
    invalidateBffSession(Astro.cookies);
    return Astro.redirect('/login');
  }
  loadError = (cause as Error)?.message || 'No se pudo cargar la lista';
}

const estado = ['todos', 'activo', 'suspendido', 'moroso'].includes(Astro.url.searchParams.get('estado') || '')
  ? (Astro.url.searchParams.get('estado') as string)
  : 'todos';
const qRaw = (Astro.url.searchParams.get('q') || '').trim();
const q = qRaw.toLowerCase();

const filtered = tenants.filter((t) => {
  if (estado !== 'todos' && t.state !== estado) return false;
  if (q && !(`${t.name} ${t.slug} ${t.db_name}`).toLowerCase().includes(q)) return false;
  return true;
});

const mora = tenants.filter((t) => t.state === 'moroso').length;
const susp = tenants.filter((t) => t.state === 'suspendido').length;
const activos = tenants.filter((t) => t.state === 'activo').length;

const qs = (e: string, query: string) => {
  const p = new URLSearchParams();
  p.set('estado', e);
  if (query) p.set('q', query);
  const s = p.toString();
  return s ? `/admin/tenants?${s}` : '/admin/tenants';
};

const nuevo = Astro.url.searchParams.get('nuevo') === '1';

const fecha = new Intl.DateTimeFormat('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric' });
const usd = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'USD' });

function formatDue(iso: string | null | undefined) {
  if (!iso) return '—';
  const match = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso);
  if (!match) return iso;
  return fecha.format(new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3])));
}

function formatUsd(value: number | null | undefined) {
  if (value == null || value === 0) return '—';
  return usd.format(value);
}

const vistaJson = JSON.stringify(
  filtered.map((t) => ({
    id: t.id,
    name: t.name,
    slug: t.slug,
    state: t.state,
    modules: t.modules_installed_count,
    due: t.abono_due_date || '',
    saldoUsd: t.saldo_pendiente_usd,
  })),
);
---

<LightAppLayout title="Tenants — ModoOps" description="Control Plane — tenants" theme="papel">
  <div class="mo-live" id="live-polite" aria-live="polite" aria-atomic="true"></div>
  <div class="shell" id="contenido">
    <header class="app-bar">
      <div class="app-bar__identity">
        <h1 class="app-bar__title">Tenants</h1>
        <p class="app-bar__meta">Control Plane{userName ? ` · ${userName}` : ''}</p>
      </div>
      <nav class="app-bar__nav" aria-label="Secciones">
        <a class="app-link" href="/admin/leads">Leads</a>
        <a class="app-link" href="/app">App</a>
        <button type="button" class="app-link app-link--session" data-logout>Cerrar sesión</button>
      </nav>
      <button type="button" class="mo-btn mo-btn--primary" id="btn-nuevo" aria-expanded={nuevo ? 'true' : 'false'} aria-controls="panel-nuevo">
        + Nuevo tenant
      </button>
    </header>

    <div class="tools">
      <div class="tools__view">
        <form class="search" method="get" action="/admin/tenants" role="search">
          <input type="hidden" name="estado" value={estado} />
          <label for="q">Buscar tenant</label>
          <input
            id="q"
            name="q"
            type="search"
            inputmode="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Buscar por nombre o slug…"
            value={qRaw}
          />
        </form>
        <button type="button" class="mo-btn mo-btn--ghost" id="btn-export">Exportar</button>
      </div>
      <nav class="filters mo-pill-group" aria-label="Filtro estado">
        <a class="mo-pill" href={qs('todos', qRaw)} aria-current={estado === 'todos' ? 'true' : undefined}>Todos</a>
        <a class:list={['mo-pill', 'mo-pill--ok']} href={qs('activo', qRaw)} aria-current={estado === 'activo' ? 'true' : undefined}>Activo</a>
        <a class:list={['mo-pill', 'mo-pill--warn']} href={qs('moroso', qRaw)} aria-current={estado === 'moroso' ? 'true' : undefined}>Moroso</a>
        <a class:list={['mo-pill', 'mo-pill--danger']} href={qs('suspendido', qRaw)} aria-current={estado === 'suspendido' ? 'true' : undefined}>Suspendido</a>
      </nav>
    </div>

    <main class="content">
      {loadError ? (
        <p class="mo-banner mo-banner--danger" role="alert">{loadError}</p>
      ) : mora > 0 && estado === 'todos' ? (
        <aside class="mo-banner mo-banner--warn" role="status">
          <span class="mo-banner__mark">Atención</span>
          <div class="mo-banner__body">
            <p class="mo-banner__title">{mora === 1 ? '1 tenant en mora' : `${mora} tenants en mora`}</p>
            <p class="mo-banner__text">Hay abonos vencidos. Priorizá el contacto antes de suspender.</p>
          </div>
          <div class="mo-banner__actions">
            <a class="mo-btn mo-btn--ghost" href={qs('moroso', '')}>Ver mora</a>
          </div>
        </aside>
      ) : susp > 0 && estado === 'todos' && mora === 0 ? (
        <aside class="mo-banner mo-banner--danger" role="status">
          <span class="mo-banner__mark">Sistema</span>
          <div class="mo-banner__body">
            <p class="mo-banner__title">{susp === 1 ? '1 tenant suspendido' : `${susp} tenants suspendidos`}</p>
            <p class="mo-banner__text">No operan hasta reactivarlos.</p>
          </div>
          <div class="mo-banner__actions">
            <a class="mo-btn mo-btn--ghost" href={qs('suspendido', '')}>Ver suspendidos</a>
          </div>
        </aside>
      ) : null}

      <div class:list={['create-panel', { 'is-in': nuevo }]} id="panel-nuevo" hidden={!nuevo}>
        <h2 class="mo-dialog__title">Crear tenant</h2>
        <form id="create-tenant-form" class="create-grid">
          <div class="mo-field" id="field-nombre">
            <label class="mo-field__label" for="tenant-nombre">Nombre</label>
            <input class="mo-field__control" id="tenant-nombre" name="name" placeholder="Pinturería Centro…" required autocomplete="organization" />
          </div>
          <div class="mo-field">
            <label class="mo-field__label" for="tenant-slug">Slug (opcional)</label>
            <input class="mo-field__control" id="tenant-slug" name="slug" placeholder="pintureria_centro…" pattern="[a-z0-9_]+" inputmode="text" spellcheck="false" autocomplete="off" />
          </div>
          <div class="mo-field">
            <label class="mo-field__label" for="tenant-vertical">Vertical</label>
            <select class="mo-field__control" id="tenant-vertical" name="vertical">
              <option value="retail">retail</option>
              <option value="servicios">servicios</option>
              <option value="distribucion">distribucion</option>
            </select>
          </div>
          <div class="create-panel__actions">
            <button type="submit" class="mo-btn mo-btn--primary" id="btn-crear">Crear tenant</button>
            <button type="button" class="mo-btn mo-btn--ghost" id="btn-cancelar-nuevo">Cancelar</button>
            <span id="create-msg" class="mo-field__hint"></span>
          </div>
        </form>
      </div>

      <section class="mo-panel" aria-label="Lista de tenants">
        <div class="mo-table-chrome">
          <p class="mo-table-chrome__meta">
            {activos === 1 ? '1 activo' : `${activos} activos`} de {tenants.length}{estado !== 'todos' || qRaw ? ` · mostrando ${filtered.length}` : ''}
          </p>
        </div>
        {filtered.length === 0 && !loadError ? (
          <div class="mo-empty">
            <p class="mo-empty__title">{tenants.length === 0 ? 'Todavía no hay tenants' : 'Sin resultados'}</p>
            <p class="mo-empty__text">{tenants.length === 0 ? 'Creá el primero para operar.' : 'Probá otro filtro o búsqueda.'}</p>
            {tenants.length === 0 ? null : (
              <div class="mo-empty__actions">
                <a class="mo-btn mo-btn--ghost" href="/admin/tenants">Limpiar filtros</a>
              </div>
            )}
          </div>
        ) : (
          <div class="table-wrap">
            <table class="mo-table">
              <thead>
                <tr>
                  <th class="check">
                    <label class="check-hit">
                      <span class="sr-only">Seleccionar todos</span>
                      <input type="checkbox" id="check-all" />
                    </label>
                  </th>
                  <th>Tenant</th>
                  <th>Estado</th>
                  <th class="num">Módulos</th>
                  <th>Vto. abono</th>
                  <th class="num">USD/mes</th>
                  <th><span class="sr-only">Acciones</span></th>
                </tr>
              </thead>
              <tbody>
                {filtered.map((t) => (
                  <tr>
                    <td class="check">
                      <label class="check-hit">
                        <span class="sr-only">Seleccionar {t.name}</span>
                        <input
                          class="row-check"
                          id={`chk-${t.id}`}
                          type="checkbox"
                          value={String(t.id)}
                          data-state={t.state}
                          data-name={t.name}
                        />
                      </label>
                    </td>
                    <td>
                      <strong>{t.name}</strong>
                      <div class="slug"><span translate="no">{t.slug}</span> · <code translate="no">{t.db_name}</code></div>
                    </td>
                    <td>
                      <span class:list={['mo-badge', `is-${t.state}`]}>{t.state}</span>
                    </td>
                    <td class="num">{t.modules_installed_count}</td>
                    <td>{formatDue(t.abono_due_date)}</td>
                    <td class="num">{formatUsd(t.saldo_pendiente_usd)}</td>
                    <td>
                      <div class="mo-row-actions">
                        <a class="mo-btn mo-btn--ghost" href={`/tenant/${t.slug}/app`}>Abrir</a>
                        <div class="mo-overflow">
                          <button
                            type="button"
                            class="mo-btn mo-btn--icon"
                            data-overflow-toggle
                            aria-haspopup="menu"
                            aria-expanded="false"
                            aria-label={`Más acciones para ${t.name}`}
                          >
                            …
                          </button>
                          <div class="mo-overflow__menu" role="menu" hidden>
                            <button
                              type="button"
                              class="mo-overflow__item"
                              role="menuitem"
                              data-install-open
                              data-tenant-id={t.id}
                              data-db={t.db_name}
                            >
                              Instalar
                            </button>
                            {t.state !== 'suspendido' ? (
                              <button
                                type="button"
                                class="mo-overflow__item mo-overflow__item--danger"
                                role="menuitem"
                                data-state
                                data-tenant-id={t.id}
                                data-action="suspend"
                                data-name={t.name}
                              >
                                Suspender
                              </button>
                            ) : (
                              <button
                                type="button"
                                class="mo-overflow__item"
                                role="menuitem"
                                data-state
                                data-tenant-id={t.id}
                                data-action="reactivate"
                                data-name={t.name}
                              >
                                Reactivar
                              </button>
                            )}
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="mo-bulk" id="bulk-bar" hidden>
              <p class="mo-bulk__count" id="bulk-count">0 seleccionados</p>
              <div class="mo-bulk__actions">
                <button type="button" class="mo-btn mo-btn--ghost" id="bulk-clear">Limpiar selección</button>
                <button type="button" class="mo-btn mo-btn--danger" id="bulk-suspend">Suspender</button>
                <button type="button" class="mo-btn mo-btn--ghost" id="bulk-reactivate">Reactivar</button>
              </div>
            </div>
          </div>
        )}
        <script type="application/json" id="tenants-vista" is:inline set:html={vistaJson}></script>
      </section>
    </main>
  </div>

  <div class="mo-toast-region" id="toast-region" aria-relevant="additions"></div>

  <div class="mo-dialog-backdrop" id="confirm-backdrop" hidden>
    <div class="mo-dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-text">
      <h2 class="mo-dialog__title" id="confirm-title">Confirmar</h2>
      <p class="mo-dialog__text" id="confirm-text"></p>
      <div class="mo-dialog__actions">
        <button type="button" class="mo-btn mo-btn--ghost" id="confirm-cancel">Cancelar</button>
        <button type="button" class="mo-btn mo-btn--danger" id="confirm-ok">Confirmar</button>
      </div>
    </div>
  </div>

  <dialog id="install-dialog" class="mo-install-dialog">
    <form method="dialog" id="install-form">
      <h2 id="install-title" class="mo-dialog__title">Instalar módulos</h2>
      <p id="install-db" class="slug"></p>
      <div class="mo-dialog__grid" id="install-grid"></div>
      <div class="mo-field">
        <label class="mo-field__label" for="install-notes">Notas</label>
        <input class="mo-field__control" id="install-notes" name="notes" placeholder="ticket, motivo…" autocomplete="off" />
      </div>
      <div class="mo-dialog__actions">
        <label class="mo-field__label">
          Acción
          <select class="mo-field__control" name="action">
            <option value="install">Instalar</option>
            <option value="remove">Quitar</option>
          </select>
        </label>
        <button type="submit" class="mo-btn mo-btn--primary" id="install-submit">Aplicar módulos</button>
        <button type="button" class="mo-btn mo-btn--ghost" id="install-cancel">Cancelar</button>
      </div>
      <pre id="install-preview" class="mo-install-preview"></pre>
      <span id="install-msg" class="mo-field__hint"></span>
    </form>
  </dialog>

  <style>
    .shell { min-height: 100dvh; }
    .app-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      align-items: center;
      padding:
        max(0.85rem, env(safe-area-inset-top))
        max(1.35rem, env(safe-area-inset-right))
        0.85rem
        max(1.35rem, env(safe-area-inset-left));
      max-width: 72rem;
      border-bottom: 1px solid var(--mo-line);
    }
    .app-bar__title {
      margin: 0;
      font-family: var(--mo-font);
      font-size: 1.1rem;
      font-weight: 650;
      letter-spacing: -0.02em;
      line-height: 1.2;
      text-wrap: balance;
    }
    .app-bar__meta {
      margin: 0.1rem 0 0;
      font-size: 0.85rem;
      color: var(--mo-muted);
    }
    .app-bar__nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.15rem 0.35rem;
      align-items: center;
    }
    .app-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 0.35rem;
      border: 0;
      background: transparent;
      color: var(--mo-muted);
      font: inherit;
      text-decoration: underline;
      text-decoration-color: var(--mo-line-strong);
      text-underline-offset: 0.22em;
      font-size: 0.92rem;
      font-weight: 500;
      cursor: pointer;
      touch-action: manipulation;
      transition: color 140ms var(--mo-ease-out);
    }
    @media (hover: hover) and (pointer: fine) {
      .app-link:hover {
        color: var(--mo-ink);
      }
    }
    .app-link--session {
      margin-left: 0.35rem;
      padding-left: 0.85rem;
      border-left: 1px solid var(--mo-line);
    }
    #btn-nuevo { margin-left: auto; }
    .filters .mo-pill {
      min-height: 44px;
      padding-inline: 0.85rem;
    }
    .filters .mo-pill[aria-current="true"] {
      font-weight: 650;
      box-shadow: inset 0 0 0 1px currentColor;
    }
    .filters .mo-pill[aria-current="true"]:not(.mo-pill--ok):not(.mo-pill--warn):not(.mo-pill--danger) {
      background: var(--mo-canvas);
      color: var(--mo-ink);
      border-color: var(--mo-ink);
    }
    .filters .mo-pill--ok[aria-current="true"] {
      background: var(--mo-ok-soft);
      border-color: var(--mo-ok);
      color: var(--mo-ok);
    }
    .filters .mo-pill--warn[aria-current="true"] {
      background: color-mix(in srgb, var(--mo-warn) 14%, var(--mo-canvas));
      border-color: var(--mo-warn);
      color: var(--mo-warn);
    }
    .filters .mo-pill--danger[aria-current="true"] {
      background: color-mix(in srgb, var(--mo-danger) 12%, var(--mo-canvas));
      border-color: var(--mo-danger);
      color: var(--mo-danger);
    }
    .tools {
      display: grid;
      gap: 0.65rem;
      padding: 0.85rem 1.35rem 0.45rem;
      max-width: 72rem;
    }
    .tools__view {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      align-items: center;
    }
    .search {
      display: flex; align-items: center;
      flex: 1 1 14rem; max-width: 20rem;
      border: 1px solid var(--mo-line); border-radius: var(--mo-radius-sm);
      background: var(--mo-canvas); padding: 0 0.7rem; min-height: 44px;
    }
    .search:focus-within {
      outline: 2px solid var(--mo-focus);
      outline-offset: 2px;
    }
    .search label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .search input {
      border: 0; background: transparent; width: 100%;
      font: inherit; color: var(--mo-ink); min-height: 42px; font-size: 16px;
    }
    .search input:focus-visible {
      outline: none;
    }
    .content { padding: 0 1.35rem 2rem; display: grid; gap: 1rem; max-width: 72rem; }
    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      padding-top: 0.65rem;
    }
    .check input {
      width: 1.5rem;
      height: 1.5rem;
      accent-color: var(--mo-accent);
      cursor: pointer;
      touch-action: manipulation;
    }
    .check-hit {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
      cursor: pointer;
    }
    .mo-table tbody tr {
      content-visibility: auto;
      contain-intrinsic-size: auto 3.25rem;
    }
    .slug { color: var(--mo-muted); font-size: 0.78rem; }
    .table-wrap {
      overflow: auto;
      scroll-padding-top: 3rem;
      scroll-padding-bottom: 4.5rem;
    }
    .create-panel {
      border: 0;
      border-left: 3px solid var(--mo-accent);
      border-radius: var(--mo-radius);
      background: var(--mo-card);
      padding: 1rem 1.1rem;
      display: grid;
      gap: 0.75rem;
      max-width: 32rem;
      transform-origin: top left;
      opacity: 0;
      transform: scale(0.97);
      transition: opacity 200ms var(--mo-ease-out), transform 200ms var(--mo-ease-out);
    }
    .create-panel.is-in { opacity: 1; transform: scale(1); }
    .create-panel.is-out { opacity: 0; transform: scale(0.97); transition-duration: 120ms; }
    .create-panel[hidden] { display: none; }
    .create-grid { display: grid; gap: 0.75rem; }
    .create-panel__actions { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .mo-install-dialog {
      border: 1px solid var(--mo-line);
      border-radius: var(--mo-radius);
      padding: 1.2rem;
      background: var(--mo-canvas);
      color: var(--mo-ink);
      max-width: 36rem;
      width: 90%;
      transform-origin: center;
      overscroll-behavior: contain;
      opacity: 0;
      transform: scale(0.95);
      transition:
        opacity 200ms var(--mo-ease-out),
        transform 200ms var(--mo-ease-out),
        overlay 200ms var(--mo-ease-out) allow-discrete,
        display 200ms var(--mo-ease-out) allow-discrete;
    }
    .mo-install-dialog[open] {
      opacity: 1;
      transform: scale(1);
    }
    @starting-style {
      .mo-install-dialog[open] {
        opacity: 0;
        transform: scale(0.95);
      }
    }
    .mo-install-dialog::backdrop {
      background: color-mix(in srgb, var(--mo-ink) 45%, transparent);
      opacity: 0;
      transition:
        opacity 200ms var(--mo-ease-out),
        overlay 200ms var(--mo-ease-out) allow-discrete,
        display 200ms var(--mo-ease-out) allow-discrete;
    }
    .mo-install-dialog[open]::backdrop {
      opacity: 1;
    }
    @starting-style {
      .mo-install-dialog[open]::backdrop {
        opacity: 0;
      }
    }
    .mo-dialog__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; margin: 0.5rem 0; }
    .mo-install-preview {
      background: var(--mo-field);
      border: 1px solid var(--mo-line);
      border-radius: var(--mo-radius-sm);
      padding: 0.6rem;
      font-size: 0.75rem;
      overflow: auto;
      white-space: pre-wrap;
      margin: 0.5rem 0;
    }
    @media (prefers-reduced-motion: reduce) {
      .create-panel { transition-duration: 0.01ms !important; }
      .create-panel.is-in { opacity: 1; transform: none; }
      .mo-install-dialog,
      .mo-install-dialog[open],
      .mo-install-dialog::backdrop,
      .mo-install-dialog[open]::backdrop {
        transition-duration: 0.01ms !important;
        transform: none;
      }
    }
  </style>

  <script>
    import { CATALOGO_LABELS } from '../../lib/catalogo.generated.ts';
    import {
      resolveLeaveMs,
      openWithEnter,
      closeWithLeave,
      showToast as mountToast,
      setFadedVisible,
      trapTabKey,
    } from '../../scripts/light-app-chrome.ts';
    import {
      bulkReactivateIds,
      bulkSuspendIds,
      selectionCountLabel,
      sessionCloseCopy,
      tenantsCsv,
      type TenantVista,
    } from '../../lib/control-plane-vista.ts';

    const CATALOGO = Object.entries(CATALOGO_LABELS) as unknown as readonly (readonly [string, string])[];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const LEAVE_MS = resolveLeaveMs(reduceMotion, 120);
    const toastRegion = document.getElementById('toast-region');
    const live = document.getElementById('live-polite');
    const panelNuevo = document.getElementById('panel-nuevo');
    const btnNuevo = document.getElementById('btn-nuevo');
    const backdrop = document.getElementById('confirm-backdrop');
    const confirmTitle = document.getElementById('confirm-title');
    const confirmText = document.getElementById('confirm-text');
    const confirmOk = document.getElementById('confirm-ok');
    const confirmCancel = document.getElementById('confirm-cancel');
    let pendingAction: null | (() => void) = null;
    let lastFocus: HTMLElement | null = null;

    function announce(msg: string) {
      if (!live) return;
      live.textContent = '';
      requestAnimationFrame(() => {
        live.textContent = msg;
      });
    }

    function showToast(title: string, text: string, kind: 'ok' | 'danger' = 'ok') {
      if (!toastRegion) return;
      mountToast({ region: toastRegion, title, text, kind, leaveMs: LEAVE_MS, announce });
    }

    let createDirty = false;

    function setNuevoInUrl(on: boolean) {
      const url = new URL(window.location.href);
      if (on) url.searchParams.set('nuevo', '1');
      else url.searchParams.delete('nuevo');
      history.replaceState(null, '', `${url.pathname}${url.search}`);
    }

    function openNuevo() {
      if (!panelNuevo || !btnNuevo) return;
      openWithEnter(panelNuevo, { inClass: 'is-in' });
      btnNuevo.setAttribute('aria-expanded', 'true');
      setNuevoInUrl(true);
      document.getElementById('tenant-nombre')?.focus();
    }

    function closeNuevo() {
      if (!panelNuevo || !btnNuevo) return;
      createDirty = false;
      closeWithLeave(panelNuevo, {
        leaveMs: LEAVE_MS,
        inClass: 'is-in',
        leavingClass: 'is-out',
        onDone: () => {
          btnNuevo.setAttribute('aria-expanded', 'false');
          (document.getElementById('create-tenant-form') as HTMLFormElement | null)?.reset();
          setNuevoInUrl(false);
          btnNuevo.focus();
        },
      });
    }

    btnNuevo?.addEventListener('click', () => {
      if (panelNuevo?.hidden) openNuevo();
      else closeNuevo();
    });
    document.getElementById('btn-cancelar-nuevo')?.addEventListener('click', closeNuevo);

    const form = document.getElementById('create-tenant-form') as HTMLFormElement | null;
    const msg = document.getElementById('create-msg');
    const btnCrear = document.getElementById('btn-crear') as HTMLButtonElement | null;
    form?.addEventListener('input', () => {
      createDirty = true;
    });
    window.addEventListener('beforeunload', (ev) => {
      if (!createDirty || panelNuevo?.hidden) return;
      ev.preventDefault();
      ev.returnValue = '';
    });
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form) return;
      if (btnCrear) btnCrear.disabled = true;
      if (msg) msg.textContent = 'Creando…';
      const fd = new FormData(form);
      const body = {
        name: String(fd.get('name') || ''),
        slug: String(fd.get('slug') || '') || undefined,
        vertical: String(fd.get('vertical') || 'retail'),
      };
      let failed = true;
      try {
        const res = await fetch('/api/admin/tenants', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          if (msg) {
            msg.textContent =
              (data as { error?: { message?: string } })?.error?.message ||
              'No se pudo crear. Revisá los datos e intentá de nuevo.';
          }
          return;
        }
        failed = false;
        createDirty = false;
        closeNuevo();
        showToast('Tenant creado', `${body.name} quedó listo.`, 'ok');
        setTimeout(() => window.location.reload(), 600);
      } catch {
        if (msg) msg.textContent = 'No se pudo crear. Revisá los datos e intentá de nuevo.';
      } finally {
        if (failed && btnCrear) btnCrear.disabled = false;
      }
    });

    document.querySelector('[data-logout]')?.addEventListener('click', () => {
      const copy = sessionCloseCopy('control-plane');
      openConfirm({
        title: copy.title,
        text: copy.text,
        okLabel: copy.okLabel,
        cancelLabel: copy.cancelLabel,
        danger: false,
        onConfirm: async () => {
          showToast('Sesión cerrada', copy.text, 'ok');
          await fetch('/api/auth/logout', { method: 'POST' });
          window.setTimeout(() => window.location.assign('/login'), 400);
        },
      });
    });

    function openConfirm(opts: { title: string; text: string; okLabel: string; cancelLabel?: string; danger: boolean; onConfirm: () => void }) {
      if (!backdrop || !confirmTitle || !confirmText || !confirmOk || !confirmCancel) return;
      lastFocus = document.activeElement as HTMLElement | null;
      pendingAction = opts.onConfirm;
      confirmTitle.textContent = opts.title;
      confirmText.textContent = opts.text;
      confirmOk.textContent = opts.okLabel;
      confirmCancel.textContent = opts.cancelLabel || 'Cancelar';
      confirmOk.className = opts.danger ? 'mo-btn mo-btn--danger' : 'mo-btn mo-btn--primary';
      openWithEnter(backdrop);
      confirmOk.focus();
    }

    function closeConfirm() {
      if (!backdrop) return;
      closeWithLeave(backdrop, {
        leaveMs: LEAVE_MS,
        onDone: () => {
          pendingAction = null;
          lastFocus?.focus?.();
        },
      });
    }

    confirmCancel?.addEventListener('click', closeConfirm);
    confirmOk?.addEventListener('click', () => {
      const fn = pendingAction;
      closeConfirm();
      if (typeof fn === 'function') fn();
    });
    backdrop?.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape') {
        ev.preventDefault();
        closeConfirm();
        return;
      }
      trapTabKey(backdrop, ev);
    });
    backdrop?.addEventListener('click', (ev) => {
      if (ev.target === backdrop) closeConfirm();
    });

    document.querySelectorAll('[data-state]').forEach((btn) => {
      btn.addEventListener('click', () => {
        closeAllOverflow();
        const el = btn as HTMLElement;
        const id = Number(el.dataset.tenantId);
        const action = String(el.dataset.action || '');
        const name = String(el.dataset.name || `#${id}`);
        const danger = action === 'suspend';
        openConfirm({
          title: danger ? `¿Suspender a ${name}?` : `¿Reactivar a ${name}?`,
          text: danger
            ? 'El comercio deja de operar hasta que lo reactives.'
            : 'Vuelve a estado activo y puede operar de inmediato.',
          okLabel: danger ? 'Suspender' : 'Reactivar',
          danger,
          onConfirm: async () => {
            el.setAttribute('disabled', '');
            try {
              const res = await fetch('/api/admin/tenants/state', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ id, action }),
              });
              const data = (await res.json().catch(() => ({}))) as { error?: { message?: string } };
              if (!res.ok) {
                showToast('No se pudo completar', data?.error?.message || 'No se pudo cambiar el estado. Intentá de nuevo.', 'danger');
                return;
              }
              showToast(danger ? 'Tenant suspendido' : 'Tenant reactivado', name, danger ? 'danger' : 'ok');
              setTimeout(() => window.location.reload(), 500);
            } finally {
              el.removeAttribute('disabled');
            }
          },
        });
      });
    });

    function closeAllOverflow(except?: Element) {
      document.querySelectorAll('.mo-overflow__menu').forEach((menu) => {
        if (except && menu === except) return;
        if (menu.hasAttribute('hidden') && !menu.classList.contains('is-in')) return;
        const toggle = menu.parentElement?.querySelector('[data-overflow-toggle]');
        closeWithLeave(menu as HTMLElement, {
          leaveMs: LEAVE_MS,
          inClass: 'is-in',
          leavingClass: 'is-out',
          onDone: () => toggle?.setAttribute('aria-expanded', 'false'),
        });
      });
    }

    document.addEventListener('click', (ev) => {
      const raw = ev.target;
      const target = raw instanceof Element ? raw : raw instanceof Node ? raw.parentElement : null;
      if (!target) return;
      const toggle = target.closest('[data-overflow-toggle]');
      if (toggle) {
        const wrap = toggle.closest('.mo-overflow');
        const menu = wrap?.querySelector('.mo-overflow__menu');
        const open = menu instanceof HTMLElement && menu.hidden;
        closeAllOverflow(open ? menu : undefined);
        if (menu instanceof HTMLElement) {
            if (open) {
              openWithEnter(menu, { inClass: 'is-in' });
              toggle.setAttribute('aria-expanded', 'true');
              menu.querySelector<HTMLElement>('[role="menuitem"]')?.focus();
            } else {
            closeWithLeave(menu, {
              leaveMs: LEAVE_MS,
              inClass: 'is-in',
              leavingClass: 'is-out',
              onDone: () => toggle.setAttribute('aria-expanded', 'false'),
            });
          }
        }
        return;
      }
      if (!target.closest('.mo-overflow')) closeAllOverflow();
    });

    function menuItems(menu: HTMLElement) {
      return [...menu.querySelectorAll<HTMLButtonElement>('[role="menuitem"]')];
    }

    document.addEventListener('keydown', (ev) => {
      const openMenu = document.querySelector<HTMLElement>('.mo-overflow__menu.is-in:not([hidden])');
      if (!openMenu) return;
      const toggle = openMenu.parentElement?.querySelector<HTMLElement>('[data-overflow-toggle]');
      const inMenu = openMenu.contains(document.activeElement);
      if (ev.key === 'Escape') {
        ev.preventDefault();
        closeAllOverflow();
        toggle?.focus();
        return;
      }
      if (!inMenu) return;
      const items = menuItems(openMenu);
      const current = items.indexOf(document.activeElement as HTMLButtonElement);
      if (!items.length) return;
      if (ev.key === 'ArrowDown') {
        ev.preventDefault();
        items[(current + 1 + items.length) % items.length]?.focus();
      } else if (ev.key === 'ArrowUp') {
        ev.preventDefault();
        items[(current - 1 + items.length) % items.length]?.focus();
      } else if (ev.key === 'Home') {
        ev.preventDefault();
        items[0]?.focus();
      } else if (ev.key === 'End') {
        ev.preventDefault();
        items[items.length - 1]?.focus();
      }
    });

    const vistaEl = document.getElementById('tenants-vista');
    document.getElementById('btn-export')?.addEventListener('click', () => {
      let rows: TenantVista[] = [];
      try {
        rows = JSON.parse(vistaEl?.textContent || '[]') as TenantVista[];
      } catch {
        rows = [];
      }
      const csv = tenantsCsv(rows);
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'tenants.csv';
      a.click();
      URL.revokeObjectURL(url);
      showToast('Export listo', 'El CSV tiene los filtros de esta vista.', 'ok');
    });

    const bulkBar = document.getElementById('bulk-bar');
    const bulkCount = document.getElementById('bulk-count');
    const checkAll = document.getElementById('check-all') as HTMLInputElement | null;

    function selectedRows(): HTMLInputElement[] {
      return [...document.querySelectorAll<HTMLInputElement>('.row-check:checked')];
    }

    function syncBulk() {
      const rows = selectedRows();
      if (bulkBar) setFadedVisible(bulkBar, rows.length > 0, LEAVE_MS);
      if (bulkCount) bulkCount.textContent = selectionCountLabel(rows.length);
      const all = document.querySelectorAll<HTMLInputElement>('.row-check');
      if (checkAll) {
        checkAll.checked = all.length > 0 && rows.length === all.length;
        checkAll.indeterminate = rows.length > 0 && rows.length < all.length;
      }
    }

    async function postState(id: number, action: 'suspend' | 'reactivate') {
      const res = await fetch('/api/admin/tenants/state', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id, action }),
      });
      if (!res.ok) {
        const data = (await res.json().catch(() => ({}))) as { error?: { message?: string } };
        throw new Error(data?.error?.message || 'No se pudo cambiar el estado. Intentá de nuevo.');
      }
    }

    checkAll?.addEventListener('change', () => {
      document.querySelectorAll<HTMLInputElement>('.row-check').forEach((box) => {
        box.checked = Boolean(checkAll.checked);
      });
      syncBulk();
    });
    document.querySelectorAll('.row-check').forEach((box) => {
      box.addEventListener('change', syncBulk);
    });
    document.getElementById('bulk-clear')?.addEventListener('click', () => {
      document.querySelectorAll<HTMLInputElement>('.row-check').forEach((box) => {
        box.checked = false;
      });
      if (checkAll) {
        checkAll.checked = false;
        checkAll.indeterminate = false;
      }
      syncBulk();
    });

    function runBulk(action: 'suspend' | 'reactivate') {
      const picked = selectedRows().map((box) => ({
        id: Number(box.value),
        state: String(box.dataset.state || ''),
      }));
      const ids = action === 'suspend' ? bulkSuspendIds(picked) : bulkReactivateIds(picked);
      if (ids.length === 0) {
        showToast(
          action === 'suspend' ? 'Nada para suspender' : 'Nada para reactivar',
          action === 'suspend'
            ? 'Los seleccionados ya están suspendidos.'
            : 'Seleccioná tenants suspendidos.',
          'danger',
        );
        return;
      }
      const danger = action === 'suspend';
      openConfirm({
        title: danger ? `¿Suspender ${ids.length} tenant${ids.length === 1 ? '' : 's'}?` : `¿Reactivar ${ids.length} tenant${ids.length === 1 ? '' : 's'}?`,
        text: danger
          ? 'Esos comercios dejan de operar hasta que los reactives.'
          : 'Vuelven a estado activo y pueden operar de inmediato.',
        okLabel: danger ? 'Suspender selección' : 'Reactivar selección',
        danger,
        onConfirm: async () => {
          try {
            for (const id of ids) await postState(id, action);
            showToast(
              danger ? 'Suspensión masiva' : 'Reactivación masiva',
              `${ids.length} tenant${ids.length === 1 ? '' : 's'}.`,
              danger ? 'danger' : 'ok',
            );
            window.setTimeout(() => window.location.reload(), 500);
          } catch (err) {
            showToast('No se pudo completar', (err as Error).message || 'No se pudo completar la selección. Intentá de nuevo.', 'danger');
          }
        },
      });
    }

    document.getElementById('bulk-suspend')?.addEventListener('click', () => runBulk('suspend'));
    document.getElementById('bulk-reactivate')?.addEventListener('click', () => runBulk('reactivate'));

    const dlg = document.getElementById('install-dialog') as HTMLDialogElement | null;
    const grid = document.getElementById('install-grid') as HTMLDivElement | null;
    const titleEl = document.getElementById('install-title');
    const dbEl = document.getElementById('install-db');
    const previewEl = document.getElementById('install-preview');
    const msgEl = document.getElementById('install-msg');
    const installForm = document.getElementById('install-form') as HTMLFormElement | null;
    let activeTenantId: number | null = null;
    let activeDb = '';

    function renderGrid() {
      if (!grid) return;
      grid.innerHTML = '';
      for (const [key, label] of CATALOGO) {
        const lbl = document.createElement('label');
        lbl.className = 'mo-check';
        lbl.innerHTML = `<input type="checkbox" value="${key}" data-mod /> ${label} <code>${key}</code>`;
        grid.appendChild(lbl);
      }
    }
    renderGrid();

    function updatePreview() {
      if (!grid || !previewEl || !installForm) return;
      const mods = [...grid.querySelectorAll<HTMLInputElement>('[data-mod]:checked')].map((i) => i.value);
      const action = (installForm.querySelector('select[name="action"]') as HTMLSelectElement)?.value || 'install';
      const flag = action === 'install' ? '-i' : '-u';
      previewEl.textContent = mods.length
        ? `odoo-bin -d ${activeDb} ${flag} ${mods.join(', ')}  # batch ${mods.length}`
        : '— seleccioná módulos —';
    }
    grid?.addEventListener('change', updatePreview);
    installForm?.querySelector('select[name="action"]')?.addEventListener('change', updatePreview);

    document.querySelectorAll('[data-install-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        closeAllOverflow();
        activeTenantId = Number((btn as HTMLElement).dataset.tenantId);
        activeDb = (btn as HTMLElement).dataset.db || 'modoops_<slug>';
        if (titleEl) titleEl.textContent = `Instalar en #${activeTenantId}`;
        if (dbEl) dbEl.textContent = activeDb;
        if (msgEl) msgEl.textContent = '';
        if (previewEl) previewEl.textContent = '— seleccioná módulos —';
        grid?.querySelectorAll<HTMLInputElement>('[data-mod]').forEach((i) => (i.checked = false));
        dlg?.showModal();
      });
    });
    document.getElementById('install-cancel')?.addEventListener('click', () => dlg?.close());

    installForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!activeTenantId || !grid || !msgEl || !previewEl) return;
      const mods = [...grid.querySelectorAll<HTMLInputElement>('[data-mod]:checked')].map((i) => i.value);
      if (!mods.length) {
        msgEl.textContent = 'Seleccioná al menos un módulo';
        return;
      }
      const fd = new FormData(installForm);
      const action = String(fd.get('action') || 'install');
      const notes = String(fd.get('notes') || '');
      msgEl.textContent = 'Ejecutando…';
      const submitInstall = document.getElementById('install-submit') as HTMLButtonElement | null;
      if (submitInstall) submitInstall.disabled = true;
      let failed = true;
      try {
        const res = await fetch(`/api/admin/tenants/${activeTenantId}/install`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ modules: mods, action, notes }),
        });
        const data = (await res.json().catch(() => ({}))) as {
          preview_command?: string;
          error?: { message?: string };
        };
        if (!res.ok) {
          msgEl.textContent = data?.error?.message || 'No se pudo aplicar. Revisá los módulos e intentá de nuevo.';
          return;
        }
        failed = false;
        previewEl.textContent = data.preview_command || previewEl.textContent;
        msgEl.textContent = 'OK — recargando…';
        showToast('Instalación en curso', activeDb, 'ok');
        setTimeout(() => window.location.reload(), 700);
      } catch {
        msgEl.textContent = 'No se pudo aplicar. Revisá los módulos e intentá de nuevo.';
      } finally {
        if (failed && submitInstall) submitInstall.disabled = false;
      }
    });
  </script>
</LightAppLayout>
