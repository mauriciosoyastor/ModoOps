---
// Ruta REAL del chat configurador (spec 0011, slices 02+03): guion T1 desde el
// seam (sin duplicar datos), split chat/3D bidireccional, borrador vivo,
// WhatsApp con mensaje legible + copiar JSON, envío al consultor, auto-confirm.
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  GUION_CHAT,
  OBJETO_LABEL,
  SIEMPRE_INCLUIDOS,
  labelDe,
  type Objeto3DId,
} from '../lib/oficina-mapping';

const objetos: Objeto3DId[] = [
  'mostrador-3d',
  'estanteria-3d',
  'gondola-3d',
  'computadora-3d',
  'pizarron-fiscal-3d',
  'puerta-crecer-3d',
];
const preguntaDeObjeto = Object.fromEntries(GUION_CHAT.map((g) => [g.objeto, g.id]));
---

<BaseLayout
  title="Chat — armá tu borrador mirando tu oficina | ModoOps"
  description="Respondé 10 preguntas en criollo, mirá cómo se arma tu oficina y enviá tu borrador no vinculante por WhatsApp."
>
  <main class="mx-auto w-full max-w-6xl px-4 py-8 md:px-8" data-chat>
    <p class="rounded-full border border-dashed px-3 py-1 text-xs text-zinc-400">
      Borrador no vinculante · lo valida el consultor en el Descubrimiento · nada de acá crea tu sistema
    </p>
    <h1 class="mt-2 text-3xl font-semibold">Contanos tu negocio, mirá tu oficina</h1>
    <p class="mt-1 text-sm text-zinc-400" data-progreso aria-live="polite">Paso 1 de 7 · Tu negocio</p>

    <div class="mt-4 grid gap-4" data-layout-wrap>
      <section aria-label="Chat configurador">
        <div class="grid gap-3" data-hilo aria-live="polite"></div>

        <form data-negocio class="mt-3 rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-sm" id="preg-negocio">
          <h2 class="font-semibold">Tu negocio</h2>
          <div class="mt-2 grid gap-2">
            <label>Nombre del negocio *
              <input data-prospecto="nombre" required autocomplete="organization" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" placeholder="Ej: Pinturería Centro" /></label>
            <div class="grid gap-2 md:grid-cols-2">
              <label>Tu nombre
                <input data-prospecto="contacto_nombre" autocomplete="name" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" placeholder="Ej: Ana" /></label>
              <label>Teléfono *
                <input data-prospecto="telefono" type="tel" autocomplete="tel" inputmode="tel" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" placeholder="Ej: 3547 000000" /></label>
            </div>
            <div class="grid gap-2 md:grid-cols-2">
              <label>Email
                <input data-prospecto="email" type="email" autocomplete="email" inputmode="email" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" placeholder="Ej: ana@negocio.com" /></label>
              <label>Rubro
                <select data-prospecto="rubro" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500">
                  <option value="retail">Retail mostrador</option>
                  <option value="distribucion">Distribución chica</option>
                  <option value="servicios">Servicios</option>
                </select></label>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <label>Sucursales <input data-prospecto="sucursales" type="number" min="1" value="1" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
              <label>Cajas <input data-prospecto="cajas" type="number" min="1" value="2" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
              <label>Usuarios <input data-prospecto="usuarios" type="number" min="1" value="5" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
            </div>
            <div class="grid gap-2 md:grid-cols-2">
              <label>Productos aprox. <input data-dato="productos_aprox" type="number" min="0" value="0" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
              <label class="flex items-center gap-2">¿Llevás stock en Excel hoy?
                <input data-dato="tiene_excel" type="checkbox" class="h-4 w-4" /></label>
            </div>
          </div>
        </form>

        {GUION_CHAT.map((g) => (
          <div class="mt-3 rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-sm" data-card={g.id}>
            <h2 class="font-semibold">{g.bloque} — {labelDe(g.keys[0])}</h2>
            <p class="mt-1">{g.texto}</p>
            <div class="mt-2 flex flex-wrap gap-1">
              <button type="button" data-si={g.id} aria-pressed="false" class="rounded-full border border-white/10 px-3 py-1">Sí</button>
              <button type="button" data-no={g.id} class="rounded-full border border-white/10 px-3 py-1">No / saltear</button>
            </div>
            {g.id === 'mostrador' && (
              <div class="mt-2 grid grid-cols-2 gap-2" data-extra={g.id} hidden>
                <label>Cajas <input data-p="mostrador" data-c="cajas" type="number" min="1" value="2" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
                <label class="flex items-center gap-2">¿Descuento? <input data-p="mostrador" data-c="descuento" type="checkbox" class="h-4 w-4" /></label>
              </div>
            )}
            {g.id === 'deposito' && (
              <div class="mt-2 grid grid-cols-2 gap-2" data-extra={g.id} hidden>
                <label>Almacenes <input data-p="deposito" data-c="almacenes" type="number" min="1" value="1" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
                <label class="flex items-center gap-2">¿Ubicaciones? <input data-p="deposito" data-c="ubicaciones" type="checkbox" class="h-4 w-4" /></label>
              </div>
            )}
            {g.id === 'ventas' && (
              <div class="mt-2" data-extra={g.id} hidden>
                <label>Listas de precio <input data-p="ventas" data-c="listas" type="number" min="1" value="1" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
              </div>
            )}
            {g.id === 'compras' && (
              <div class="mt-2 grid grid-cols-2 gap-2" data-extra={g.id} hidden>
                <label>Proveedores <input data-p="compras" data-c="proveedores" type="number" min="0" value="0" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
                <label class="flex items-center gap-2">¿Orden de compra? <input data-p="compras" data-c="oc" type="checkbox" class="h-4 w-4" /></label>
              </div>
            )}
            {g.id === 'fiscal' && (
              <div class="mt-2" data-extra={g.id} hidden>
                <fieldset class="rounded border border-white/10 p-2">
                  <legend class="px-1 text-xs text-zinc-400">Tildá lo que creas que usás</legend>
                  {g.multi?.map((op) => (
                    <label class="mr-3 inline-flex items-center gap-1"><input data-p="fiscal" data-c="comprobantes" value={op} type="checkbox" class="h-4 w-4" />{op}</label>
                  ))}
                </fieldset>
                <label class="mt-2 block">Tu contador <input data-p="fiscal" data-c="contador" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" placeholder="Ej: Estudio López" /></label>
              </div>
            )}
            {g.id === 'crecer' && (
              <div class="mt-2" data-extra={g.id} hidden>
                <fieldset class="rounded border border-white/10 p-2">
                  <legend class="px-1 text-xs text-zinc-400">Tildá todo lo que te sirva</legend>
                  {g.keys.map((k) => (
                    <label class="mr-3 inline-flex items-center gap-1"><input data-p="crecer" data-c="futuros" value={k} type="checkbox" class="h-4 w-4" />{labelDe(k)}</label>
                  ))}
                </fieldset>
              </div>
            )}
          </div>
        ))}

        <ul class="mt-2 text-sm text-red-700" data-errores aria-live="assertive"></ul>

        <details class="mt-3 rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-sm">
          <summary class="cursor-pointer font-semibold">Borrador vivo (lo que ya tildaste)</summary>
          <ul class="mt-2 flex flex-wrap gap-1" data-chips></ul>
          <pre class="mt-2 overflow-auto text-xs" data-json>{}</pre>
        </details>

        <div class="mt-3 grid gap-2">
          <button data-copiar class="rounded-full border px-4 py-2 text-sm font-semibold">Copiar JSON del borrador</button>
          <a data-whatsapp target="_blank" rel="noopener" class="rounded-full border border-green-600 px-4 py-2 text-center text-sm font-semibold text-green-700">Enviar por WhatsApp</a>
          <button data-enviar class="rounded-full border px-4 py-2 text-sm font-semibold">Enviar al consultor</button>
          <p class="text-sm text-green-700" data-enviado role="status" hidden></p>
          <p class="text-xs text-zinc-400" data-copiado hidden>JSON copiado: pegalo en el chat de WhatsApp junto al mensaje.</p>
        </div>
        <p class="mt-2 text-xs text-zinc-400">Siempre incluidos, sin pedirlos: {SIEMPRE_INCLUIDOS.map(labelDe).join(' · ')}</p>
      </section>

      <section aria-label="Oficina en vivo">
        <div class="md:sticky md:top-4">
          <canvas
            data-canvas
            class="block w-full rounded-xl"
            style="aspect-ratio: 16/10;"
            aria-label="Tu oficina armándose: tocá un mueble para volver a su pregunta"
          ></canvas>
          <p class="px-1 py-1 text-xs text-zinc-400" data-estado aria-live="polite">Activando escena…</p>
          <div data-fallback hidden class="rounded-xl border border-white/10 bg-white/[0.04] p-3">
            <p class="text-sm font-semibold">Sectores (sin 3D)</p>
            <div class="mt-2 flex flex-wrap gap-1">
              {objetos.map((id) => (
                <button data-fb={id} class="rounded-full border border-white/10 bg-white/[0.06] px-2 py-1 text-xs">{OBJETO_LABEL[id]}</button>
              ))}
            </div>
          </div>
          <details class="mt-2 rounded-xl border border-white/10 bg-white/[0.04] p-3">
            <summary class="cursor-pointer text-sm font-semibold">Elegir sector sin 3D (teclado)</summary>
            <div class="mt-2 flex flex-wrap gap-1">
              {objetos.map((id) => (
                <button data-fb={id} class="rounded-full border border-white/10 bg-white/[0.06] px-2 py-1 text-xs">{OBJETO_LABEL[id]}</button>
              ))}
            </div>
          </details>
          <ul class="mt-2 flex flex-wrap gap-1 text-xs" data-construidos aria-label="Objetos construidos"></ul>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .flash { outline: 2px solid #f5c518; outline-offset: 2px; }
  .hecho { border-color: #2b7a4b; }
</style>

<script>
  import {
    GUION_CHAT,
    OBJETO_A_MODULO,
    SIEMPRE_INCLUIDOS,
    construirBorrador,
    guardarBorrador,
    cargarBorrador,
    validarBorrador,
    mensajeWhatsApp,
    enlaceWhatsApp,
  } from '../lib/oficina-mapping';

  const objetoAPregunta = Object.fromEntries(GUION_CHAT.map((g) => [g.objeto, g.id]));
  const preguntaAObjeto = Object.fromEntries(GUION_CHAT.map((g) => [g.id, g.objeto]));

  const root = document.querySelector('[data-chat]');
  if (root instanceof HTMLElement) {
    const params = new URLSearchParams(location.search);
    const layout = params.get('layout') === 'stack' ? 'stack' : 'split';
    const wrap = root.querySelector('[data-layout-wrap]');
    if (wrap instanceof HTMLElement) {
      wrap.classList.add('md:grid-cols-[1fr_1fr]');
      if (layout === 'stack') wrap.classList.remove('md:grid-cols-[1fr_1fr]');
    }

    const reduc = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const si = new Set();
    const num = (sel) => {
      const el = root.querySelector(sel);
      const v = el instanceof HTMLInputElement ? Number(el.value) : NaN;
      return Number.isFinite(v) ? v : 0;
    };
    const bool = (sel) => {
      const el = root.querySelector(sel);
      return el instanceof HTMLInputElement ? el.checked : false;
    };
    const texto = (sel) => {
      const el = root.querySelector(sel);
      return el instanceof HTMLInputElement ? el.value : '';
    };

    const hilo = root.querySelector('[data-hilo]');
    const progreso = root.querySelector('[data-progreso]');
    const chips = root.querySelector('[data-chips]');
    const json = root.querySelector('[data-json]');
    const listaErrores = root.querySelector('[data-errores]');
    const construidos = root.querySelector('[data-construidos]');
    const linkWa = root.querySelector('[data-whatsapp]');
    const btnCopiar = root.querySelector('[data-copiar]');
    const btnEnviar = root.querySelector('[data-enviar]');
    const avisoEnviado = root.querySelector('[data-enviado]');
    const avisoCopiado = root.querySelector('[data-copiado]');
    const canvas = root.querySelector('[data-canvas]');
    const est = root.querySelector('[data-estado]');
    const fb = root.querySelector('[data-fallback]');
    let escena = null;
    let borradorActual = null;

    function decir(textoMsg) {
      if (!(hilo instanceof HTMLElement)) return;
      const p = document.createElement('p');
      p.className = 'rounded-xl border border-white/10 bg-white/[0.04] p-2 text-sm';
      p.textContent = textoMsg;
      hilo.appendChild(p);
    }

    function irAPregunta(id) {
      const card = root.querySelector(`[data-card="${id}"]`);
      if (card instanceof HTMLElement) {
        card.scrollIntoView({ behavior: reduc ? 'auto' : 'smooth', block: 'center' });
        card.classList.add('flash');
        setTimeout(() => card.classList.remove('flash'), 1600);
        const btn = card.querySelector('[data-si]');
        if (btn instanceof HTMLElement) btn.focus({ preventScroll: true });
      }
    }

    function leeEstado() {
      const tildados = [];
      for (const id of si) {
        const g = GUION_CHAT.find((x) => x.id === id);
        if (g) tildados.push(...g.keys);
      }
      const futuros = [...root.querySelectorAll('[data-p="crecer"][data-c="futuros"]')]
        .filter((el) => el instanceof HTMLInputElement && el.checked)
        .map((el) => el.getAttribute('value'));
      const comprobantes = [...root.querySelectorAll('[data-p="fiscal"][data-c="comprobantes"]')]
        .filter((el) => el instanceof HTMLInputElement && el.checked)
        .map((el) => el.getAttribute('value'));
      return {
        prospecto: {
          nombre: texto('[data-prospecto="nombre"]'),
          contacto_nombre: texto('[data-prospecto="contacto_nombre"]'),
          telefono: texto('[data-prospecto="telefono"]'),
          email: texto('[data-prospecto="email"]'),
          rubro: texto('[data-prospecto="rubro"]') || 'retail',
          sucursales: num('[data-prospecto="sucursales"]'),
          cajas: num('[data-prospecto="cajas"]'),
          usuarios: num('[data-prospecto="usuarios"]'),
        },
        objetos: {
          'mostrador-3d': { cajas: num('[data-p="mostrador"][data-c="cajas"]'), descuento: bool('[data-p="mostrador"][data-c="descuento"]') },
          'estanteria-3d': { almacenes: num('[data-p="deposito"][data-c="almacenes"]'), ubicaciones: bool('[data-p="deposito"][data-c="ubicaciones"]') },
          'gondola-3d': { listas_precio: num('[data-p="ventas"][data-c="listas"]') },
          'computadora-3d': { proveedores: num('[data-p="compras"][data-c="proveedores"]'), orden_compra: bool('[data-p="compras"][data-c="oc"]') },
          'pizarron-fiscal-3d': { comprobantes, contador: texto('[data-p="fiscal"][data-c="contador"]') },
          'puerta-crecer-3d': { futuros },
        },
        seleccion: [...SIEMPRE_INCLUIDOS, ...tildados, ...futuros],
        datos: { productos_aprox: num('[data-dato="productos_aprox"]'), tiene_excel: bool('[data-dato="tiene_excel"]') },
        infra: { hosting_propio: false, dominio_ssl: false, backups: false },
      };
    }

    function pinta() {
      const b = construirBorrador(leeEstado());
      borradorActual = b;
      guardarBorrador(b);
      const errores = validarBorrador(b);
      if (chips instanceof HTMLElement) {
        chips.innerHTML = '';
        for (const k of [...b.modulos_ancla, ...b.modulos_futuros]) {
          const li = document.createElement('li');
          li.className = 'rounded-full border px-2 py-0.5 text-xs';
          li.textContent = k;
          chips.appendChild(li);
        }
      }
      if (json instanceof HTMLElement) json.textContent = JSON.stringify(b, null, 1);
      if (listaErrores instanceof HTMLElement) {
        listaErrores.innerHTML = '';
        for (const e of errores) {
          const li = document.createElement('li');
          li.textContent = '• ' + e;
          listaErrores.appendChild(li);
        }
      }
      if (construidos instanceof HTMLElement) {
        construidos.innerHTML = '';
        for (const g of GUION_CHAT) {
          const li = document.createElement('li');
          li.className = 'rounded-full border px-2 py-1' + (si.has(g.id) ? ' hecho' : ' opacity-50');
          li.textContent = (si.has(g.id) ? '✓ ' : '') + g.id;
          construidos.appendChild(li);
        }
      }
      const n = si.size;
      if (progreso instanceof HTMLElement) {
        progreso.textContent = n === 0
          ? 'Paso 1 de 7 · Tu negocio'
          : `Paso ${Math.min(n + 1, 7)} de 7 · ${n >= 6 ? 'Para crecer' : 'Tu ancla'} · ${n} síes`;
      }
      if (linkWa instanceof HTMLAnchorElement) {
        linkWa.href = enlaceWhatsApp(mensajeWhatsApp(b));
        const bloqueado = errores.length > 0;
        linkWa.classList.toggle('opacity-40', bloqueado);
        linkWa.setAttribute('aria-disabled', bloqueado ? 'true' : 'false');
      }
      try {
        const u = new URL(location.href);
        u.searchParams.set('layout', layout);
        history.replaceState(null, '', u);
      } catch { /* sin URL: el chat igual anda */ }
    }

    function marcar(id, vale) {
      const card = root.querySelector(`[data-card="${id}"]`);
      const btnSi = root.querySelector(`[data-si="${id}"]`);
      const extra = root.querySelector(`[data-extra="${id}"]`);
      if (vale) {
        si.add(id);
        decir(`Anotado: ${id}. Mirá tu oficina →`);
        if (escena) escena.resaltar(preguntaAObjeto[id]);
      } else {
        si.delete(id);
      }
      if (btnSi instanceof HTMLElement) btnSi.setAttribute('aria-pressed', vale ? 'true' : 'false');
      if (card instanceof HTMLElement) card.classList.toggle('hecho', vale);
      if (extra instanceof HTMLElement) extra.hidden = !vale;
      pinta();
    }

    root.querySelectorAll('[data-si]').forEach((b) => {
      b.addEventListener('click', () => marcar(b.getAttribute('data-si'), true));
    });
    root.querySelectorAll('[data-no]').forEach((b) => {
      b.addEventListener('click', () => marcar(b.getAttribute('data-no'), false));
    });
    root.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('input', pinta);
      el.addEventListener('change', pinta);
    });
    root.querySelectorAll('[data-fb]').forEach((b) => {
      b.addEventListener('click', () => {
        const id = b.getAttribute('data-fb');
        if (typeof id === 'string' && objetoAPregunta[id]) irAPregunta(objetoAPregunta[id]);
      });
    });

    // Retoma lo guardado: los síes se derivan de los módulos del borrador.
    try {
      const previo = cargarBorrador();
      if (previo) {
        for (const g of GUION_CHAT) {
          if (g.keys.some((k) => [...previo.modulos_ancla, ...previo.modulos_futuros].includes(k))) {
            marcar(g.id, true);
          }
        }
      }
    } catch { /* arranca vacío */ }

    async function copiar() {
      if (!borradorActual) return;
      const t = JSON.stringify(borradorActual, null, 1);
      try {
        await navigator.clipboard.writeText(t);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = t;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      if (avisoCopiado instanceof HTMLElement) {
        avisoCopiado.hidden = false;
        setTimeout(() => { avisoCopiado.hidden = true; }, 3000);
      }
    }
    btnCopiar?.addEventListener('click', (e) => {
      if (borradorActual && validarBorrador(borradorActual).length > 0) {
        e.preventDefault();
        root.querySelector('[data-prospecto="nombre"]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      copiar();
    });
    linkWa?.addEventListener('click', (e) => {
      if (borradorActual && validarBorrador(borradorActual).length > 0) {
        e.preventDefault();
        return;
      }
      if (avisoEnviado instanceof HTMLElement) {
        avisoEnviado.textContent = '¡Gracias! Recibí tu borrador, en unos momentos me comunico con vos.';
        avisoEnviado.hidden = false;
      }
    });
    btnEnviar?.addEventListener('click', async () => {
      if (!borradorActual || validarBorrador(borradorActual).length > 0) {
        root.querySelector('[data-prospecto="nombre"]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      if (!(btnEnviar instanceof HTMLButtonElement)) return;
      btnEnviar.disabled = true;
      try {
        const res = await fetch('/api/oficina/borrador', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(borradorActual),
        });
        if (!res.ok) throw new Error('Error ' + res.status);
        if (avisoEnviado instanceof HTMLElement) {
          avisoEnviado.textContent = '¡Gracias! Recibí tu borrador, en unos momentos me comunico con vos.';
          avisoEnviado.hidden = false;
        }
      } catch {
        if (avisoEnviado instanceof HTMLElement) {
          avisoEnviado.textContent = 'No se pudo enviar: probá por WhatsApp.';
          avisoEnviado.hidden = false;
        }
      } finally {
        btnEnviar.disabled = false;
      }
    });

    // Escena: click en mueble vuelve a su pregunta (3D→chat).
    if (canvas instanceof HTMLCanvasElement && !canvas.dataset.mounted) {
      const io = new IntersectionObserver(async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        try {
          const { mountOficinaScene } = await import('../scripts/oficina-scene');
          escena = mountOficinaScene(canvas, (objeto) => {
            if (objetoAPregunta[objeto]) irAPregunta(objetoAPregunta[objeto]);
          });
          window.addEventListener('pagehide', () => escena && escena(), { once: true });
          if (est instanceof HTMLElement) est.textContent = 'Escena 3D activa: respondé y mirá cómo se arma · click en un mueble para volver a su pregunta.';
        } catch {
          canvas.style.display = 'none';
          if (fb instanceof HTMLElement) fb.hidden = false;
          if (est instanceof HTMLElement) est.textContent = 'Sin WebGL: usá los sectores para volver a cada pregunta.';
        }
      }, { rootMargin: '200px' });
      io.observe(canvas);
    }
    pinta();
  }
</script>
