---
// Ruta REAL del portal (ticket 03) — recorrido guiado + hero 3D, reescrita con polish.
// No es prototype: sin precios como oferta, borrador completo v1, localStorage, envío.
import BaseLayout from '../layouts/BaseLayout.astro';
import { seoOficina } from '../data/business';
import { OBJETO_LABEL, PUERTA_FUTURO, horasDe, type Objeto3DId } from '../lib/oficina-mapping';

const NOMBRES: Record<string, string> = {
  mostrador: 'Mostrador',
  deposito: 'Depósito Inteligente',
  ventas: 'Ventas',
  compras: 'Compras',
  fiscal_ar: 'Fiscal AR',
  contactos: 'Contactos',
  plataforma: 'Plataforma ModoOps',
  puente_factura: 'Puente Factura Web',
  taller: 'Taller',
  migracion_excel: 'Migración Excel',
  b2b_basico: 'B2B Básico',
  ia: 'IA ModoOps',
};
const SIEMPRE = ['contactos', 'plataforma', 'puente_factura'];
const objetos: Objeto3DId[] = [
  'mostrador-3d',
  'estanteria-3d',
  'gondola-3d',
  'computadora-3d',
  'pizarron-fiscal-3d',
  'puerta-crecer-3d',
  'zona-logistica-3d',
];
const COMPROBANTES = ['Factura A', 'Factura B', 'Factura C', 'Ticket', 'Recibo'];
---

<BaseLayout
  title={seoOficina.title}
  description={seoOficina.description}
  canonical="https://modoops.com.ar/oficina"
>
  <main class="mx-auto w-full max-w-7xl px-4 py-8 md:px-8" data-portal>
    <p class="rounded-full border border-dashed px-3 py-1 text-xs text-zinc-400">
      Borrador no vinculante · lo valida el consultor en el Descubrimiento · nada de acá crea tu sistema
    </p>
    <h1 class="mt-2 text-3xl font-semibold">Tu oficina, tu borrador</h1>
    <p class="mt-1 text-sm text-zinc-400">
      Tres pasos: tu negocio, lo que necesitás hoy (ancla) y para dónde querés crecer.
    </p>

    <div class="mt-4 grid gap-4">
      <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 md:p-6">

        <section data-panel="0" class="mt-4">
          <h2 class="text-lg font-semibold">Paso 1 — Tu negocio</h2>
          <div class="mt-2 grid gap-3 lg:grid-cols-2">
            <div class="flex h-full flex-col rounded-xl border border-white/10 bg-white/[0.04] p-3 text-sm md:p-4" data-conversa>
              <h3 class="font-semibold">Armemos tu borrador conversando</h3>
              <div class="mt-2 flex max-h-[36rem] min-h-[16rem] flex-1 flex-col gap-2 overflow-auto" data-chat-hilo aria-live="polite"></div>
              <div class="mt-2 flex flex-wrap gap-1" data-chat-opciones></div>
              <form data-chat-form class="mt-2 flex flex-col gap-2">
                <label class="sr-only" for="chat-msg">Respondé en la conversación</label>
                <textarea id="chat-msg" data-chat-msg rows="3" autocomplete="off" class="max-h-48 min-h-24 w-full rounded border border-white/10 bg-white/[0.06] p-3 text-base text-white placeholder:text-zinc-400" placeholder="Respondé o preguntame lo que sea…"></textarea>
                <button type="submit" class="w-full rounded-full border px-4 py-3 text-sm font-semibold">Enviar</button>
              </form>
              <p class="mt-1 text-xs text-zinc-400">Respondé y también podés preguntarme lo que sea (ej: ¿qué incluye el sistema?). Solo nombre y un contacto son obligatorios. Todo queda en tu navegador hasta que lo envíes.</p>
            </div>
            <div class="relative flex h-full flex-col rounded-xl border border-white/10 bg-white/[0.04] p-3 text-sm md:p-4" data-hero>
              <canvas
                data-hero-canvas
                class="block min-h-[22rem] w-full flex-1 rounded-xl"
                aria-label="Oficina virtual ModoOps: tocá un mueble para ir a su ficha"
                aria-describedby="hero-ayuda"
              ></canvas>
            <div data-hero-etiquetas class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true"></div>
            <div data-hero-fallback hidden class="rounded-xl border border-white/10 bg-white/[0.04] p-3">
              <p class="text-sm font-semibold">Plano del local (sin 3D)</p>
              <p class="text-xs text-zinc-400">Tocá un sector para ir a su ficha.</p>
              <div class="mt-2 flex flex-wrap gap-1">
                {objetos.map((id) => (
                  <button data-hero-fallback-btn={id} class="rounded-full border border-white/10 bg-white/[0.06] px-2 py-1 text-xs">
                    {OBJETO_LABEL[id]}
                  </button>
                ))}
              </div>
            </div>
            <p class="px-1 py-1 text-xs text-zinc-400" data-hero-estado id="hero-ayuda">
              Arrastrá para girar · click en un mueble para ir a su ficha.
            </p>
            </div>
          </div>

          <details class="mt-3 rounded-xl border border-white/10 bg-white/[0.04] p-3 text-sm">
            <summary class="cursor-pointer font-semibold">Ver/editar todos los datos</summary>
            <div class="mt-2 grid gap-2 text-sm">
            <label>Nombre del negocio *
              <input data-prospecto="nombre" autocomplete="organization" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" placeholder="Ej: Pinturería Centro" /></label>
            <div class="grid gap-2 md:grid-cols-2">
              <label>Tu nombre
                <input data-prospecto="contacto_nombre" autocomplete="name" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" placeholder="Ej: Ana" /></label>
              <label>Teléfono *
                <input data-prospecto="telefono" type="tel" autocomplete="tel" inputmode="tel" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" placeholder="Ej: 3547 000000" /></label>
            </div>
            <div class="grid gap-2 md:grid-cols-2">
              <label>Email
                <input data-prospecto="email" type="email" autocomplete="email" inputmode="email" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" placeholder="Ej: ana@negocio.com" /></label>
              <label>Rubro
                <select data-prospecto="rubro" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500">
                  <option value="retail">Retail mostrador</option>
                  <option value="distribucion">Distribución chica</option>
                  <option value="servicios">Servicios</option>
                </select></label>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <label>Sucursales <input data-prospecto="sucursales" type="number" min="1" value="1" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
              <label>Cajas <input data-prospecto="cajas" type="number" min="1" value="2" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
              <label>Usuarios <input data-prospecto="usuarios" type="number" min="1" value="5" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
            </div>
            <div class="grid gap-2 md:grid-cols-2">
              <label>Productos aprox. <input data-dato="productos_aprox" type="number" min="0" value="0" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
              <label class="flex items-center gap-2">¿Llevás stock en Excel hoy?
                <input data-dato="tiene_excel" type="checkbox" class="h-4 w-4" /></label>
            </div>
            <fieldset class="rounded border p-2">
              <legend class="px-1 text-xs text-zinc-400">Tu parte técnica (solo sí/no)</legend>
              <div class="flex flex-wrap gap-3">
                <label class="flex items-center gap-2">¿Pagás hosting o servidor? <input data-infra="hosting_propio" type="checkbox" class="h-4 w-4" /></label>
                <label class="flex items-center gap-2">¿Página con candadito (https)? <input data-infra="dominio_ssl" type="checkbox" class="h-4 w-4" /></label>
                <label class="flex items-center gap-2">¿Copias de seguridad? <input data-infra="backups" type="checkbox" class="h-4 w-4" /></label>
              </div>
            </fieldset>
            <p class="text-xs text-zinc-400">* Solo nombre y un contacto (teléfono o email) son obligatorios. Todo lo demás ayuda al consultor pero es opcional.</p>
            </div>
          </details>
        </section>

        <section data-panel="1" class="mt-4" hidden>
          <h2 class="text-lg font-semibold">Paso 2 — Tu ancla (combo cerrado)</h2>
          <p class="text-sm text-zinc-400">Tildá lo que necesitás hoy. Siempre incluidos: {SIEMPRE.map((k) => NOMBRES[k]).join(' · ')}.</p>

          <div class="mt-3 grid gap-3" data-fichas>
            <article data-ficha="mostrador-3d" class="rounded-xl border p-3">
              <label class="flex items-center gap-2 font-semibold">
                <input data-incluir="mostrador-3d" type="checkbox" class="h-4 w-4" /> {OBJETO_LABEL['mostrador-3d']} → {NOMBRES.mostrador}</label>
              <div class="mt-2 grid gap-2 text-sm md:grid-cols-2">
                <label>¿Cuántas cajas? <input data-obj="mostrador-3d" data-campo="cajas" type="number" min="1" value="2" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
                <label class="flex items-center gap-2">¿Hacés descuento en caja? <input data-obj="mostrador-3d" data-campo="descuento" type="checkbox" class="h-4 w-4" /></label>
              </div>
            </article>

            <article data-ficha="estanteria-3d" class="rounded-xl border p-3">
              <label class="flex items-center gap-2 font-semibold">
                <input data-incluir="estanteria-3d" type="checkbox" class="h-4 w-4" /> {OBJETO_LABEL['estanteria-3d']} → {NOMBRES.deposito}</label>
              <div class="mt-2 grid gap-2 text-sm md:grid-cols-2">
                <label>¿Cuántos depósitos? <input data-obj="estanteria-3d" data-campo="almacenes" type="number" min="1" value="1" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
                <label class="flex items-center gap-2">¿Ubicaciones por estante? <input data-obj="estanteria-3d" data-campo="ubicaciones" type="checkbox" class="h-4 w-4" /></label>
              </div>
            </article>

            <article data-ficha="gondola-3d" class="rounded-xl border p-3">
              <label class="flex items-center gap-2 font-semibold">
                <input data-incluir="gondola-3d" type="checkbox" class="h-4 w-4" /> {OBJETO_LABEL['gondola-3d']} → {NOMBRES.ventas}</label>
              <div class="mt-2 text-sm">
                <label>¿Cuántas listas de precio? <input data-obj="gondola-3d" data-campo="listas_precio" type="number" min="1" value="1" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
              </div>
            </article>

            <article data-ficha="computadora-3d" class="rounded-xl border p-3">
              <label class="flex items-center gap-2 font-semibold">
                <input data-incluir="computadora-3d" type="checkbox" class="h-4 w-4" /> {OBJETO_LABEL['computadora-3d']} → {NOMBRES.compras}</label>
              <div class="mt-2 grid gap-2 text-sm md:grid-cols-2">
                <label>¿Cuántos proveedores? <input data-obj="computadora-3d" data-campo="proveedores" type="number" min="0" value="0" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
                <label class="flex items-center gap-2">¿Usás orden de compra? <input data-obj="computadora-3d" data-campo="orden_compra" type="checkbox" class="h-4 w-4" /></label>
              </div>
            </article>

            <article data-ficha="pizarron-fiscal-3d" class="rounded-xl border p-3">
              <label class="flex items-center gap-2 font-semibold">
                <input data-incluir="pizarron-fiscal-3d" type="checkbox" class="h-4 w-4" /> {OBJETO_LABEL['pizarron-fiscal-3d']} → {NOMBRES.fiscal_ar}</label>
              <p class="mt-1 text-xs text-zinc-400">Borrador sin validez: el cierre real lo hacés con tu contador antes de salir en vivo.</p>
              <fieldset class="mt-2 text-sm">
                <legend class="text-xs text-zinc-400">¿Qué comprobantes creés que usás?</legend>
                <div class="flex flex-wrap gap-2">
                  {COMPROBANTES.map((c) => (
                    <label class="flex items-center gap-1 rounded border px-2 py-1 text-xs">
                      <input data-obj="pizarron-fiscal-3d" data-campo="comprobantes" value={c} type="checkbox" class="h-3 w-3" /> {c}
                    </label>
                  ))}
                </div>
              </fieldset>
              <label class="mt-2 block text-sm">Tu contador <input data-obj="pizarron-fiscal-3d" data-campo="contador" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" placeholder="Ej: Estudio López" /></label>
            </article>
          </div>
        </section>

        <section data-panel="2" class="mt-4" hidden>
          <h2 class="text-lg font-semibold">Paso 3 — Para crecer (futuro, no ancla)</h2>
          <p class="text-sm text-zinc-400">Lo que hoy no entra, pero querés dejar anotado.</p>
          <article data-ficha="puerta-crecer-3d" class="mt-3 rounded-xl border border-dashed p-3">
            <p class="font-semibold">{OBJETO_LABEL['puerta-crecer-3d']}</p>
            <div class="mt-2 grid gap-2 text-sm">
              {PUERTA_FUTURO.map((k) => (
                <label class="flex items-center gap-2 rounded border p-2">
                  <input data-futuro={k} type="checkbox" class="h-4 w-4" /> {NOMBRES[k]}
                </label>
              ))}
            </div>
          </article>

          <article data-ficha="zona-logistica-3d" class="mt-3 rounded-xl border border-dashed p-3">
            <p class="font-semibold">{OBJETO_LABEL['zona-logistica-3d']}</p>
            <p class="text-xs text-zinc-400">A desarrollar, a cotizar: la tripleta del chat la califica.</p>
            <div class="mt-2 grid gap-2 text-sm">
              <label class="block">Envíos por día <input data-obj="zona-logistica-3d" data-campo="envios_dia" type="number" min="0" value="0" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white" /></label>
              <label class="flex items-center gap-2"><input data-obj="zona-logistica-3d" data-campo="flota_propia" type="checkbox" class="h-4 w-4" /> Flota propia (si no, correo)</label>
              <label class="block">Zonas donde repartís <input data-obj="zona-logistica-3d" data-campo="zonas" type="text" placeholder="Ej: Capital y alrededores" class="mt-1 w-full rounded border border-white/10 bg-white/[0.06] p-2 text-white placeholder:text-zinc-500" /></label>
            </div>
          </article>

          <div class="mt-4 rounded-xl border border-white/10 bg-white/[0.04] p-3">
            <h3 class="font-semibold">Enviá tu borrador al consultor</h3>
            <ul class="mt-1 text-sm text-red-700" data-errores aria-live="polite"></ul>
            <div class="mt-2 flex flex-wrap gap-2">
              <button data-copiar class="rounded-full border border-white/20 px-4 py-2 text-sm text-white">Copiar JSON</button>
              <a data-whatsapp target="_blank" rel="noopener" class="rounded-full border border-green-600 px-4 py-2 text-sm text-green-300">Enviar por WhatsApp</a>
              <button data-enviar class="rounded-full bg-[var(--color-star-warm)] px-4 py-2 text-sm font-semibold text-space-void">Enviar a ModoOps</button>
            </div>
            <p class="mt-1 text-xs text-zinc-400" data-copiado hidden>¡Copiado! Pegalo donde te lo pidan.</p>
            <p class="mt-1 text-xs" data-enviado role="status" hidden></p>
          </div>
        </section>
      </div>

      <aside hidden class="rounded-2xl border border-white/10 bg-white/[0.04] p-4" aria-live="polite">
        <h2 class="text-lg font-semibold">Borrador vivo</h2>
        <p class="text-xs text-zinc-400">Se guarda solo en tu navegador.</p>
        <ul class="mt-2 flex flex-wrap gap-1" data-seleccion></ul>
        <pre class="mt-2 max-h-96 overflow-auto rounded-lg bg-neutral-950 p-2 text-xs text-green-200" data-json>{}</pre>
        <div class="mt-3 rounded-xl border p-3" data-cotizacion-panel>
          <h3 class="font-semibold">Validación del servidor</h3>
          <p class="text-xs text-zinc-400">Cotizá tu selección contra el catálogo vivo de Odoo (sin guardar nada).</p>
          <button data-cotizar class="mt-2 rounded-full bg-[var(--color-star-warm)] px-4 py-2 text-sm font-semibold text-space-void">Cotizar en servidor</button>
          <div class="mt-2 text-sm" data-cotizacion aria-live="polite"></div>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  /* S5: inputs a 16px para que iOS no haga zoom al enfocar */
  [data-portal] input:not([type='checkbox']):not([type='radio']),
  [data-portal] select {
    font-size: 1rem;
  }
  :global(.oficina-cartel) {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.92);
    color: #111;
    border: 1px solid rgb(0 0 0 / 0.15);
    padding: 0.1rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2);
  }
  :global(.oficina-cartel--activo) {
    background: #111;
    color: #fff;
  }
  @media (max-width: 480px) {
    :global(.oficina-cartel) {
      font-size: 0.6rem;
      padding: 0.05rem 0.4rem;
    }
  }
  .ficha-flash {
    outline: 2px solid #111;
    outline-offset: 2px;
  }
</style>

<script>
  import {
    OBJETO_A_MODULO,
    construirBorrador,
    esAncla,
    guardarBorrador,
    cargarBorrador,
    horasDe,
    validarBorrador,
    mensajeWhatsApp,
    enlaceWhatsApp,
  } from '../lib/oficina-mapping';

  const NOMBRES = {
    mostrador: 'Mostrador',
    deposito: 'Depósito Inteligente',
    ventas: 'Ventas',
    compras: 'Compras',
    fiscal_ar: 'Fiscal AR',
    contactos: 'Contactos',
    plataforma: 'Plataforma ModoOps',
    puente_factura: 'Puente Factura Web',
    taller: 'Taller',
    migracion_excel: 'Migración Excel',
    b2b_basico: 'B2B Básico',
    ia: 'IA ModoOps',
  };
  const SIEMPRE = ['contactos', 'plataforma', 'puente_factura'];

  const root = document.querySelector('[data-portal]');
  if (root instanceof HTMLElement) {
    const num = (sel) => {
      const el = root.querySelector(sel);
      const v = el instanceof HTMLInputElement ? Number(el.value) : NaN;
      return Number.isFinite(v) ? v : 0;
    };
    const bool = (sel) => {
      const el = root.querySelector(sel);
      return el instanceof HTMLInputElement ? el.checked : false;
    };
    const texto = (sel) => {
      const el = root.querySelector(sel);
      return el instanceof HTMLInputElement ? el.value : '';
    };

    function leeEstado() {
      const incluidos = ['mostrador-3d', 'estanteria-3d', 'gondola-3d', 'computadora-3d', 'pizarron-fiscal-3d']
        .filter((id) => bool(`[data-incluir="${id}"]`))
        .map((id) => OBJETO_A_MODULO[id]);
      const futuros = [...root.querySelectorAll('[data-futuro]')]
        .filter((el) => el instanceof HTMLInputElement && el.checked)
        .map((el) => el.getAttribute('data-futuro'));
      const comprobantes = [...root.querySelectorAll('[data-obj="pizarron-fiscal-3d"][data-campo="comprobantes"]')]
        .filter((el) => el instanceof HTMLInputElement && el.checked)
        .map((el) => el.value);
      return {
        prospecto: {
          nombre: texto('[data-prospecto="nombre"]'),
          contacto_nombre: texto('[data-prospecto="contacto_nombre"]'),
          telefono: texto('[data-prospecto="telefono"]'),
          email: texto('[data-prospecto="email"]'),
          rubro: texto('[data-prospecto="rubro"]') || 'retail',
          sucursales: num('[data-prospecto="sucursales"]'),
          cajas: num('[data-prospecto="cajas"]'),
          usuarios: num('[data-prospecto="usuarios"]'),
        },
        objetos: {
          'mostrador-3d': { cajas: num('[data-obj="mostrador-3d"][data-campo="cajas"]'), descuento: bool('[data-obj="mostrador-3d"][data-campo="descuento"]') },
          'estanteria-3d': { almacenes: num('[data-obj="estanteria-3d"][data-campo="almacenes"]'), ubicaciones: bool('[data-obj="estanteria-3d"][data-campo="ubicaciones"]') },
          'gondola-3d': { listas_precio: num('[data-obj="gondola-3d"][data-campo="listas_precio"]') },
          'computadora-3d': { proveedores: num('[data-obj="computadora-3d"][data-campo="proveedores"]'), orden_compra: bool('[data-obj="computadora-3d"][data-campo="orden_compra"]') },
          'pizarron-fiscal-3d': { comprobantes, contador: texto('[data-obj="pizarron-fiscal-3d"][data-campo="contador"]') },
          'puerta-crecer-3d': { futuros },
          'zona-logistica-3d': { envios_dia: num('[data-obj="zona-logistica-3d"][data-campo="envios_dia"]'), flota_propia: bool('[data-obj="zona-logistica-3d"][data-campo="flota_propia"]'), zonas: texto('[data-obj="zona-logistica-3d"][data-campo="zonas"]') },
        },
        seleccion: [...SIEMPRE, ...incluidos, ...futuros, ...(logiResp[0] === 'si' ? ['logistica'] : [])],
        datos: { productos_aprox: num('[data-dato="productos_aprox"]'), tiene_excel: bool('[data-dato="tiene_excel"]') },
        infra: {
          hosting_propio: bool('[data-infra="hosting_propio"]'),
          dominio_ssl: bool('[data-infra="dominio_ssl"]'),
          backups: bool('[data-infra="backups"]'),
        },
      };
    }

    // Movimiento reducido: los scrolls programáticos usan 'auto' (global CSS cubre el resto).
    const reduceMovimiento =
      typeof window.matchMedia === "function" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function desplaza(el) {
