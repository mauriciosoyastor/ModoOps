---
// Ruta REAL del portal — chat → borrador v1 (sin escena 3D).
// Sin precios como oferta; localStorage; envío WhatsApp / consultor.
import BaseLayout from '../layouts/BaseLayout.astro';
import { seoOficina } from '../data/business';
import { OBJETO_LABEL, PUERTA_FUTURO, horasDe, type Objeto3DId } from '../lib/oficina-mapping';

const NOMBRES: Record<string, string> = {
  mostrador: 'Mostrador',
  deposito: 'Depósito Inteligente',
  ventas: 'Ventas',
  compras: 'Compras',
  fiscal_ar: 'Fiscal AR',
  contactos: 'Contactos',
  plataforma: 'Plataforma ModoOps',
  puente_factura: 'Puente Factura Web',
  taller: 'Taller',
  migracion_excel: 'Migración Excel',
  b2b_basico: 'B2B Básico',
  ia: 'IA ModoOps',
  ecommerce: 'Ecommerce',
  web: 'Página web',
  crm: 'CRM',
  otro: 'Otro',
};
const SIEMPRE = ['contactos', 'plataforma', 'puente_factura'];
const objetos: Objeto3DId[] = [
  'mostrador-3d',
  'estanteria-3d',
  'gondola-3d',
  'computadora-3d',
  'pizarron-fiscal-3d',
  'puerta-crecer-3d',
  'zona-logistica-3d',
];
const COMPROBANTES = ['Factura A', 'Factura B', 'Factura C', 'Ticket', 'Recibo'];
---

<BaseLayout
  title={seoOficina.title}
  description={seoOficina.description}
  canonical="https://modoops.com.ar/oficina"
>
  <main class="oficina" data-portal>
    <p class="oficina-aviso">
      Borrador no vinculante · lo valida el consultor en el Descubrimiento · nada de acá crea tu sistema
    </p>
    <h1 class="oficina-titulo">Tu oficina, tu borrador</h1>
    <p class="oficina-sub">
      Tres pasos: tu negocio, lo que necesitás hoy (ancla) y para dónde querés crecer.
    </p>

    <nav class="oficina-pasos" aria-label="Pasos del borrador">
      <button type="button" data-paso="0">Tu negocio</button>
      <button type="button" data-paso="1">Ancla</button>
      <button type="button" data-paso="2">Crecer</button>
    </nav>

    <p class="oficina-nota" data-copiado role="status" hidden></p>

    <div class="oficina-grilla">
      <div class="oficina-trabajo">

        <section data-panel="0">
          <h2 class="oficina-h2">Paso 1 — Tu negocio</h2>
          <div class="oficina-conversa" data-conversa>
            <h3 class="oficina-h3">Armemos tu borrador conversando</h3>
            <div class="oficina-hilo" data-chat-hilo aria-live="polite"></div>
            <div class="oficina-opciones" data-chat-opciones></div>
            <form data-chat-form class="oficina-form">
              <label class="sr-only" for="chat-msg">Respondé en la conversación</label>
              <textarea id="chat-msg" name="mensaje" data-chat-msg rows="3" autocomplete="off" class="oficina-campo oficina-campo--chat" placeholder="Respondé o preguntame lo que sea…"></textarea>
              <button type="submit" class="mo-btn mo-btn--primary">Enviar</button>
            </form>
            <p class="oficina-nota">Respondé y también podés preguntarme lo que sea (ej: ¿qué incluye el sistema?). Solo nombre y un contacto son obligatorios. Todo queda en tu navegador hasta que lo envíes.</p>
          </div>

          <details class="oficina-details">
            <summary>Ver/editar todos los datos</summary>
            <div class="oficina-campos">
            <label>Nombre del negocio *
              <input id="prospecto-nombre" name="nombre" data-prospecto="nombre" autocomplete="organization" class="oficina-campo" placeholder="Ej: Pinturería Centro…" aria-describedby="error-nombre" /></label>
            <p id="error-nombre" class="oficina-falla" data-error="nombre" role="alert" hidden></p>
            <div class="oficina-par">
              <label>Tu nombre
                <input name="contacto_nombre" data-prospecto="contacto_nombre" autocomplete="name" class="oficina-campo" placeholder="Ej: Ana…" /></label>
              <div>
                <label>Teléfono *
                  <input id="prospecto-telefono" name="telefono" data-prospecto="telefono" type="tel" autocomplete="tel" inputmode="tel" class="oficina-campo" placeholder="Ej: 3547&nbsp;000000…" aria-describedby="error-contacto" /></label>
                <p id="error-contacto" class="oficina-falla" data-error="contacto" role="alert" hidden></p>
              </div>
            </div>
            <div class="oficina-par">
              <div>
                <label>Email
                  <input id="prospecto-email" name="email" data-prospecto="email" type="email" autocomplete="email" inputmode="email" spellcheck="false" class="oficina-campo" placeholder="Ej: ana@negocio.com…" aria-describedby="error-contacto" /></label>
                <p class="oficina-falla" data-error="contacto" hidden aria-hidden="true"></p>
              </div>
              <label>Rubro
                <select name="rubro" data-prospecto="rubro" class="oficina-campo">
                  <option value="retail">Retail mostrador</option>
                  <option value="distribucion">Distribución chica</option>
                  <option value="servicios">Servicios</option>
                </select></label>
            </div>
            <div class="oficina-tres">
              <label>Sucursales <input name="sucursales" data-prospecto="sucursales" type="number" inputmode="numeric" min="1" value="1" class="oficina-campo" /></label>
              <label>Cajas <input name="cajas" data-prospecto="cajas" type="number" inputmode="numeric" min="1" value="2" class="oficina-campo" /></label>
              <label>Usuarios <input name="usuarios" data-prospecto="usuarios" type="number" inputmode="numeric" min="1" value="5" class="oficina-campo" /></label>
            </div>
            <div class="oficina-par">
              <label>Productos aprox. <input name="productos_aprox" data-dato="productos_aprox" type="number" inputmode="numeric" min="0" value="0" class="oficina-campo" /></label>
              <label class="oficina-check">¿Llevás stock en Excel hoy?
                <input name="tiene_excel" data-dato="tiene_excel" type="checkbox" /></label>
            </div>
            <fieldset class="oficina-fieldset">
              <legend>Tu parte técnica (solo sí/no)</legend>
              <div class="oficina-checks">
                <label class="oficina-check">¿Pagás hosting o servidor? <input name="hosting_propio" data-infra="hosting_propio" type="checkbox" /></label>
                <label class="oficina-check">¿Página con candadito (https)? <input name="dominio_ssl" data-infra="dominio_ssl" type="checkbox" /></label>
                <label class="oficina-check">¿Copias de seguridad? <input name="backups" data-infra="backups" type="checkbox" /></label>
              </div>
            </fieldset>
            <p class="oficina-nota">* Solo nombre y un contacto (teléfono o email) son obligatorios. Todo lo demás ayuda al consultor pero es opcional.</p>
            </div>
          </details>
        </section>

        <section data-panel="1" class="oficina-panel--oculto">
          <h2 class="oficina-h2">Paso 2 — Tu ancla (combo cerrado)</h2>
          <p class="oficina-sub">Tildá lo que necesitás hoy. Siempre incluidos: {SIEMPRE.map((k) => NOMBRES[k]).join(' · ')}.</p>

          <div class="oficina-fichas" data-fichas>
            <article data-ficha="mostrador-3d" class="oficina-ficha">
              <label class="oficina-check oficina-check--titulo">
                <input name="incluir-mostrador" data-incluir="mostrador-3d" type="checkbox" /> {OBJETO_LABEL['mostrador-3d']} → {NOMBRES.mostrador}</label>
              <div class="oficina-par">
                <label>¿Cuántas cajas? <input name="mostrador-cajas" data-obj="mostrador-3d" data-campo="cajas" type="number" inputmode="numeric" min="1" value="2" class="oficina-campo" /></label>
                <label class="oficina-check">¿Hacés descuento en caja? <input name="mostrador-descuento" data-obj="mostrador-3d" data-campo="descuento" type="checkbox" /></label>
              </div>
            </article>

            <article data-ficha="estanteria-3d" class="oficina-ficha">
              <label class="oficina-check oficina-check--titulo">
                <input name="incluir-estanteria" data-incluir="estanteria-3d" type="checkbox" /> {OBJETO_LABEL['estanteria-3d']} → {NOMBRES.deposito}</label>
              <div class="oficina-par">
                <label>¿Cuántos depósitos? <input name="estanteria-almacenes" data-obj="estanteria-3d" data-campo="almacenes" type="number" inputmode="numeric" min="1" value="1" class="oficina-campo" /></label>
                <label class="oficina-check">¿Ubicaciones por estante? <input name="estanteria-ubicaciones" data-obj="estanteria-3d" data-campo="ubicaciones" type="checkbox" /></label>
              </div>
            </article>

            <article data-ficha="gondola-3d" class="oficina-ficha">
              <label class="oficina-check oficina-check--titulo">
                <input name="incluir-gondola" data-incluir="gondola-3d" type="checkbox" /> {OBJETO_LABEL['gondola-3d']} → {NOMBRES.ventas}</label>
              <div>
                <label>¿Cuántas listas de precio? <input name="gondola-listas" data-obj="gondola-3d" data-campo="listas_precio" type="number" inputmode="numeric" min="1" value="1" class="oficina-campo" /></label>
              </div>
            </article>

            <article data-ficha="computadora-3d" class="oficina-ficha">
              <label class="oficina-check oficina-check--titulo">
                <input name="incluir-computadora" data-incluir="computadora-3d" type="checkbox" /> {OBJETO_LABEL['computadora-3d']} → {NOMBRES.compras}</label>
              <div class="oficina-par">
                <label>¿Cuántos proveedores? <input name="computadora-proveedores" data-obj="computadora-3d" data-campo="proveedores" type="number" inputmode="numeric" min="0" value="0" class="oficina-campo" /></label>
                <label class="oficina-check">¿Usás orden de compra? <input name="computadora-orden" data-obj="computadora-3d" data-campo="orden_compra" type="checkbox" /></label>
              </div>
            </article>

            <article data-ficha="pizarron-fiscal-3d" class="oficina-ficha">
              <label class="oficina-check oficina-check--titulo">
                <input name="incluir-fiscal" data-incluir="pizarron-fiscal-3d" type="checkbox" /> {OBJETO_LABEL['pizarron-fiscal-3d']} → {NOMBRES.fiscal_ar}</label>
              <p class="oficina-nota">Borrador sin validez: el cierre real lo hacés con tu contador antes de salir en vivo.</p>
              <fieldset class="oficina-fieldset">
                <legend>¿Qué comprobantes creés que usás?</legend>
                <div class="oficina-checks">
                  {COMPROBANTES.map((c) => (
                    <label class="oficina-check oficina-check--chip">
                      <input name="comprobantes" data-obj="pizarron-fiscal-3d" data-campo="comprobantes" value={c} type="checkbox" /> {c}
                    </label>
                  ))}
                </div>
              </fieldset>
              <label>Tu contador <input name="contador" data-obj="pizarron-fiscal-3d" data-campo="contador" class="oficina-campo" placeholder="Ej: Estudio López…" /></label>
            </article>
          </div>
        </section>

        <section data-panel="2" class="oficina-panel--oculto">
          <h2 class="oficina-h2">Paso 3 — Para crecer (futuro, no ancla)</h2>
          <p class="oficina-sub">Lo que hoy no entra, pero querés dejar anotado.</p>
          <article data-ficha="puerta-crecer-3d" class="oficina-ficha oficina-ficha--futuro">
            <p class="oficina-h3">{OBJETO_LABEL['puerta-crecer-3d']}</p>
            <div class="oficina-fichas">
              {PUERTA_FUTURO.map((k) => (
                <label class="oficina-check">
                  <input name={k} data-futuro={k} type="checkbox" /> {NOMBRES[k]}
                </label>
              ))}
            </div>
          </article>

          <article data-ficha="zona-logistica-3d" class="oficina-ficha oficina-ficha--futuro">
            <p class="oficina-h3">{OBJETO_LABEL['zona-logistica-3d']}</p>
            <p class="oficina-nota">A desarrollar, a cotizar: la tripleta del chat la califica.</p>
            <div class="oficina-campos">
              <label>Envíos por día <input name="envios_dia" data-obj="zona-logistica-3d" data-campo="envios_dia" type="number" inputmode="numeric" min="0" value="0" class="oficina-campo" /></label>
              <label class="oficina-check"><input name="flota_propia" data-obj="zona-logistica-3d" data-campo="flota_propia" type="checkbox" /> Flota propia (si no, correo)</label>
              <label>Zonas donde repartís <input name="zonas" data-obj="zona-logistica-3d" data-campo="zonas" type="text" placeholder="Ej: Capital y alrededores…" class="oficina-campo" /></label>
            </div>
          </article>

          <div class="oficina-envio">
            <h3 class="oficina-h3">Enviá tu borrador al consultor</h3>
            <ul class="oficina-errores" data-errores aria-live="polite"></ul>
            <div class="oficina-acciones">
              <button data-enviar class="mo-btn mo-btn--primary" type="button">Enviar a <span translate="no">ModoOps</span></button>
              <a data-whatsapp tabindex="-1" aria-disabled="true" target="_blank" rel="noopener" class="mo-btn mo-btn--ghost">Enviar por WhatsApp</a>
              <button data-copiar class="mo-btn mo-btn--ghost" type="button">Copiar JSON</button>
            </div>
            <p class="oficina-nota" data-enviado role="status" hidden></p>
          </div>
        </section>
      </div>

      <aside class="oficina-riel">
        <div data-hero>
          <h2 class="oficina-h3">Sectores de tu borrador</h2>
          <p class="oficina-nota">Tocá un sector para ir a su ficha (también desde el chat).</p>
          <div class="oficina-sectores" data-hero-sectores>
            {objetos.map((id) => (
              <button type="button" data-hero-sector={id} class="oficina-sector" aria-pressed="false">
                {OBJETO_LABEL[id]}
              </button>
            ))}
          </div>
          <p class="oficina-nota" data-hero-estado id="hero-ayuda">
            El borrador se arma en el chat; los sectores saltan a cada ficha.
          </p>
        </div>
        <h2 class="oficina-h3">Borrador vivo</h2>
        <p class="oficina-nota">Se guarda solo en tu navegador.</p>
        <ul class="oficina-chips" data-seleccion></ul>
        <pre class="oficina-json" data-json>{}</pre>
        <div class="oficina-cotizar" data-cotizacion-panel>
          <h3 class="oficina-h3">Validación del servidor</h3>
          <p class="oficina-nota">Cotizá tu selección contra el Catálogo (sin guardar nada).</p>
          <button data-cotizar class="mo-btn" type="button">Cotizar en servidor</button>
          <div data-cotizacion aria-live="polite"></div>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .oficina {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.25rem 1rem 2.5rem;
    color: var(--mo-ink);
  }
  .oficina-aviso,
  .oficina-nota {
    margin: 0.35rem 0 0;
    color: var(--mo-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
  .oficina-aviso {
    margin-top: 0;
  }
  .oficina-titulo {
    margin: 0.65rem 0 0;
    font-family: var(--mo-display);
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .oficina-sub {
    margin: 0.3rem 0 0;
    color: var(--mo-muted);
    font-size: 0.92rem;
  }
  .oficina-h2 {
    margin: 0 0 0.65rem;
    font-size: 1rem;
    font-weight: 650;
    text-wrap: balance;
  }
  .oficina-h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 650;
    text-wrap: balance;
  }
  .oficina-pasos {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 1rem;
    border-bottom: 1px solid var(--mo-line);
  }
  .oficina-pasos button {
    min-height: 44px;
    margin-bottom: -1px;
    padding: 0.35rem 0.9rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--mo-muted);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      transform 160ms var(--mo-ease-out),
      color 140ms ease,
      border-color 140ms ease;
  }
  .oficina-pasos button:active {
    transform: scale(0.97);
  }
  .oficina-pasos button[aria-current="true"] {
    border-bottom-color: var(--mo-accent);
    color: var(--mo-ink);
    font-weight: 650;
  }
  .oficina-trabajo [data-panel].oficina-panel--oculto {
    display: none;
  }
  .oficina-grilla {
    display: grid;
    gap: 1.25rem;
    margin-top: 1rem;
  }
  .oficina-conversa {
    padding: 0.75rem;
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius);
    background: var(--mo-canvas);
  }
  .oficina-hilo {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 24rem;
    margin-top: 0.65rem;
    overflow: auto;
  }
  .oficina-burbuja {
    margin: 0;
    max-width: 85%;
    padding: 0.5rem 0.65rem;
    border-radius: var(--mo-radius-sm);
    color: var(--mo-ink);
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .oficina-burbuja--bot {
    background: var(--mo-card);
  }
  .oficina-burbuja--user {
    align-self: end;
    background: var(--mo-accent-soft);
  }
  .oficina-opciones,
  .oficina-acciones,
  .oficina-sectores,
  .oficina-chips,
  .oficina-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .oficina-opciones,
  .oficina-form {
    margin-top: 0.65rem;
  }
  .oficina-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .oficina-form .mo-btn {
    width: 100%;
  }
  .oficina-campo {
    width: 100%;
    min-height: 44px;
    scroll-margin-top: 10rem;
    margin-top: 0.25rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius-sm);
    background: var(--mo-field);
    color: var(--mo-ink);
    font: inherit;
    font-size: 1rem;
    touch-action: manipulation;
  }
  .oficina-campo--chat {
    min-height: 5.5rem;
    max-height: 12rem;
  }
  .oficina-campo::placeholder {
    color: var(--mo-muted);
  }
  .oficina-falla {
    margin: 0.2rem 0 0;
    color: var(--mo-ink);
    font-size: 0.875rem;
    font-weight: 650;
  }
  .oficina-details {
    margin-top: 0.85rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--mo-line);
  }
  .oficina-details summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-weight: 650;
    cursor: pointer;
  }
  .oficina-campos,
  .oficina-fichas {
    display: grid;
    gap: 0.65rem;
    margin-top: 0.65rem;
  }
  .oficina-par {
    display: grid;
    gap: 0.65rem;
  }
  .oficina-tres {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }
  .oficina-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    touch-action: manipulation;
  }
  .oficina-check--titulo {
    font-weight: 650;
  }
  .oficina-check--chip {
    padding: 0 0.55rem;
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius-sm);
  }
  .oficina-fieldset {
    margin: 0;
    padding: 0.35rem 0.65rem 0.65rem;
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius-sm);
  }
  .oficina-fieldset legend {
    padding: 0 0.25rem;
    color: var(--mo-muted);
    font-size: 0.8125rem;
  }
  .oficina-ficha {
    padding: 0.75rem;
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius);
    background: var(--mo-canvas);
    scroll-margin-top: 10rem;
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition: outline-color 160ms ease;
  }
  .oficina-ficha--futuro {
    border-style: dashed;
  }
  .oficina-envio {
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--mo-line);
  }
  .oficina-acciones {
    margin-top: 0.65rem;
  }
  .oficina-errores {
    margin: 0.35rem 0 0;
    padding: 0;
    color: var(--mo-ink);
    font-size: 0.875rem;
    list-style: none;
  }
  .oficina-errores:empty {
    display: none;
  }
  .oficina-error {
    color: var(--mo-ink);
    font-weight: 650;
  }
  .oficina-ok {
    color: var(--mo-ok);
    font-weight: 650;
  }
  .oficina-inactivo {
    opacity: 0.45;
  }
  .oficina-riel {
    display: grid;
    gap: 0.85rem;
    align-content: start;
    padding-top: 1rem;
    border-top: 1px solid var(--mo-line);
  }
  .oficina-sector {
    min-height: 44px;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius-sm);
    background: var(--mo-canvas);
    color: var(--mo-ink);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      transform 160ms var(--mo-ease-out),
      background-color 140ms ease,
      border-color 140ms ease;
  }
  .oficina-sector:active {
    transform: scale(0.97);
  }
  .oficina-sector[aria-pressed="true"] {
    border-color: var(--mo-accent);
    background: var(--mo-accent-soft);
  }
  .oficina-opcion--on {
    border-color: var(--mo-accent);
    background: var(--mo-accent-soft);
    color: var(--mo-ink);
  }
  .oficina-chips {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }
  .oficina-chip {
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius-sm);
    font-size: 0.75rem;
  }
  .oficina-chip--ancla {
    border-color: var(--mo-ink);
    background: var(--mo-ink);
    color: var(--mo-wash);
  }
  .oficina-chip--futuro {
    border-color: var(--mo-warn);
    color: var(--mo-warn);
  }
  .oficina-json {
    max-height: 16rem;
    margin: 0.35rem 0 0;
    padding: 0.5rem;
    overflow: auto;
    border-radius: var(--mo-radius-sm);
    background: var(--mo-card);
    color: var(--mo-ink);
    font-size: 0.75rem;
  }
  .oficina-cotizar {
    display: grid;
    gap: 0.35rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--mo-line);
  }
  .ficha-flash {
    outline-color: var(--mo-focus);
  }
  @media (hover: hover) and (pointer: fine) {
    .oficina-pasos button:hover {
      color: var(--mo-ink);
    }
    .oficina-sector:hover {
      background: var(--mo-card);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .oficina .oficina-pasos button,
    .oficina .oficina-sector,
    .oficina .oficina-ficha {
      transition:
        color 140ms ease,
        border-color 140ms ease,
        background-color 140ms ease,
        outline-color 160ms ease,
        opacity 150ms var(--mo-ease-out) !important;
    }
    .oficina .oficina-pasos button:active,
    .oficina .oficina-sector:active {
      transform: none;
    }
  }
  @media (min-width: 48rem) {
    .oficina {
      padding-left: 2rem;
      padding-right: 2rem;
    }
    .oficina-par {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .oficina-grilla {
      grid-template-columns: minmax(0, 1.7fr) minmax(16rem, 22rem);
      align-items: start;
    }
    .oficina-riel {
      padding-top: 0;
      padding-left: 1.25rem;
      border-top: 0;
      border-left: 1px solid var(--mo-line);
    }
  }
</style>
<style is:global>
  html:has(.oficina) {
    scroll-padding-top: 10rem;
  }
  html:has(.oficina) .oficina-chip {
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import {
    OBJETO_A_MODULO,
    construirBorrador,
    esAncla,
    guardarBorrador,
    cargarBorrador,
    horasDe,
    validarBorrador,
    avisoAlCopiar,
    mensajeWhatsApp,
    enlaceWhatsApp,
  } from '../lib/oficina-mapping';
  import { desplazamientoDe, revelarDatosAntesDe } from '../lib/movimiento-oficina';

  const NOMBRES = {
    mostrador: 'Mostrador',
    deposito: 'Depósito Inteligente',
    ventas: 'Ventas',
    compras: 'Compras',
    fiscal_ar: 'Fiscal AR',
    contactos: 'Contactos',
    plataforma: 'Plataforma ModoOps',
    puente_factura: 'Puente Factura Web',
    taller: 'Taller',
    migracion_excel: 'Migración Excel',
    b2b_basico: 'B2B Básico',
    ia: 'IA ModoOps',
    ecommerce: 'Ecommerce',
    web: 'Página web',
    crm: 'CRM',
    otro: 'Otro',
  };
  const SIEMPRE = ['contactos', 'plataforma', 'puente_factura'];

  const root = document.querySelector('[data-portal]');
  if (root instanceof HTMLElement) {
    const num = (sel) => {
      const el = root.querySelector(sel);
      const v = el instanceof HTMLInputElement ? Number(el.value) : NaN;
      return Number.isFinite(v) ? v : 0;
    };
    const bool = (sel) => {
      const el = root.querySelector(sel);
      return el instanceof HTMLInputElement ? el.checked : false;
    };
    const texto = (sel) => {
      const el = root.querySelector(sel);
      return el instanceof HTMLInputElement ? el.value : '';
    };

    function leeEstado() {
      const incluidos = ['mostrador-3d', 'estanteria-3d', 'gondola-3d', 'computadora-3d', 'pizarron-fiscal-3d']
        .filter((id) => bool(`[data-incluir="${id}"]`))
        .map((id) => OBJETO_A_MODULO[id]);
      const futuros = [...root.querySelectorAll('[data-futuro]')]
        .filter((el) => el instanceof HTMLInputElement && el.checked)
        .map((el) => el.getAttribute('data-futuro'));
      const comprobantes = [...root.querySelectorAll('[data-obj="pizarron-fiscal-3d"][data-campo="comprobantes"]')]
        .filter((el) => el instanceof HTMLInputElement && el.checked)
        .map((el) => el.value);
      return {
        prospecto: {
          nombre: texto('[data-prospecto="nombre"]'),
          contacto_nombre: texto('[data-prospecto="contacto_nombre"]'),
          telefono: texto('[data-prospecto="telefono"]'),
          email: texto('[data-prospecto="email"]'),
          rubro: texto('[data-prospecto="rubro"]') || 'retail',
          sucursales: num('[data-prospecto="sucursales"]'),
          cajas: num('[data-prospecto="cajas"]'),
          usuarios: num('[data-prospecto="usuarios"]'),
        },
        objetos: {
          'mostrador-3d': { cajas: num('[data-obj="mostrador-3d"][data-campo="cajas"]'), descuento: bool('[data-obj="mostrador-3d"][data-campo="descuento"]') },
          'estanteria-3d': { almacenes: num('[data-obj="estanteria-3d"][data-campo="almacenes"]'), ubicaciones: bool('[data-obj="estanteria-3d"][data-campo="ubicaciones"]') },
          'gondola-3d': { listas_precio: num('[data-obj="gondola-3d"][data-campo="listas_precio"]') },
          'computadora-3d': { proveedores: num('[data-obj="computadora-3d"][data-campo="proveedores"]'), orden_compra: bool('[data-obj="computadora-3d"][data-campo="orden_compra"]') },
          'pizarron-fiscal-3d': { comprobantes, contador: texto('[data-obj="pizarron-fiscal-3d"][data-campo="contador"]') },
          'puerta-crecer-3d': { futuros },
          'zona-logistica-3d': { envios_dia: num('[data-obj="zona-logistica-3d"][data-campo="envios_dia"]'), flota_propia: bool('[data-obj="zona-logistica-3d"][data-campo="flota_propia"]'), zonas: texto('[data-obj="zona-logistica-3d"][data-campo="zonas"]') },
        },
        seleccion: [...SIEMPRE, ...incluidos, ...futuros, ...(logiResp[0] === 'si' ? ['logistica'] : [])],
        datos: { productos_aprox: num('[data-dato="productos_aprox"]'), tiene_excel: bool('[data-dato="tiene_excel"]') },
        infra: {
          hosting_propio: bool('[data-infra="hosting_propio"]'),
          dominio_ssl: bool('[data-infra="dominio_ssl"]'),
          backups: bool('[data-infra="backups"]'),
        },
      };
    }

    // Movimiento reducido: los scrolls programáticos usan 'auto' (global CSS cubre el resto).
    const reduceMovimiento =
      typeof window.matchMedia === "function" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function desplaza(el, destino) {
      if (!(el instanceof HTMLElement)) return;
      if (revelarDatosAntesDe(destino)) {
        const datos = el.closest("details");
        if (datos instanceof HTMLDetailsElement) datos.open = true;
      }
      el.scrollIntoView({ behavior: desplazamientoDe(destino, reduceMovimiento), block: "center" });
    }
    // Error de validación: vuelve al paso 1, abre los datos y enfoca el hueco que falta.
    function enfocaFallo(fallos) {
      irAPaso(0);
      const hueco = fallos.some((f) => f.hueco === "nombre") ? "nombre" : "contacto";
      const sel = hueco === "nombre" ? '[data-prospecto="nombre"]' : '[data-prospecto="telefono"]';
      const el = root.querySelector(sel);
      desplaza(el, hueco);
      if (el instanceof HTMLElement) el.focus({ preventScroll: true });
    }
    const chips = root.querySelector('[data-seleccion]');    const json = root.querySelector('[data-json]');
    const listaErrores = root.querySelector('[data-errores]');
    const btnCopiar = root.querySelector('[data-copiar]');
    const linkWa = root.querySelector('[data-whatsapp]');
    const avisoCopiado = root.querySelector('[data-copiado]');
    const btnEnviar = root.querySelector('[data-enviar]');
    const avisoEnviado = root.querySelector('[data-enviado]');
    let borradorActual = null;

    function marcaError(avisoSel, campoSel, mensaje) {
      if (avisoSel) {
        root.querySelectorAll(avisoSel).forEach((aviso) => {
          if (!(aviso instanceof HTMLElement)) return;
          aviso.hidden = !mensaje;
          if (aviso.textContent !== mensaje) aviso.textContent = mensaje;
        });
      }
      const campo = root.querySelector(campoSel);
      if (campo instanceof HTMLElement) {
        campo.setAttribute('aria-invalid', mensaje ? 'true' : 'false');
      }
    }
    function pinta() {
      const estado = leeEstado();
      const b = construirBorrador(estado);
      borradorActual = b;
      guardarBorrador(b);
      const errores = validarBorrador(b);
      if (chips) {
        chips.innerHTML = '';
        for (const k of [...b.modulos_ancla, ...b.modulos_futuros]) {
          const li = document.createElement('li');
          li.className = 'oficina-chip ' + (esAncla(k) ? 'oficina-chip--ancla' : 'oficina-chip--futuro');
          li.textContent = (NOMBRES[k] ?? k) + ' · ' + horasDe(k) + ' h';
          chips.appendChild(li);
        }
      }
      if (json) json.textContent = JSON.stringify(b, null, 1);
      if (listaErrores) {
        listaErrores.innerHTML = '';
        for (const e of errores) {
          const li = document.createElement('li');
          li.textContent = '• ' + e.mensaje;
          listaErrores.appendChild(li);
        }
      }
      const msgNombre = errores.find((e) => e.hueco === 'nombre')?.mensaje ?? '';
      const msgContacto = errores.find((e) => e.hueco === 'contacto')?.mensaje ?? '';
      marcaError('[data-error="nombre"]', '[data-prospecto="nombre"]', msgNombre);
      marcaError('[data-error="contacto"]', '[data-prospecto="telefono"]', msgContacto);
      marcaError(null, '[data-prospecto="email"]', msgContacto);
      const textoWa = mensajeWhatsApp(b);
      if (linkWa instanceof HTMLAnchorElement) {
        const bloqueado = errores.length > 0;
        linkWa.classList.toggle('oficina-inactivo', bloqueado);
        linkWa.setAttribute('aria-disabled', bloqueado ? 'true' : 'false');
        if (bloqueado) {
          linkWa.removeAttribute('href');
          linkWa.setAttribute('tabindex', '-1');
        } else {
          linkWa.href = enlaceWhatsApp(textoWa);
          linkWa.removeAttribute('tabindex');
        }
      }
      if (btnCopiar instanceof HTMLButtonElement) {
        btnCopiar.classList.toggle('oficina-inactivo', errores.length > 0);
      }
    }

    root.querySelectorAll('input, select').forEach((el) => {
      el.addEventListener('input', pinta);
      el.addEventListener('change', pinta);
    });

    async function copiar() {
      if (!borradorActual) return;
      const texto = JSON.stringify(borradorActual, null, 1);
      try {
        await navigator.clipboard.writeText(texto);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = texto;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      anunciaCopia('¡Copiado! Pegalo donde te lo pidan.', true);
    }
    let timerCopia = 0;
    function anunciaCopia(texto, seEsconde) {
      if (!(avisoCopiado instanceof HTMLElement)) return;
      window.clearTimeout(timerCopia);
      avisoCopiado.textContent = texto;
      avisoCopiado.hidden = false;
      if (!seEsconde) return;
      timerCopia = window.setTimeout(() => { avisoCopiado.hidden = true; }, 3000);
    }
    btnCopiar?.addEventListener('click', (e) => {
      const fallos = borradorActual ? validarBorrador(borradorActual) : [];
      if (fallos.length > 0) {
        e.preventDefault();
        anunciaCopia(avisoAlCopiar(fallos), false);
        enfocaFallo(fallos);
        return;
      }
      copiar();
    });
    linkWa?.addEventListener('click', (e) => {
      if (borradorActual && validarBorrador(borradorActual).length > 0) e.preventDefault();
    });

    // G1: envío directo al consultor (POST /api/oficina/borrador → modoops.lead)
    function avisaEnviado(texto, ok) {
      if (!(avisoEnviado instanceof HTMLElement)) return;
      avisoEnviado.textContent = texto;
      avisoEnviado.classList.toggle('oficina-ok', !!ok);
      avisoEnviado.classList.toggle('oficina-error', !ok);
      avisoEnviado.hidden = false;
    }
    btnEnviar?.addEventListener('click', async () => {
      const fallosEnvio = borradorActual ? validarBorrador(borradorActual) : [];
      if (!borradorActual || fallosEnvio.length > 0) {
        if (fallosEnvio.length > 0) anunciaCopia(fallosEnvio.map((f) => f.mensaje).join(' '), false);
        enfocaFallo(fallosEnvio.length > 0 ? fallosEnvio : [{ hueco: 'nombre', mensaje: '' }]);
        return;
      }
      if (!(btnEnviar instanceof HTMLButtonElement)) return;
      btnEnviar.disabled = true;
      avisaEnviado('Enviando…', true);
      try {
        const res = await fetch('/api/oficina/borrador', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(borradorActual),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data?.error?.message || ('Error ' + res.status));
        avisaEnviado('¡Recibido! Un consultor te va a contactar. (Lead #' + data.lead_id + ')', true);
      } catch (err) {
        avisaEnviado('No se pudo enviar: ' + (err?.message || 'error de red') + '. Probá por WhatsApp.', false);
      } finally {
        btnEnviar.disabled = false;
      }
    });

    // G2: cotización contra Odoo (panel aditivo; el cálculo local no cambia)
    const btnCotizar = root.querySelector('[data-cotizar]');
    const cajaCotizacion = root.querySelector('[data-cotizacion]');
    const formatoUSD = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'USD' });
    function pintaCotizacion(nodo) {
      if (!(cajaCotizacion instanceof HTMLElement)) return;
      cajaCotizacion.innerHTML = '';
      cajaCotizacion.appendChild(nodo);
    }
    function lineaCotizacion(texto, negrita) {
      const p = document.createElement('p');
      if (negrita) p.className = 'font-semibold';
      p.textContent = texto;
      return p;
    }
    btnCotizar?.addEventListener('click', async () => {
      if (!borradorActual) return;
      if (!(btnCotizar instanceof HTMLButtonElement)) return;
      btnCotizar.disabled = true;
      pintaCotizacion(lineaCotizacion('Cotizando…'));
      try {
        const res = await fetch('/api/oficina/cotizar', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            modulos: [...borradorActual.modulos_ancla, ...borradorActual.modulos_futuros],
            rubro: borradorActual.prospecto?.rubro || 'retail',
            sku_count: borradorActual.datos?.productos_aprox || 0,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data?.error?.message || ('Error ' + res.status));
        const q = data.quote ?? {};
        const caja = document.createElement('div');
        const precio = q.precio ?? {};
        if (typeof precio.ancla === 'number') {
          caja.appendChild(lineaCotizacion('Precio ancla: ' + formatoUSD.format(precio.ancla) + ' (validez ' + (precio.validez_dias ?? '—') + ' días)', true));
        }
        if (typeof precio.anticipo_neto === 'number') {
          caja.appendChild(lineaCotizacion('Anticipo neto: ' + formatoUSD.format(precio.anticipo_neto)));
        }
        for (const w of q.warnings ?? []) caja.appendChild(lineaCotizacion('• ' + String(w)));
        for (const e of q.errors ?? []) {
          const p = lineaCotizacion('• ' + String(e), true);
          p.classList.add('oficina-error');
          caja.appendChild(p);
        }
        if (!(q.errors ?? []).length && !(q.warnings ?? []).length) {
          caja.appendChild(lineaCotizacion('Validado por el servidor, sin observaciones.'));
        }
        pintaCotizacion(caja);
      } catch (err) {
        pintaCotizacion(lineaCotizacion('No se pudo validar en el servidor (' + (err?.message || 'error de red') + '); el cálculo local sigue valiendo.'));
      } finally {
        btnCotizar.disabled = false;
      }
    });

    // Chat unificado: un solo hilo. Las preguntas libres van a POST
    // /api/oficina/chat y se responden en la conversación sin avanzar el paso
    // (ver convPreguntaLibre junto al motor de conversación).

    // Restaura lo guardado en este navegador
    try {
      const previo = cargarBorrador();
      if (previo) {
        const setT = (sel, v) => { const el = root.querySelector(sel); if (el instanceof HTMLInputElement) el.value = v ?? ''; };
        const setB = (sel, v) => { const el = root.querySelector(sel); if (el instanceof HTMLInputElement) el.checked = !!v; };
        const setN = (sel, v) => { const el = root.querySelector(sel); if (el instanceof HTMLInputElement) el.value = String(v ?? el.value); };
        const p = previo.prospecto ?? {};
        setT('[data-prospecto="nombre"]', p.nombre); setT('[data-prospecto="contacto_nombre"]', p.contacto_nombre);
        setT('[data-prospecto="telefono"]', p.telefono); setT('[data-prospecto="email"]', p.email);
        setT('[data-prospecto="rubro"]', p.rubro);
        setN('[data-prospecto="sucursales"]', p.sucursales); setN('[data-prospecto="cajas"]', p.cajas); setN('[data-prospecto="usuarios"]', p.usuarios);
        const o = previo.objetos ?? {};
        setN('[data-obj="mostrador-3d"][data-campo="cajas"]', o['mostrador-3d']?.cajas);
        setB('[data-obj="mostrador-3d"][data-campo="descuento"]', o['mostrador-3d']?.descuento);
        setN('[data-obj="estanteria-3d"][data-campo="almacenes"]', o['estanteria-3d']?.almacenes);
        setB('[data-obj="estanteria-3d"][data-campo="ubicaciones"]', o['estanteria-3d']?.ubicaciones);
        setN('[data-obj="gondola-3d"][data-campo="listas_precio"]', o['gondola-3d']?.listas_precio);
        setN('[data-obj="computadora-3d"][data-campo="proveedores"]', o['computadora-3d']?.proveedores);
        setB('[data-obj="computadora-3d"][data-campo="orden_compra"]', o['computadora-3d']?.orden_compra);
        const comp = new Set(o['pizarron-fiscal-3d']?.comprobantes ?? []);
        root.querySelectorAll('[data-obj="pizarron-fiscal-3d"][data-campo="comprobantes"]').forEach((el) => {
          if (el instanceof HTMLInputElement) el.checked = comp.has(el.value);
        });
        setT('[data-obj="pizarron-fiscal-3d"][data-campo="contador"]', o['pizarron-fiscal-3d']?.contador);
        setN('[data-obj="zona-logistica-3d"][data-campo="envios_dia"]', o['zona-logistica-3d']?.envios_dia);
        setB('[data-obj="zona-logistica-3d"][data-campo="flota_propia"]', o['zona-logistica-3d']?.flota_propia);
        setT('[data-obj="zona-logistica-3d"][data-campo="zonas"]', o['zona-logistica-3d']?.zonas);
        if ((previo.modulos_futuros ?? []).includes('logistica')) logiResp = ['si', null, null];
        const fut = new Set([...(previo.modulos_futuros ?? []), ...(o['puerta-crecer-3d']?.futuros ?? [])]);
        root.querySelectorAll('[data-futuro]').forEach((el) => {
          if (el instanceof HTMLInputElement) el.checked = fut.has(el.getAttribute('data-futuro'));
        });
        const ancla = new Set(previo.modulos_ancla ?? []);
        const mapaIncluir = { 'mostrador-3d': 'mostrador', 'estanteria-3d': 'deposito', 'gondola-3d': 'ventas', 'computadora-3d': 'compras', 'pizarron-fiscal-3d': 'fiscal_ar' };
        for (const [id, mod] of Object.entries(mapaIncluir)) setB(`[data-incluir="${id}"]`, ancla.has(mod));
        const d = previo.datos ?? {};
        setN('[data-dato="productos_aprox"]', d.productos_aprox); setB('[data-dato="tiene_excel"]', d.tiene_excel);
        const inf = previo.infra ?? {};
        setB('[data-infra="hosting_propio"]', inf.hosting_propio); setB('[data-infra="dominio_ssl"]', inf.dominio_ssl); setB('[data-infra="backups"]', inf.backups);
      }
    } catch { /* borrador corrupto: se ignora y se empieza de cero */ }

    // Conversación guiada (Paso 1 humanizado): pregunta los datos de a uno,
    // escribe en los mismos inputs ocultos y llama a pinta() en cada respuesta.
    // Nada sale del navegador hasta Enviar/WhatsApp; la IA libre sigue aparte.
    const convHilo = root.querySelector('[data-chat-hilo]');
    const convOpc = root.querySelector('[data-chat-opciones]');
    const convForm = root.querySelector('[data-chat-form]');
    const convMsg = root.querySelector('[data-chat-msg]');
    const convGet = (sel) => root.querySelector(sel);
    const convSetT = (sel, v) => { const el = convGet(sel); if (el instanceof HTMLInputElement || el instanceof HTMLSelectElement) el.value = v; };
    const convSetB = (sel, v) => { const el = convGet(sel); if (el instanceof HTMLInputElement) el.checked = !!v; };
    const convValT = (sel) => { const el = convGet(sel); return el instanceof HTMLInputElement || el instanceof HTMLSelectElement ? el.value.trim() : ''; };
    const convValB = (sel) => { const el = convGet(sel); return el instanceof HTMLInputElement ? el.checked : false; };
    const convEnviarBtn = convForm instanceof HTMLFormElement ? convForm.querySelector('button[type="submit"]') : null;
    // El botón Enviar muta a CTA verde de WhatsApp cuando el cuestionario termina.
    function pintaBotonEnviar(modo) {
      if (!(convEnviarBtn instanceof HTMLButtonElement)) return;
      if (modo === 'whatsapp') {
        convEnviarBtn.dataset.modo = 'whatsapp';
        convEnviarBtn.textContent = 'Enviar por WhatsApp';
