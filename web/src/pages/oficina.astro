      return [{
        id: 'crecer', pregunta: '¿Para dónde querés crecer? Tocá todo lo que te sirva y después “Listo”. (A desarrollar, a cotizar.)', tipo: 'multi',
        opciones: FUT_OPTS,
        get: () => FUT_OPTS.map((o) => o.valor).filter(convFuturo),
        set: (arr) => { FUT_OPTS.forEach((o) => convSetFuturo(o.valor, arr.includes(o.valor))); },
      }];
    }
    const cola = [...PASOS_CONV];
    let convAnclaLista = false;
    let convAnclaIntro = false;
    function convAseguraCola() {
      if (convAnclaLista) return;
      convAnclaLista = true;
      cola.push(...armarAncla(), ...armarLogistica(), ...armarCrecer());
    }
    function convReiniciar() {
      cola.length = 0;
      logiResp = [null, null, null];
      cola.push(...PASOS_CONV, ...armarAncla(), ...armarLogistica(), ...armarCrecer());
      convAnclaLista = true;
      convAnclaIntro = false;
      convPaso = 0;
      convPreguntar();
    }
    convAseguraCola();
    function convNormalizaSiNo(t) {
      const v = t.trim().toLowerCase();
      if (['si', 'sí', 's', 'yes', 'y', '1'].includes(v)) return 'si';
      if (['no', 'n', '0', 'nop'].includes(v)) return 'no';
      return null;
    }
    function convPintaMulti(p) {
      if (!(convOpc instanceof HTMLElement)) return;
      convOpc.innerHTML = '';
      for (const op of p.opciones) {
        const on = p.sel.has(op.valor);
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = (on ? '✓ ' : '') + op.etiqueta;
        b.className = 'rounded-full border px-4 py-2 text-sm font-semibold' + (on ? ' border-transparent bg-[var(--color-star-warm)] text-space-void' : ' border-white/30 bg-white/[0.06] text-white');
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.addEventListener('click', () => {
          if (p.sel.has(op.valor)) p.sel.delete(op.valor);
          else p.sel.add(op.valor);
          convPintaMulti(p);
        });
        convOpc.appendChild(b);
      }
      const listo = document.createElement('button');
      listo.type = 'button';
      listo.textContent = 'Listo (' + p.sel.size + ') →';
      listo.className = 'rounded-full border border-transparent bg-[var(--color-star-warm)] px-4 py-2 text-sm font-semibold text-space-void';
      listo.addEventListener('click', () => convResponder('__listo'));
      convOpc.appendChild(listo);
    }
    function convPreguntar() {
      // Salta lo ya cargado (restaurado del navegador).
      while (convPaso < cola.length) {
        const p = cola[convPaso];
        const actual = p.get();
        if (p.tipo === 'texto' && actual) { convPaso += 1; continue; }
        if (p.tipo === 'numero' && actual !== '' && actual !== String(p.defecto)) { convPaso += 1; continue; }
        break;
      }
      // Puerta al ancla: valida contacto y presenta el Paso 2.
      if (convPaso === FIN_PASO1 && !convAnclaIntro) {
        const tel = convValT('[data-prospecto="telefono"]');
        const mail = convValT('[data-prospecto="email"]');
        if (!tel && !mail) {
          convBurbuja('bot', 'Necesito al menos un contacto: ¿teléfono o email? Empecemos de nuevo por el teléfono.');
          convPaso = 2;
          return convPreguntar();
        }
        convBurbuja('bot', '¡Genial! Ahora armemos tu ancla: te pregunto qué necesitás hoy, lo de todos los días.');
        convAnclaIntro = true;
      }
      if (convPaso >= cola.length) {
        pinta();
        const bFin = borradorActual ?? construirBorrador(leeEstado());
        const nombre = bFin.prospecto.nombre || 'tu negocio';
        const anclaMostrar = bFin.modulos_ancla.filter((k) => !SIEMPRE.includes(k)).map((k) => NOMBRES[k] ?? k);
        const futEtiq = new Map([...FUT_OPTS.map((o) => [o.valor, o.etiqueta]), ['logistica', 'Logística']]);
        const futMostrar = bFin.modulos_futuros.map((k) => futEtiq.get(k) ?? NOMBRES[k] ?? k);
        const anclaTxt = anclaMostrar.join(', ') || '—';
        const futTxt = futMostrar.join(', ') || '—';
        convBurbuja('bot', '¡Listo ' + nombre + '! Tu borrador: ancla ' + anclaTxt + ' · para crecer: ' + futTxt + '. Tocá el botón verde para enviarlo por WhatsApp.');
        convOpciones([{ etiqueta: 'Enviar por WhatsApp', valor: '__whatsapp' }, { etiqueta: 'Ir al Paso 2', valor: '__paso:1' }, { etiqueta: 'Ir al Paso 3 (enviar)', valor: '__paso:2' }, { etiqueta: 'Repasar', valor: '__reiniciar' }]);
        pintaBotonEnviar('whatsapp');
        return;
      }
      const p = cola[convPaso];
      pintaBotonEnviar('chat');
      if (p.tipo === 'multi') {
        convBurbuja('bot', p.pregunta);
        p.sel = new Set(p.get());
        convPintaMulti(p);
        const input = root.querySelector('[data-chat-msg]');
        if (input instanceof HTMLElement) input.focus({ preventScroll: true });
        return;
      }
      convBurbuja('bot', p.pregunta);
      if (p.tipo === 'sino') convOpciones([{ etiqueta: 'Sí', valor: 'si' }, { etiqueta: 'No', valor: 'no' }]);
      else if (p.tipo === 'opciones') convOpciones(p.opciones);
      else if (p.saltear) convOpciones([{ etiqueta: 'Saltear', valor: '__saltar' }]);
      else convOpciones([]);
      const input = root.querySelector('[data-chat-msg]');
      if (input instanceof HTMLElement) input.focus({ preventScroll: true });
    }
    // Preguntas libres en el mismo hilo: van a la IA sin avanzar el paso.
    let iaHistorialLibre = [];
    function esPreguntaLibre(t, p) {
      if (!t || t.startsWith('__')) return false;
      if (p?.tipo === 'sino' && convNormalizaSiNo(t)) return false;
      if (p?.tipo === 'opciones' && p.opciones.some((o) => o.valor === t)) return false;
      if (p?.tipo === 'numero' && (t === '' || /^-?\d[\d.,]*$/.test(t))) return false;
      if (p?.tipo === 'email' && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(t)) return false;
      if (p?.tipo === 'tel' && (t.replace(/\D/g, '').length >= 6 || t === '')) return false;
      if (/\?\s*$/.test(t)) return true;
      return /^(qu[eé]|c[oó]mo|cu[aá]ndo|d[oó]nde|cu[aá]nto|por\s*qu[eé]|incluye|incluyen|precio|cuesta|cuestan|sirve|sirven|pod[eé]s|pued[eo]|pueden|hay|tien[ee]n?|hac[eé]s|hacen|para\s*qu[eé])/i.test(t);
    }
    async function convPreguntaLibre(textoMsg) {
      iaHistorialLibre = [...iaHistorialLibre.slice(-10), { role: 'user', text: textoMsg }];
      convBurbuja('user', textoMsg);
      convBurbuja('bot', 'Ya te averiguo…');
      const items = convHilo instanceof HTMLElement ? convHilo.querySelectorAll('p') : [];
      const espera = items.length ? items[items.length - 1] : null;
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 15000);
      const responde = (texto) => { if (espera) espera.textContent = texto; else convBurbuja('bot', texto); };
      try {
        const res = await fetch('/api/oficina/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ message: textoMsg.slice(0, 2000), history: iaHistorialLibre.slice(0, -1) }),
          signal: ctrl.signal,
        });
        clearTimeout(timer);
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          const fuente = ['estatica', 'ollama', 'mock'].includes(String(data.source ?? '')) ? ' · ' + data.source : '';
          responde(String(data.reply) + fuente);
          iaHistorialLibre = [...iaHistorialLibre.slice(-10), { role: 'assistant', text: String(data.reply) }];
        } else if (res.status === 429) {
          responde('Demasiadas consultas por ahora: sigamos con tu borrador.');
        } else {
          throw new Error('ia');
        }
      } catch {
        clearTimeout(timer);
        responde('La IA no responde ahora: sigamos con tu borrador, está a salvo.');
      }
      convPreguntar();
    }
    function abrirWhatsAppFinal() {
      pinta();
      const b = borradorActual ?? construirBorrador(leeEstado());
      if (validarBorrador(b).length > 0) {
        convBurbuja('bot', 'Te falta nombre y un contacto para enviarlo: completalos y lo mandamos por WhatsApp.');
        enfocaNombre();
        return;
      }
      convBurbuja('bot', 'Abriendo WhatsApp con tu cuestionario hecho…');
      window.open(enlaceWhatsApp(mensajeWhatsApp(b)), '_blank', 'noopener');
    }
    function convResponder(crudo) {
      const p = cola[convPaso];
      if (!p) {
        const tFin = String(crudo ?? '').trim();
        if (tFin === '__seguir') { irAPaso(paso + 1); return; }
        if (tFin === '__reiniciar') { convReiniciar(); return; }
        if (tFin === '__whatsapp' || tFin === '') { abrirWhatsAppFinal(); return; }
        if (typeof tFin === 'string' && tFin.startsWith('__paso:')) {
          irAPaso(Number(tFin.split(':')[1]) || 0);
          return;
        }
        if (esPreguntaLibre(tFin, undefined)) { convPreguntaLibre(tFin); return; }
        abrirWhatsAppFinal();
        return;
      }
      const t = String(crudo ?? '').trim();
      if (t === '__seguir') { irAPaso(paso + 1); return; }
      if (t === '__reiniciar') { convReiniciar(); return; }
      if (t === '__whatsapp') { abrirWhatsAppFinal(); return; }
      if (t.startsWith('__paso:')) {
        irAPaso(Number(t.split(':')[1]) || 0);
        return;
      }
      if (t && esPreguntaLibre(t, p)) { convPreguntaLibre(t); return; }
      if (p.tipo === 'multi') {
        if (t === '__listo') {
          const elegidos = [...p.sel];
          p.set(elegidos);
          const nombres = elegidos.map((v) => p.opciones.find((o) => o.valor === v)?.etiqueta ?? v);
          convBurbuja('user', nombres.length ? nombres.join(' · ') : 'Nada por ahora');
          convPaso += 1;
          pinta();
          return convPreguntar();
        }
        convBurbuja('bot', 'Tocá las opciones que correspondan y después “Listo”, dale.');
        return;
      }
      if (t === '__saltar') {
        if (p.tipo === 'numero') p.set(p.defecto);
        convBurbuja('user', 'Saltear');
        convPaso += 1;
        pinta();
        return convPreguntar();
      }
      if (p.tipo === 'texto') {
        if (!t) { convBurbuja('bot', p.req ? 'Contame al menos 2 letras, dale.' : 'Si no querés, tocá “Saltear”.'); return; }
        if (p.req && t.length < 2) { convBurbuja('bot', 'Contame al menos 2 letras, dale.'); return; }
        p.set(t);
        convBurbuja('user', t);
      } else if (p.tipo === 'tel') {
        if (!t) { convBurbuja('bot', 'Escribí el teléfono o “saltear”.'); return; }
        const digitos = t.replace(/\D/g, '');
        if (digitos.length > 0 && digitos.length < 6) { convBurbuja('bot', 'Ese teléfono parece corto, ¿lo revisamos?'); return; }
        if (!digitos) p.set('');
        else p.set(t);
        convBurbuja('user', t);
      } else if (p.tipo === 'email') {
        if (!t) { convBurbuja('bot', 'Escribí el email o “saltear”.'); return; }
        if (t && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(t)) { convBurbuja('bot', 'Ese email no me cierra, ¿lo revisamos?'); return; }
        p.set(t);
        convBurbuja('user', t);
      } else if (p.tipo === 'numero') {
        if (t === '') { p.set(p.defecto); convBurbuja('user', 'Usar ' + p.defecto); }
        else {
          const n = Number(t.replace(',', '.'));
          if (!Number.isFinite(n) || n < 0) { convBurbuja('bot', 'Probá con un número (0 o más).'); return; }
          p.set(Math.floor(n));
          convBurbuja('user', String(Math.floor(n)));
        }
      } else if (p.tipo === 'sino' || p.tipo === 'opciones') {
        const norm = p.tipo === 'sino' ? convNormalizaSiNo(t) : t;
        const valido = p.tipo === 'sino' ? (norm === 'si' || norm === 'no') : p.opciones.some((o) => o.valor === t);
        if (!valido) { convBurbuja('bot', 'Elegí una de las opciones, dale.'); return; }
        p.set(norm ?? t);
        const etiqueta = p.tipo === 'sino' ? (norm === 'si' ? 'Sí' : 'No') : (p.opciones.find((o) => o.valor === t)?.etiqueta ?? t);
        convBurbuja('user', etiqueta);
        if (norm === 'si' && p.luegoSi?.length) cola.splice(convPaso + 1, 0, ...p.luegoSi);
      }
      convPaso += 1;
      pinta();
      convPreguntar();
    }
    convForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!(convMsg instanceof HTMLInputElement) && !(convMsg instanceof HTMLTextAreaElement)) return;
      const v = convMsg.value;
      convMsg.value = '';
      // Cuestionario terminado: el botón verde abre WhatsApp directo, sin parser.
      if (convEnviarBtn instanceof HTMLButtonElement && convEnviarBtn.dataset.modo === 'whatsapp') {
        if (v.trim() && esPreguntaLibre(v.trim(), undefined)) { convPreguntaLibre(v.trim()); return; }
        abrirWhatsAppFinal();
        return;
      }
      convResponder(v);
    });
    // Enter envía, Shift+Enter salta de línea.
    convMsg?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        convForm?.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    });

    // Wizard
    let paso = 0;
    function pintaPaso() {
      root.querySelectorAll('[data-panel]').forEach((p) => {
        if (p instanceof HTMLElement) p.hidden = p.getAttribute('data-panel') !== String(paso);
      });
      root.querySelectorAll('[data-paso]').forEach((b) => {
        if (b instanceof HTMLElement) b.classList.toggle('font-semibold', b.getAttribute('data-paso') === String(paso));
      });
    }
    function irAPaso(n) {
      paso = Math.max(0, Math.min(2, n));
      pintaPaso();
    }
    root.querySelectorAll('[data-paso]').forEach((b) => {
      b.addEventListener('click', () => irAPaso(Number(b.getAttribute('data-paso')) || 0));
    });
    // Navegación entre paneles solo desde el chat (irAPaso directo).

    // Hero 3D → ficha (click en mueble tilda y baja a la ficha).
    // S5: el objeto vive en ?objeto= para compartir y refrescar (deep-link).
    function irAFicha(id) {
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('objeto', id);
        window.history.replaceState(null, '', url);
      } catch { /* sin URL disponible: se sigue sin deep-link */ }
      const card = root.querySelector(`[data-ficha="${id}"]`);
      if (id !== 'puerta-crecer-3d') {
        const check = root.querySelector(`[data-incluir="${id}"]`);
        if (check instanceof HTMLInputElement && !check.checked) {
          check.checked = true;
          pinta();
        }
      } else {
        irAPaso(2);
      }
      if (card instanceof HTMLElement) {
        desplaza(card);
        card.classList.add('ficha-flash');
        setTimeout(() => card.classList.remove('ficha-flash'), 1600);
      }
    }
    const heroCanvas = root.querySelector('[data-hero-canvas]');
    const heroCapa = root.querySelector('[data-hero-etiquetas]');
    const heroFallback = root.querySelector('[data-hero-fallback]');
    const heroEstado = root.querySelector('[data-hero-estado]');
    root.querySelectorAll('[data-hero-fallback-btn]').forEach((b) => {
      b.addEventListener('click', () => {
        const id = b.getAttribute('data-hero-fallback-btn');
        if (typeof id === 'string') irAFicha(id);
      });
    });
    if (heroCanvas instanceof HTMLCanvasElement && !heroCanvas.dataset.mounted) {
      const io = new IntersectionObserver(async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        try {
          const { mountOficinaScene } = await import('../scripts/oficina-scene');
          const cleanup = mountOficinaScene(
            heroCanvas,
            (id) => irAFicha(id),
            heroCapa instanceof HTMLElement ? heroCapa : undefined,
          );
          window.addEventListener('pagehide', cleanup, { once: true });
          document.addEventListener('astro:before-swap', cleanup, { once: true });
          if (heroEstado) heroEstado.textContent = 'Escena 3D activa: click en un mueble para ir a su ficha.';
        } catch {
          heroCanvas.style.display = 'none';
          if (heroCapa instanceof HTMLElement) heroCapa.style.display = 'none';
          if (heroFallback instanceof HTMLElement) heroFallback.hidden = false;
          if (heroEstado) heroEstado.textContent = 'Sin WebGL: usá el plano para ir a cada ficha.';
        }
      }, { rootMargin: '200px' });
      io.observe(heroCanvas);
    }

    pintaPaso();
    pinta();
    convPreguntar();
    // Ruta predeterminada: el chat con la IA (Paso 1). Si la URL trae
    // ?objeto= de una sesión anterior, se limpia para no revivir ese panel.
    // El click en un mueble sigue fijando ?objeto= para compartir en sesión.
    try {
      const url = new URL(window.location.href);
      if (url.searchParams.has('objeto')) {
        url.searchParams.delete('objeto');
        window.history.replaceState(null, '', url);
      }
    } catch { /* sin URL disponible: se arranca en paso 0 */ }
  }
</script>
