      const v = convMsg.value;
      convMsg.value = '';
      // Cuestionario terminado: el botón verde abre WhatsApp directo, sin parser.
      if (convEnviarBtn instanceof HTMLButtonElement && convEnviarBtn.dataset.modo === 'whatsapp') {
        if (v.trim() && esPreguntaLibre(v.trim(), undefined)) { convPreguntaLibre(v.trim()); return; }
        abrirWhatsAppFinal();
        return;
      }
      convResponder(v);
    });
    // Enter envía, Shift+Enter salta de línea.
    convMsg?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        convForm?.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    });

    // Wizard
    let paso = 0;
    try {
      const inicial = Number(new URL(window.location.href).searchParams.get('paso'));
      if (inicial === 1 || inicial === 2) paso = inicial;
    } catch { /* sin URL: se arranca en el paso 0 */ }
    function pintaPaso() {
      const ease = getComputedStyle(root).getPropertyValue('--mo-ease-out').trim() || 'ease';
      root.querySelectorAll('[data-panel]').forEach((p) => {
        if (!(p instanceof HTMLElement)) return;
        const mostrar = p.getAttribute('data-panel') === String(paso);
        const estabaOculto = p.classList.contains('oficina-panel--oculto');
        p.classList.toggle('oficina-panel--oculto', !mostrar);
        if (!(mostrar && estabaOculto) || reduceMovimiento) return;
        p.getAnimations().forEach((a) => a.cancel());
        p.animate(
          [{ opacity: 0 }, { opacity: 1 }],
          { duration: 150, easing: ease, fill: 'both' },
        );
      });
      root.querySelectorAll('[data-paso]').forEach((b) => {
        if (!(b instanceof HTMLElement)) return;
        const on = b.getAttribute('data-paso') === String(paso);
        if (on) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
    }
    function irAPaso(n) {
      paso = Math.max(0, Math.min(2, n));
      pintaPaso();
      try {
        const url = new URL(window.location.href);
        if (paso === 0) url.searchParams.delete('paso');
        else url.searchParams.set('paso', String(paso));
        window.history.replaceState(null, '', url);
      } catch { /* sin URL: el paso queda solo en memoria */ }
    }
    root.querySelectorAll('[data-paso]').forEach((b) => {
      b.addEventListener('click', () => irAPaso(Number(b.getAttribute('data-paso')) || 0));
    });
    // Tabs y chat llaman a irAPaso. El paso queda en ?paso=.

    // Sector → ficha (sin escena 3D). S5: ?objeto= para compartir/refrescar.
    const PANEL_FICHA = {
      'mostrador-3d': 1,
      'estanteria-3d': 1,
      'gondola-3d': 1,
      'computadora-3d': 1,
      'pizarron-fiscal-3d': 1,
      'puerta-crecer-3d': 2,
      'zona-logistica-3d': 2,
    };
    function marcaSector(id) {
      root.querySelectorAll('[data-hero-sector]').forEach((b) => {
        if (!(b instanceof HTMLElement)) return;
        b.setAttribute('aria-pressed', b.getAttribute('data-hero-sector') === id ? 'true' : 'false');
      });
    }
    function irAFicha(id) {
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('objeto', id);
        window.history.replaceState(null, '', url);
      } catch { /* sin URL disponible: se sigue sin deep-link */ }
      marcaSector(id);
      irAPaso(PANEL_FICHA[id] ?? 1);
      const card = root.querySelector(`[data-ficha="${id}"]`);
      if (id !== 'puerta-crecer-3d' && id !== 'zona-logistica-3d') {
        const check = root.querySelector(`[data-incluir="${id}"]`);
        if (check instanceof HTMLInputElement && !check.checked) {
          check.checked = true;
          pinta();
        }
      }
      if (card instanceof HTMLElement) {
        desplaza(card, "zona");
        card.classList.add('ficha-flash');
        setTimeout(() => card.classList.remove('ficha-flash'), 1600);
      }
    }
    root.querySelectorAll('[data-hero-sector]').forEach((b) => {
      b.addEventListener('click', () => {
        const id = b.getAttribute('data-hero-sector');
        if (typeof id === 'string') irAFicha(id);
      });
    });

    pintaPaso();
    pinta();
    convPreguntar();
    // Chat primero. Si la URL trae ?objeto= de una sesión anterior, se limpia.
    try {
      const url = new URL(window.location.href);
      if (url.searchParams.has('objeto')) {
        url.searchParams.delete('objeto');
        window.history.replaceState(null, '', url);
      }
    } catch { /* sin URL disponible: se arranca en paso 0 */ }
  }
</script>
