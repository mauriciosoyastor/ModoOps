---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import Solution from '../components/sections/Solution.astro';
import Path from '../components/sections/Path.astro';
import PathNebula from '../components/sections/PathNebula.astro';
import SupportModel from '../components/sections/SupportModel.astro';
import Audience from '../components/sections/Audience.astro';
import HowWeWork from '../components/sections/HowWeWork.astro';
import Faq from '../components/sections/Faq.astro';
import Contact from '../components/sections/Contact.astro';
import { publicPricing, brand } from '../data/business';

const title = `${brand.name} — ${brand.tagline}`;
const description = `Implementación Odoo para retail en Argentina. Descubrimiento ${publicPricing.discovery.amount} · PYME, una sucursal, caja y stock integrados.`;
---

<BaseLayout {title} {description}>
  <main>
    <Hero />
    <Problem />
    <Solution />
    <Path />
    <PathNebula />
    <SupportModel />
    <Audience />
    <HowWeWork />
    <Faq />
    <Contact />
  </main>
</BaseLayout>
