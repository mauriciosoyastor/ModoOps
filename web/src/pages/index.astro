---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import Solution from '../components/sections/Solution.astro';
import Path from '../components/sections/Path.astro';
import Discovery from '../components/sections/Discovery.astro';
import Audience from '../components/sections/Audience.astro';
import HowWeWork from '../components/sections/HowWeWork.astro';
import Contact from '../components/sections/Contact.astro';
import { publicPricing, brand } from '../data/business';

const title = `${brand.name} — ${brand.tagline}`;
const description = `ModoOps — Sistema de Gestión Modular para PYME Argentina. Descubrimiento ${publicPricing.discovery.amount} · una sucursal, caja y stock integrados.`;
---

<BaseLayout {title} {description}>
  <main>
    <Hero />
    <Problem />
    <Solution />
    <Path />
    <Discovery />
    <Audience />
    <HowWeWork />
    <Contact />
  </main>
</BaseLayout>
