---
// PROTOTYPE throwaway — shell empleado light operativo (4 votos 2026-09-22).
// "Tres variantes (?variant=sidebar|topbar|pos) light #fbfbf9 + tinta: A sidebar+tabla,
//  B topbar+command+tareas, C POS 2col + side panel cobro. Sin saldo hero, sin bottomnav."
// Decisión A reabierta solo para app (landing sigue dark). No enlazar desde prod. Sin persistencia.
// Run: dev web/ → /prototype/shell-empleado?variant=sidebar
import '../../styles/global.css';
const variant = Astro.url.searchParams.get('variant') ?? 'sidebar';
const order = ['sidebar', 'topbar', 'pos'];
const labels: Record<string, string> = {
  sidebar: 'A · Sidebar + tabla',
  topbar: 'B · Topbar + tareas',
  pos: 'C · POS 2 col + panel',
};
const pendientes = [
  { label: 'Facturas por revisar', n: 3 },
  { label: 'Leads por contactar', n: 7 },
  { label: 'Quiebres de stock', n: 5 },
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="PROTOTYPE descartable: shell empleado light operativo." />
    <meta name="theme-color" content="#fbfbf9" />
    <title>PROTOTYPE — Shell empleado light</title>
    <style>
      html { color-scheme: light; }
      body { background: #fbfbf9; color: #211922; }
      .proto-switcher {
        position: fixed; left: 50%; bottom: 1rem; transform: translateX(-50%);
        z-index: 100; display: flex; align-items: center; gap: 0.75rem;
        background: #211922; color: #fff; border-radius: 999px;
        padding: 0.4rem 0.6rem; box-shadow: 0 4px 24px rgb(0 0 0 / 0.25);
        font-size: 0.875rem; font-weight: 600;
      }
      .proto-switcher button {
        border-radius: 999px; min-width: 44px; min-height: 44px;
        padding: 0 0.9rem; font-weight: 700;
        transition: background-color 0.15s ease, color 0.15s ease;
      }
      .proto-switcher button:hover { background: #fff; color: #211922; }
      .card { background: #fff; border: 1px solid #e5e5e0; border-radius: 12px; }
      .kpi { background: #fff; border: 1px solid #e5e5e0; border-radius: 12px; padding: 0.7rem 0.9rem; }
      .kpi strong { display: block; font-size: 1.15rem; }
      .chip { display: inline-block; border-radius: 999px; padding: 0.1rem 0.6rem;
        font-size: 0.75rem; border: 1px solid #c05a42; color: #9a3a28; }
      .chip-ok { border-color: #02a745; color: #026b2e; }
      .btn-ink { display: inline-flex; align-items: center; justify-content: center;
        background: #211922; color: #fff; border-radius: 999px; padding: 0.9rem 1.4rem;
        font-weight: 600; min-height: 44px;
        transition: background-color 0.15s ease, opacity 0.15s ease; }
      .btn-ink:hover { opacity: 0.88; }
      .btn-line { display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid #211922; color: #211922; border-radius: 999px; padding: 0.9rem 1.4rem;
        font-weight: 600; min-height: 44px; background: transparent;
        transition: background-color 0.15s ease, color 0.15s ease; }
      .side-link { display: block; border-radius: 8px; padding: 0.55rem 0.75rem; color: #525769;
        transition: background-color 0.15s ease, color 0.15s ease; }
      .side-link:hover, .side-link[aria-current="page"] { background: #211922; color: #fff; }
      table.ops { width: 100%; border-collapse: collapse; font-size: 0.875rem; background: #fff; }
      table.ops th, table.ops td { padding: 0.55rem 0.75rem; border-top: 1px solid #e5e5e0; text-align: left; }
      table.ops thead th { border-top: 0; color: #525769; font-weight: 600; position: sticky; top: 0; background: #fff; }
      table.ops td.num, table.ops th.num { text-align: right; }
      :focus-visible { outline: 2px solid #211922; outline-offset: 2px; }
    </style>
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded-full focus:bg-black focus:px-4 focus:py-2 focus:text-white">Saltar al contenido</a>
    <p style="margin: 1rem auto 0; max-width: 70rem; padding: 0 1.5rem;">
      <span class="inline-block rounded-full border border-dashed border-[#525769] px-3 py-1 text-xs text-[#525769]">
        PROTOTYPE — shell light operativo (4 votos) · sin saldo hero, sin bottomnav · nada en prod
      </span>
    </p>

    <main id="contenido" class="mx-auto w-full max-w-[70rem] px-6 py-10 md:px-10">
      {variant === 'sidebar' && (
        <div class="grid gap-4 md:grid-cols-[13rem_1fr]">
          <nav aria-label="Módulos" class="card p-3">
            <p class="px-2 py-1 text-xs font-semibold uppercase tracking-widest text-[#525769]">Panadería Sur · Caja 1</p>
            <a class="side-link" href="#" aria-current="page">Cobrar</a>
            <a class="side-link" href="#">Ventas de caja</a>
            <a class="side-link" href="#">Stock</a>
            <a class="side-link" href="#">Compras</a>
            <a class="side-link" href="#">Por cobrar</a>
            <a class="side-link" href="#">Turno y cierre</a>
          </nav>
          <section aria-label="Ventas de caja">
            <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
              <div class="kpi"><span class="text-xs text-[#525769]">Ventas hoy</span><strong class="tabular-nums">128</strong></div>
              <div class="kpi"><span class="text-xs text-[#525769]">vs ayer</span><strong class="tabular-nums">+25 %</strong></div>
              <div class="kpi"><span class="text-xs text-[#525769]">Por cobrar</span><strong class="tabular-nums">3</strong></div>
              <div class="kpi"><span class="text-xs text-[#525769]">Quiebres</span><strong class="tabular-nums">5</strong></div>
            </div>
            <table class="ops card mt-3 overflow-hidden">
              <caption class="py-2 text-left text-sm text-[#525769]">showing 8 of 24 · filtros en URL</caption>
              <thead><tr><th>Comprobante</th><th>Estado</th><th class="num">Importe</th><th class="num">Acción</th></tr></thead>
              <tbody>
                <tr><td>A-1021 · mostrador</td><td><span class="chip">● Sin cobrar</span></td><td class="num tabular-nums">5.400</td><td class="num"><a class="underline" href="#">Cobrar</a></td></tr>
                <tr><td>A-1020 · mostrador</td><td><span class="chip chip-ok">● Cobrada</span></td><td class="num tabular-nums">2.100</td><td class="num"><a class="underline" href="#">Ver</a></td></tr>
                <tr><td>A-1019 · cta. cte.</td><td><span class="chip">● Vencida</span></td><td class="num tabular-nums">8.750</td><td class="num"><a class="underline" href="#">Cobrar</a></td></tr>
              </tbody>
            </table>
          </section>
        </div>
      )}

      {variant === 'topbar' && (
        <div>
          <div class="card flex flex-wrap items-center gap-3 px-4 py-3">
            <strong>Panadería Sur</strong><span class="text-sm text-[#525769]">Caja 1 · turno abierto 08:00</span>
            <label class="ml-auto flex items-center gap-2 text-sm">Comando <input type="search" placeholder="cobrar, stock, turno…" class="rounded-full border border-[#e5e5e0] bg-white px-3 py-2 text-sm" /></label>
          </div>
          <div class="mt-3 grid grid-cols-2 gap-3 md:grid-cols-4">
            <div class="kpi"><span class="text-xs text-[#525769]">Ventas hoy</span><strong class="tabular-nums">128</strong></div>
            <div class="kpi"><span class="text-xs text-[#525769]">Ticket medio</span><strong class="tabular-nums">14 u.</strong></div>
            <div class="kpi"><span class="text-xs text-[#525769]">Por cobrar</span><strong class="tabular-nums">3</strong></div>
            <div class="kpi"><span class="text-xs text-[#525769]">Quiebres</span><strong class="tabular-nums">5</strong></div>
          </div>
          <section aria-label="Tareas accionables" class="card mt-3 p-5">
            <h2 class="text-lg font-semibold">Tareas accionables</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {pendientes.map((p) => (
                <li class="flex items-center justify-between gap-3 rounded-lg bg-[#fbfbf9] px-4 py-3">
                  <span>{p.label} <span class="tabular-nums text-[#525769]">({p.n})</span></span>
                  <a class="underline" href="#">Resolver ›</a>
                </li>
              ))}
            </ul>
          </section>
        </div>
      )}

      {variant === 'pos' && (
        <div class="grid gap-4 md:grid-cols-[1fr_20rem]">
          <section aria-label="Grilla">
            <label class="flex items-center gap-2 text-sm">Buscar <input type="search" placeholder="producto…" class="w-full rounded-lg border border-[#e5e5e0] bg-white px-3 py-2" /></label>
            <div class="mt-3 grid grid-cols-3 gap-2 text-sm">
              <button type="button" class="card px-3 py-4 text-left font-medium">Pan casero<br /><span class="tabular-nums text-[#525769]">1.500</span></button>
              <button type="button" class="card px-3 py-4 text-left font-medium">Leche 1L<br /><span class="tabular-nums text-[#525769]">1.200</span></button>
              <button type="button" class="card px-3 py-4 text-left font-medium">Yerba 1kg<br /><span class="tabular-nums text-[#525769]">4.800</span></button>
            </div>
          </section>
          <aside aria-label="Ticket y cobro" class="card flex flex-col p-4">
            <h2 class="font-semibold">Ticket · siempre visible</h2>
            <ul class="mt-2 space-y-1 text-sm">
              <li class="flex justify-between"><span>Pan casero ×2</span><span class="tabular-nums">3.000</span></li>
              <li class="flex justify-between"><span>Leche ×2</span><span class="tabular-nums">2.400</span></li>
            </ul>
            <p class="mt-3 flex justify-between border-t border-[#e5e5e0] pt-3 text-lg font-semibold"><span>Total</span><span class="tabular-nums">5.400</span></p>
            <div class="mt-3 grid grid-cols-3 gap-2 text-sm" role="group" aria-label="Método">
              <button type="button" class="rounded-lg border border-[#211922] bg-[#211922] px-2 py-2 font-semibold text-white">QR</button>
              <button type="button" class="rounded-lg border border-[#e5e5e0] bg-white px-2 py-2">Efectivo</button>
              <button type="button" class="rounded-lg border border-[#e5e5e0] bg-white px-2 py-2">Tarjeta</button>
            </div>
            <p class="mt-3"><span class="btn-ink w-full">Cobrar · Enter</span></p>
            <p class="mt-2 text-xs text-[#525769]">Denominaciones + vuelto exacto · timeout 300s + reintento · Esc sale sin cerrar</p>
          </aside>
        </div>
      )}
    </main>

    <nav aria-label="Variantes del prototipo" class="proto-switcher">
      <button type="button" data-prev aria-label="Variante anterior">←</button>
      <span id="proto-label">{labels[variant] ?? variant} · {order.indexOf(variant) + 1}/{order.length}</span>
      <button type="button" data-next aria-label="Variante siguiente">→</button>
    </nav>

    <script>
      const order = ['sidebar', 'topbar', 'pos'];
      const get = () => new URLSearchParams(location.search).get('variant') ?? 'sidebar';
      const go = (v) => { const u = new URL(location.href); u.searchParams.set('variant', v); location.href = u.toString(); };
      const step = (d) => { const i = order.indexOf(get()); go(order[(i + d + order.length) % order.length]); };
      document.querySelector('[data-prev]')?.addEventListener('click', () => step(-1));
      document.querySelector('[data-next]')?.addEventListener('click', () => step(1));
      addEventListener('keydown', (e) => {
        const t = e.target;
        if (t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement || (t instanceof HTMLElement && t.isContentEditable)) return;
        if (e.key === 'ArrowLeft') step(-1);
        if (e.key === 'ArrowRight') step(1);
      });
    </script>
  </body>
</html>
