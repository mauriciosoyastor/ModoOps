---
// PROTOTYPE throwaway — ticket: Split chat/3D bidireccional (mapa oficina-chat-3d-whatsapp, T2).
// Pregunta que responde: ¿cómo se siente el split chat-izquierda / 3D-derecha con
// construcción en vivo y vuelta 3D→chat? Rama UI (page) con 2 densidades por ?layout=.
// No enlazar desde el portal (ruta descartable, no prod). Estado en memoria, sin
// persistencia (localStorage viene en el build real), sin tests, sin manejo de errores
// más allá de runnable. Al validar, plegar la decisión al código real y tirar el resto.
// Run: dev-server de web/ → /prototype/oficina-chat
import '../../styles/global.css';
import { OBJETO_LABEL, type Objeto3DId } from '../../lib/oficina-mapping';

const objetos: Objeto3DId[] = [
  'mostrador-3d',
  'estanteria-3d',
  'gondola-3d',
  'computadora-3d',
  'pizarron-fiscal-3d',
  'puerta-crecer-3d',
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="PROTOTYPE descartable: chat configurador con oficina 3D viva al lado." />
    <meta name="theme-color" content="#000000" />
    <title>PROTOTYPE — Chat + oficina viva</title>
    <style>
      html { color-scheme: dark; }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
      :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
      [id] { scroll-margin-top: 5rem; }
      .flash { outline: 2px solid #f5c518; outline-offset: 2px; }
      .msg-bot { border: 1px solid #333; border-radius: 0.75rem; padding: 0.6rem 0.8rem; }
      .hecho { border-color: #2b7a4b; }
    </style>
  </head>
  <body>
    <main class="mx-auto w-full max-w-6xl px-4 py-8" data-chatproto>
      <p class="rounded-full border border-dashed px-3 py-1 text-xs">
        PROTOTYPE descartable · T2 · borrador no vinculante · nada de acá crea tu sistema
      </p>
      <h1 class="mt-2 text-3xl font-semibold">Contanos tu negocio, mirá tu oficina</h1>
      <p class="mt-1 text-sm" data-progreso aria-live="polite">Paso 1 de 7 · Tu negocio</p>

      <div class="mt-4 grid gap-4" data-layout-wrap>
        <section aria-label="Chat configurador">
          <div class="grid gap-3" data-hilo aria-live="polite"></div>

          <form data-form-negocio class="msg-bot mt-3 grid gap-2 text-sm" id="preg-negocio">
            <h2 class="font-semibold">Tu negocio</h2>
            <label>Nombre del negocio *
              <input data-n="nombre" required autocomplete="organization" class="mt-1 w-full rounded border p-2" placeholder="Ej: Pinturería Centro" /></label>
            <div class="grid gap-2 md:grid-cols-2">
              <label>Tu nombre
                <input data-n="contacto_nombre" autocomplete="name" class="mt-1 w-full rounded border p-2" placeholder="Ej: Ana" /></label>
              <label>Teléfono *
                <input data-n="telefono" type="tel" autocomplete="tel" inputmode="tel" class="mt-1 w-full rounded border p-2" placeholder="Ej: 3547 000000" /></label>
            </div>
            <label>Email
              <input data-n="email" type="email" autocomplete="email" inputmode="email" class="mt-1 w-full rounded border p-2" placeholder="Ej: ana@negocio.com" /></label>
            <button class="rounded-full border px-3 py-2 font-semibold" type="submit">Seguir →</button>
          </form>

          <div data-preguntas class="mt-3 grid gap-3"></div>

          <details class="msg-bot mt-3 text-sm">
            <summary class="cursor-pointer font-semibold">Borrador vivo (lo que ya tildaste)</summary>
            <p class="mt-1 text-xs" data-resumen>Sin módulos todavía.</p>
            <pre class="mt-2 overflow-auto text-xs" data-json>{}</pre>
          </details>
          <button data-wa disabled title="Se define en T3" class="mt-3 w-full cursor-not-allowed rounded-full border px-3 py-2 font-semibold opacity-50">
            Enviar por WhatsApp (se define en T3)
          </button>
        </section>

        <section aria-label="Oficina en vivo">
          <div class="sticky top-4">
            <canvas data-canvas class="block w-full rounded-xl" style="aspect-ratio: 16/10;"
              aria-label="Tu oficina armándose: tocá un mueble para volver a su pregunta"></canvas>
            <p class="py-1 text-xs" data-estado>Activando escena…</p>
            <div data-fallback hidden class="rounded-xl border p-3">
              <p class="text-sm font-semibold">Sin 3D: tocá un sector</p>
              <div class="mt-2 flex flex-wrap gap-1">
                {objetos.map((id) => (
                  <button data-fb={id} class="rounded-full border px-2 py-1 text-xs">{OBJETO_LABEL[id]}</button>
                ))}
              </div>
            </div>
            <details class="mt-2 rounded-xl border p-3">
              <summary class="cursor-pointer text-sm font-semibold">Elegir sector sin 3D (teclado)</summary>
              <div class="mt-2 flex flex-wrap gap-1">
                {objetos.map((id) => (
                  <button data-fb={id} class="rounded-full border px-2 py-1 text-xs">{OBJETO_LABEL[id]}</button>
                ))}
              </div>
            </details>
            <ul class="mt-2 flex flex-wrap gap-1 text-xs" data-construidos aria-label="Objetos construidos"></ul>
          </div>
        </section>
      </div>

      <nav aria-label="Densidad del prototipo" class="fixed bottom-3 left-1/2 flex -translate-x-1/2 gap-2 rounded-full border bg-black px-3 py-2 text-xs">
        <a data-layout="split" href="?layout=split">Split</a>
        <span aria-hidden="true">·</span>
        <a data-layout="stack" href="?layout=stack">Apilado</a>
      </nav>
    </main>

    <script>
      // Guion T1 en datos: pregunta → key → objeto. Responder "sí" construye el objeto.
      const GUIÓN = [
        { id: 'mostrador', bloque: 'Tu ancla', objeto: 'mostrador-3d', keys: ['mostrador'],
          texto: '¿Cobrás en caja o mostrador? (ej: pinturería, repuestos, taller con mostrador)' },
        { id: 'deposito', bloque: 'Tu ancla', objeto: 'estanteria-3d', keys: ['deposito'],
          texto: '¿Tenés depósito o estantería con stock?' },
        { id: 'ventas', bloque: 'Tu ancla', objeto: 'gondola-3d', keys: ['ventas'],
          texto: '¿Vendés con listas de precio?' },
        { id: 'compras', bloque: 'Tu ancla', objeto: 'computadora-3d', keys: ['compras'],
          texto: '¿Comprás a proveedores?' },
        { id: 'fiscal', bloque: 'Tu ancla', objeto: 'pizarron-fiscal-3d', keys: ['fiscal_ar'],
          texto: '¿Facturás? Tildá lo que creas que usás (borrador, lo cierra tu contador).',
          multi: ['Factura A', 'Factura B', 'Factura C', 'Ticket', 'Recibo'] },
        { id: 'crecer', bloque: 'Para crecer', objeto: 'puerta-crecer-3d',
          keys: ['taller', 'migracion_excel', 'b2b_basico', 'ia'],
          texto: '¿Para dónde querés crecer? Tildá todo lo que te sirva.',
          multi: ['Taller', 'Pasar mi Excel', 'Vender a comercios', 'Usar IA'] },
      ];

      const root = document.querySelector('[data-chatproto]');
      if (root) {
        const params = new URLSearchParams(location.search);
        const layout = params.get('layout') === 'stack' ? 'stack' : 'split';
        const wrap = root.querySelector('[data-layout-wrap]');
        if (wrap) wrap.className = layout === 'split'
          ? 'mt-4 grid gap-4 md:grid-cols-[1fr_1fr]'
          : 'mt-4 grid gap-4';
        root.querySelectorAll('[data-layout]').forEach((a) => {
          if (a.getAttribute('data-layout') === layout) a.setAttribute('aria-current', 'page');
        });

        const reduc = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const estado = { negocio: {}, si: new Set(), multi: {} };
        const hilo = root.querySelector('[data-hilo]');
        const preguntas = root.querySelector('[data-preguntas]');
        const progreso = root.querySelector('[data-progreso]');
        const resumen = root.querySelector('[data-resumen]');
        const json = root.querySelector('[data-json]');
        const construidos = root.querySelector('[data-construidos]');
        const canvas = root.querySelector('[data-canvas]');
        const est = root.querySelector('[data-estado]');
        const fb = root.querySelector('[data-fallback]');
        let handle = null;
        let paso = 1;

        const NOMBRE = { mostrador: 'Mostrador', deposito: 'Depósito Inteligente', ventas: 'Ventas', compras: 'Compras', fiscal_ar: 'Fiscal AR', taller: 'Taller', migracion_excel: 'Migración Excel', b2b_basico: 'B2B Básico', ia: 'IA ModoOps' };

        function pinta() {
          // Superficie de estado (regla 5): borrador vivo tras cada respuesta.
          const keys = [];
          GUIÓN.forEach((g) => { if (estado.si.has(g.id)) keys.push(...g.keys); });
          const borrador = { version: 'borrador-v1', vinculante: false, negocio: estado.negocio, modulos: keys };
          if (json) json.textContent = JSON.stringify(borrador, null, 1);
          if (resumen) resumen.textContent = keys.length
            ? keys.map((k) => NOMBRE[k]).join(' · ')
            : 'Sin módulos todavía.';
          if (construidos) construidos.innerHTML = GUIÓN.map((g) =>
            `<li class="rounded-full border px-2 py-1 ${estado.si.has(g.id) ? 'hecho' : 'opacity-50'}">${estado.si.has(g.id) ? '✓ ' : ''}${g.id}</li>`).join('');
          if (progreso) progreso.textContent = `Paso ${Math.min(paso, 7)} de 7 · ${paso <= 1 ? 'Tu negocio' : paso <= 6 ? 'Tu ancla' : 'Para crecer'}`;
          try {
            const u = new URL(location.href);
            u.searchParams.set('layout', layout);
            history.replaceState(null, '', u);
          } catch { /* sin URL: el chat igual anda */ }
        }

        function decir(texto) {
          if (!hilo) return;
          const p = document.createElement('p');
          p.className = 'msg-bot text-sm';
          p.textContent = texto;
          hilo.appendChild(p);
        }

        function irAPregunta(id) {
          const card = preguntas && preguntas.querySelector(`[data-card="${id}"]`);
          if (card instanceof HTMLElement) {
            card.scrollIntoView({ behavior: reduc ? 'auto' : 'smooth', block: 'center' });
            card.classList.add('flash');
            setTimeout(() => card.classList.remove('flash'), 1600);
            const btn = card.querySelector('button');
            if (btn instanceof HTMLElement) btn.focus({ preventScroll: true });
          }
        }

        // Construye las tarjetas sí/no + multi desde el guion.
        if (preguntas) {
          GUIÓN.forEach((g) => {
            const card = document.createElement('div');
            card.className = 'msg-bot text-sm';
            card.dataset.card = g.id;
            const h = document.createElement('h2');
            h.className = 'font-semibold';
            h.textContent = `${g.bloque} — ${g.id}`;
            const p = document.createElement('p');
            p.className = 'mt-1';
            p.textContent = g.texto;
            card.append(h, p);
            const fila = document.createElement('div');
            fila.className = 'mt-2 flex flex-wrap gap-1';
            const bSi = document.createElement('button');
            bSi.className = 'rounded-full border px-3 py-1';
            bSi.textContent = 'Sí';
            bSi.setAttribute('aria-pressed', 'false');
            const bNo = document.createElement('button');
            bNo.className = 'rounded-full border px-3 py-1';
            bNo.textContent = 'No / saltear';
            bSi.addEventListener('click', () => {
              estado.si.add(g.id);
              bSi.setAttribute('aria-pressed', 'true');
              card.classList.add('hecho');
              if (handle) handle.resaltar(g.objeto);
              decir(`Anotado: ${g.id}. Mirá tu oficina →`);
              paso += 1;
              pinta();
            });
            bNo.addEventListener('click', () => {
              estado.si.delete(g.id);
              bSi.setAttribute('aria-pressed', 'false');
              card.classList.remove('hecho');
              paso += 1;
              pinta();
            });
            fila.append(bSi, bNo);
            card.appendChild(fila);
            if (g.multi) {
              const fs = document.createElement('fieldset');
              fs.className = 'mt-2 rounded border p-2';
              const lg = document.createElement('legend');
              lg.className = 'px-1 text-xs';
              lg.textContent = 'Tildá las que apliquen';
              fs.appendChild(lg);
              g.multi.forEach((op) => {
                const lab = document.createElement('label');
                lab.className = 'mr-3 inline-flex items-center gap-1';
                const c = document.createElement('input');
                c.type = 'checkbox';
                c.className = 'h-4 w-4';
                c.addEventListener('change', () => {
                  const lista = estado.multi[g.id] || (estado.multi[g.id] = []);
                  if (c.checked) lista.push(op);
                  else estado.multi[g.id] = lista.filter((x) => x !== op);
                  pinta();
                });
                lab.append(c, op);
                fs.appendChild(lab);
              });
              card.appendChild(fs);
            }
            preguntas.appendChild(card);
          });
        }

        const form = root.querySelector('[data-form-negocio]');
        if (form) form.addEventListener('submit', (e) => {
          e.preventDefault();
          form.querySelectorAll('[data-n]').forEach((i) => {
            if (i instanceof HTMLInputElement && i.value.trim()) estado.negocio[i.dataset.n] = i.value.trim();
          });
          decir(`Hola ${estado.negocio.contacto_nombre || estado.negocio.nombre || 'che'} 👋 Empecemos por el mostrador.`);
          paso = 2;
          pinta();
          irAPregunta('mostrador');
        });

        // 3D→chat: click en mueble vuelve a su pregunta (bidireccional).
        const objetoAPregunta = Object.fromEntries(GUIÓN.map((g) => [g.objeto, g.id]));
        function alElegir(objeto) {
          const id = objetoAPregunta[objeto];
          if (id) irAPregunta(id);
        }
        root.querySelectorAll('[data-fb]').forEach((b) => {
          b.addEventListener('click', () => {
            const id = b.getAttribute('data-fb');
            if (typeof id === 'string') alElegir(id);
          });
        });
        if (canvas instanceof HTMLCanvasElement && !canvas.dataset.mounted) {
          const io = new IntersectionObserver(async (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            io.disconnect();
            try {
              const { mountOficinaScene } = await import('../../scripts/oficina-scene');
              handle = mountOficinaScene(canvas, (objeto) => alElegir(objeto));
              window.addEventListener('pagehide', () => handle && handle(), { once: true });
              if (est) est.textContent = 'Escena 3D activa: respondé el chat y mirá cómo se arma · click en un mueble para volver a su pregunta.';
            } catch {
              canvas.style.display = 'none';
              if (fb instanceof HTMLElement) fb.hidden = false;
              if (est) est.textContent = 'Sin WebGL: usá los sectores para volver a cada pregunta.';
            }
          }, { rootMargin: '200px' });
          io.observe(canvas);
        }
        pinta();
      }
    </script>
  </body>
</html>
