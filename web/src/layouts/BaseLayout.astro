---
import '../styles/light-app.css';
import '../styles/global.css';
import SiteHeader from '../components/ui/SiteHeader.astro';
import FloatingWhatsApp from '../components/ui/FloatingWhatsApp.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const { title, description, canonical, ogImage, ogType = 'website', noindex = false } = Astro.props;

const siteBase = (Astro.site?.toString() ?? 'https://modoops.com.ar').replace(/\/$/, '');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteBase).toString();
const imgBase = canonical ? new URL(canonicalUrl).origin : siteBase;
const ogImageUrl = new URL(ogImage ?? '/images/galaxy-hero.png', imgBase).toString();
---

<!doctype html>
<html lang="es-AR" data-theme="papel">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7faf7" />
    <meta name="color-scheme" content="light" />
    <style>
      html {
        background: #f7faf7;
      }
    </style>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ModoOps" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650;9..144,700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script defer data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || "modoops.com.ar"} src="https://plausible.io/js/script.tagged-events.js"></script>
    <script>
      window.plausible = window.plausible || function(){(window.plausible.q=window.plausible.q||[]).push(arguments)};
    </script>
    <script is:inline>
      (() => {
        const el = document.getElementById('camino');
        if (!el || typeof IntersectionObserver === 'undefined') return;
        const fired = new Set();
        const fire = (pct) => {
          if (fired.has(pct)) return;
          fired.add(pct);
          window.plausible && window.plausible('scroll_camino', {props:{percent:String(pct)}});
          if (fired.size === 2) obs.disconnect();
        };
        const obs = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const r = e.intersectionRatio;
            if (r >= 0.9) fire(90);
            else if (r >= 0.5) fire(50);
          }
        }, {threshold:[0.5,0.9]});
        obs.observe(el);
      })();
    </script>
  </head>
  <body class="lp-body">
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <SiteHeader />
    <div id="contenido" tabindex="-1">
      <slot />
    </div>
    <FloatingWhatsApp />
  </body>
</html>

<style>
  .lp-body {
    margin: 0;
    min-height: 100%;
    background: var(--mo-wash);
    color: var(--mo-ink);
    font-family: var(--mo-font);
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--mo-ink);
    color: var(--mo-wash);
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-weight: 600;
  }
  .skip-link:focus-visible {
    top: 1rem;
    outline: 2px solid var(--mo-focus);
    outline-offset: 3px;
  }
</style>
