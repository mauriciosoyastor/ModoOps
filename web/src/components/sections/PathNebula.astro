---
import Section from '../ui/Section.astro';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<Section variant="dark" embedded={embedded}>
  <div class="nebula-scene mx-auto w-full max-w-4xl">
    <div class="nebula-scene__backdrop" aria-hidden="true"></div>
    <canvas
      id="path-nebula-canvas"
      class="nebula-scene__canvas"
      aria-label="Animación de nebulosa cósmica con estrellas en movimiento"
    ></canvas>
  </div>
</Section>

<script>
  import { mountNebulaScene } from '../../scripts/nebula-scene';

  function initWhenReady() {
    const canvas = document.getElementById('path-nebula-canvas');
    if (!(canvas instanceof HTMLCanvasElement) || canvas.dataset.mounted === 'true') return;

    const container = canvas.closest('.nebula-scene');
    if (!container || container.clientWidth === 0) {
      requestAnimationFrame(initWhenReady);
      return;
    }

    const cleanup = mountNebulaScene(canvas);
    window.addEventListener('pagehide', cleanup, { once: true });
    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhenReady, { once: true });
  } else {
    requestAnimationFrame(initWhenReady);
  }
</script>

<style>
  .nebula-scene {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--color-nebula-cyan) 28%, transparent);
    min-height: 320px;
    height: min(72vw, 520px);
  }

  .nebula-scene__backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 45%,
      color-mix(in srgb, var(--color-galaxy-deep) 80%, var(--color-space-mist)) 0%,
      var(--color-space-void) 72%
    );
  }

  .nebula-scene__canvas {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
