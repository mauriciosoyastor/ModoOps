---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { garantia } from '../../data/business';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<Section variant="dark" id="garantia" embedded={embedded}>
  <SectionHeading title={garantia.title} lead={garantia.lead} invert />
  <p class="max-w-2xl text-[length:var(--text-body-lg)] text-ash-gray">{garantia.detail}</p>
</Section>
