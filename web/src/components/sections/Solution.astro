---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { solution } from '../../data/business';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<Section variant="white" id="solucion" embedded={embedded}>
  <SectionHeading title={solution.title} lead={solution.lead} />
  <ul class="grid gap-3 md:grid-cols-2">
    {
      solution.highlights.map((item) => (
        <li class="galaxy-card rounded-[var(--radius-card)] p-5">
          <strong>{item.title}</strong>{item.detail ? ` — ${item.detail}` : ''}
        </li>
      ))
    }
  </ul>
</Section>
