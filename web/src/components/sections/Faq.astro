---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { faq } from '../../data/business';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<Section variant="linen" id="faq" embedded={embedded}>
  <SectionHeading title={faq.title} lead={faq.lead} />
  <div class="faq-list">
    {
      faq.items.map((item) => (
        <details class="faq-item">
          <summary class="faq-q">
            <span>{item.q}</span>
            <span class="faq-q__icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-panel">
            <div class="faq-panel__inner">
              <p class="faq-a">{item.a}</p>
            </div>
          </div>
        </details>
      ))
    }
  </div>
</Section>

<style>
  .faq-list {
    display: grid;
    gap: 0.65rem;
    max-width: 42rem;
  }

  .faq-item {
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius, 14px);
    background: var(--mo-canvas);
    padding: 0;
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    padding: 0.95rem 1.1rem;
    cursor: pointer;
    list-style: none;
    font-size: var(--text-subheading, 1.25rem);
    font-weight: 650;
    line-height: 1.3;
    color: var(--mo-ink);
    touch-action: manipulation;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q:focus-visible {
    outline: 2px solid var(--mo-focus);
    outline-offset: -2px;
    border-radius: var(--mo-radius, 14px);
  }

  .faq-q__icon {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--mo-line);
    font-size: 1rem;
    font-weight: 600;
    color: var(--mo-muted);
    transition:
      transform 160ms var(--mo-ease-out),
      background-color 140ms var(--mo-ease-out),
      color 140ms var(--mo-ease-out);
  }

  .faq-item[open] .faq-q__icon {
    transform: rotate(45deg);
    background: var(--mo-accent-soft);
    color: var(--mo-ink);
  }

  /* Height bridge: 0fr → 1fr (ticket 01) */
  .faq-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 220ms var(--mo-ease-out);
  }

  .faq-item[open] .faq-panel {
    grid-template-rows: 1fr;
  }

  .faq-panel__inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq-a {
    margin: 0;
    padding: 0 1.1rem 1.05rem;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--mo-muted);
    opacity: 0;
    transition: opacity 180ms var(--mo-ease-out);
  }

  .faq-item[open] .faq-a {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-panel {
      transition: none;
    }

    .faq-item[open] .faq-panel {
      grid-template-rows: 1fr;
    }

    .faq-a {
      transition: opacity 120ms var(--mo-ease-out);
    }

    .faq-q__icon {
      transition: background-color 120ms var(--mo-ease-out), color 120ms var(--mo-ease-out);
    }

    .faq-item[open] .faq-q__icon {
      transform: none;
    }
  }
</style>
