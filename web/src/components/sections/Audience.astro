---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { audience } from '../../data/business';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<Section variant="white" id="para-quien" embedded={embedded}>
  <SectionHeading title={audience.title} />
  <div class="grid gap-8 md:grid-cols-2">
    <div>
      <h3 class="text-[length:var(--text-subheading)] font-medium">{audience.yesTitle}</h3>
      <ul class="mt-4 grid gap-2 text-[length:var(--text-body)]">
        {audience.yes.map((item) => <li>✓ {item}</li>)}
      </ul>
    </div>
    <div>
      <h3 class="text-[length:var(--text-subheading)] font-medium">{audience.noTitle}</h3>
      <ul class="mt-4 grid gap-2 text-[length:var(--text-body)] text-ash-gray">
        {audience.no.map((item) => <li>✕ {item}</li>)}
      </ul>
    </div>
  </div>
</Section>
