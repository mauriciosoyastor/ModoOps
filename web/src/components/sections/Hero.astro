---
import Button from '../ui/Button.astro';
import { contact, hero } from '../../data/business';
---

<section class="lp-split">
  <div class="lp-split__grid">
    <div class="lp-split__main">
      <h1 class="lp-split__title" data-lp-enter>{hero.title}</h1>
      <div class="lp-hero-mock" data-lp-enter style="--lp-enter-delay: 60ms" aria-hidden="true">
        <div class="lp-hero-mock__chrome">
          <span class="lp-hero-mock__brand" translate="no">ModoOps</span>
          <span class="lp-hero-mock__tenant">Pinturería Centro</span>
        </div>
        <div class="lp-hero-mock__kpis">
          <div class="lp-hero-mock__kpi">
            <p class="lp-hero-mock__label">Caja del día</p>
            <p class="lp-hero-mock__value">USD&nbsp;48.500</p>
          </div>
          <div class="lp-hero-mock__kpi">
            <p class="lp-hero-mock__label">Tickets</p>
            <p class="lp-hero-mock__value">12</p>
          </div>
        </div>
        <div class="lp-hero-mock__tiles">
          <span>Abrir caja</span>
          <span>Consultar depósito</span>
          <span>Cobrar</span>
        </div>
      </div>
    </div>
    <div class="lp-split__side" data-lp-enter style="--lp-enter-delay: 90ms">
      <p class="lp-split__lead">{hero.subtitle}</p>
      <div class="lp-split__actions">
        <Button href="/oficina" variant="ghost-dark" data-cta="cta_oficina" data-source="hero">Armá tu borrador</Button>
        <Button href="#contacto" variant="primary" data-cta="cta_propuesta" data-source="hero">Pedir propuesta</Button>
      </div>
      <p class="lp-split__links">
        <Button href={contact.whatsapp} variant="link" data-cta="cta_whatsapp" data-source="hero">WhatsApp</Button>
        <span aria-hidden="true">·</span>
        <Button href={`mailto:${contact.email}`} variant="link" data-cta="cta_email" data-source="hero">Email</Button>
        <span aria-hidden="true">·</span>
        <Button href="/login" variant="link" data-cta="cta_login" data-source="hero">Trabajo en ModoOps</Button>
        <span aria-hidden="true">·</span>
        <a href="/app" class="lp-split__link" data-cta="cta_app" data-source="hero">Ir a mi panel</a>
      </p>
    </div>
  </div>
</section>

<style>
  .lp-split {
    background: var(--mo-wash);
    color: var(--mo-ink);
  }

  .lp-split__grid {
    max-width: var(--width-content, 70rem);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3.5rem;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .lp-split__grid {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      min-height: min(62vh, 36rem);
      align-items: stretch;
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
  }

  .lp-split__main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding: 1rem 1.5rem 1rem 0;
  }

  .lp-split__title {
    margin: 0;
    max-width: 10ch;
    font-family: var(--mo-display);
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
    color: var(--mo-ink);
  }

  .lp-hero-mock {
    max-width: 22rem;
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius, 14px);
    background: var(--mo-canvas);
    padding: 0.85rem 1rem 1rem;
    display: grid;
    gap: 0.75rem;
  }

  .lp-hero-mock__chrome {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
  }

  .lp-hero-mock__brand {
    font-family: var(--mo-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--mo-ink);
  }

  .lp-hero-mock__tenant {
    font-size: 0.75rem;
    color: var(--mo-muted);
  }

  .lp-hero-mock__kpis {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 0.5rem;
  }

  .lp-hero-mock__kpi {
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius-sm, 9px);
    background: var(--mo-card, var(--mo-wash));
    padding: 0.55rem 0.65rem;
  }

  .lp-hero-mock__label {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--mo-muted);
  }

  .lp-hero-mock__value {
    margin: 0.2rem 0 0;
    font-size: 1.05rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--mo-ink);
  }

  .lp-hero-mock__tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .lp-hero-mock__tiles span {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--mo-line);
    color: var(--mo-ink);
    background: var(--mo-wash, var(--mo-card));
  }

  .lp-split__side {
    background: var(--mo-hero);
    color: var(--mo-on-hero);
    border-radius: var(--mo-radius, 14px);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .lp-split__lead {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--mo-on-hero);
    opacity: 0.88;
  }

  .lp-split__actions {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .lp-split__links {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: 0.875rem;
  }

  .lp-split__links :global(a),
  .lp-split__link {
    color: color-mix(in srgb, var(--mo-on-hero) 78%, transparent);
    text-underline-offset: 4px;
  }

  .lp-split__links :global(a:hover),
  .lp-split__link:hover {
    color: var(--mo-on-hero);
  }

  .lp-split__side :global(a.btn) {
    justify-content: center;
  }
</style>

<script>
  import { whatsappWithUtm } from '../../data/business';
  const waHero = document.querySelector('a[data-cta="cta_whatsapp"][data-source="hero"]') as HTMLAnchorElement | null;
  if (waHero) {
    try { waHero.href = whatsappWithUtm('hero'); } catch {}
    waHero.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_whatsapp', {props:{source:'hero'}}));
  }
  document.querySelectorAll('a[data-cta="cta_oficina"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_oficina', {props:{source:'hero'}}));
  });
  document.querySelectorAll('a[data-cta="cta_propuesta"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_propuesta', {props:{source:'hero'}}));
  });
  document.querySelectorAll('a[data-cta="cta_email"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_email', {props:{source:'hero'}}));
  });
  document.querySelectorAll('a[data-cta="cta_login"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_login', {props:{source:'hero'}}));
  });
</script>
