---
import Button from '../ui/Button.astro';
import { hero } from '../../data/business';
---

<section class="relative flex min-h-[min(88vh,52rem)] items-center overflow-hidden text-canvas-white">
  <div class="hero-content-scrim absolute inset-0" aria-hidden="true"></div>

  <div
    class="relative z-10 mx-auto w-full max-w-[var(--width-content)] px-6 py-[calc(var(--spacing-section)*1.4)] md:px-10"
  >
    <h1
      class="max-w-3xl text-[length:var(--text-display)] font-semibold leading-tight tracking-tight text-star-white drop-shadow-[0_2px_24px_rgba(0,0,0,0.85)]"
    >
      {hero.title}
    </h1>
    <p
      class="mt-6 max-w-2xl text-[length:var(--text-body-lg)] text-star-white/90 drop-shadow-[0_1px_12px_rgba(0,0,0,0.75)]"
    >
      {hero.subtitle}
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="#contacto" variant="primary" data-cta="cta_propuesta" data-source="hero">Pedir propuesta</Button>
      <Button href="/oficina" variant="ghost-dark" data-cta="cta_oficina" data-source="hero">Recorré tu oficina</Button>
    </div>
    <p class="mt-4 text-sm text-star-white/70">
      Operando en retail real · Descubrimiento $155 USD · <a href="/app" class="hit-fix underline underline-offset-4 hover:text-star-white" data-cta="cta_app" data-source="hero">Ya soy cliente</a>
    </p>
  </div>
</section>

<script>
  document.querySelectorAll('a[data-cta="cta_oficina"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_oficina', {props:{source:'hero'}}));
  });
  document.querySelectorAll('a[data-cta="cta_propuesta"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_propuesta', {props:{source:'hero'}}));
  });
</script>
