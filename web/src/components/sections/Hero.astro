---
import Button from '../ui/Button.astro';
import { contact, hero } from '../../data/business';
---

<section class="lp-split">
  <div class="lp-split__grid">
    <div class="lp-split__main">
      <h1 class="lp-split__title">{hero.title}</h1>
    </div>
    <div class="lp-split__side">
      <p class="lp-split__lead">{hero.subtitle}</p>
      <div class="lp-split__actions">
        <Button href="/oficina" variant="ghost-dark" data-cta="cta_oficina" data-source="hero">Recorré tu oficina</Button>
        <Button href="#contacto" variant="primary" data-cta="cta_propuesta" data-source="hero">Pedir propuesta</Button>
      </div>
      <p class="lp-split__links">
        <Button href={contact.whatsapp} variant="link" data-cta="cta_whatsapp" data-source="hero">WhatsApp</Button>
        <span aria-hidden="true">·</span>
        <Button href={`mailto:${contact.email}`} variant="link" data-cta="cta_email" data-source="hero">Email</Button>
        <span aria-hidden="true">·</span>
        <Button href="/login" variant="link" data-cta="cta_login" data-source="hero">Trabajo en ModoOps</Button>
        <span aria-hidden="true">·</span>
        <a href="/app" class="lp-split__link" data-cta="cta_app" data-source="hero">Ir a mi panel</a>
      </p>
    </div>
  </div>
</section>

<style>
  .lp-split {
    background: var(--mo-wash);
    color: var(--mo-ink);
  }

  .lp-split__grid {
    max-width: var(--width-content, 70rem);
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3.5rem;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .lp-split__grid {
      grid-template-columns: 1fr 1fr;
      gap: 0;
      min-height: min(62vh, 36rem);
      align-items: stretch;
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
  }

  .lp-split__main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 1.5rem 1rem 0;
  }

  .lp-split__title {
    margin: 0;
    max-width: 10ch;
    font-family: var(--mo-display);
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
    color: var(--mo-ink);
  }

  .lp-split__side {
    background: var(--mo-hero);
    color: var(--mo-on-hero);
    border-radius: var(--mo-radius, 14px);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .lp-split__lead {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--mo-on-hero);
    opacity: 0.88;
  }

  .lp-split__actions {
    margin-top: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .lp-split__links {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: 0.875rem;
  }

  .lp-split__links :global(a),
  .lp-split__link {
    color: color-mix(in srgb, var(--mo-on-hero) 78%, transparent);
    text-underline-offset: 4px;
  }

  .lp-split__links :global(a:hover),
  .lp-split__link:hover {
    color: var(--mo-on-hero);
  }

  .lp-split__side :global(a.btn) {
    justify-content: center;
  }
</style>

<script>
  import { whatsappWithUtm } from '../../data/business';
  const waHero = document.querySelector('a[data-cta="cta_whatsapp"][data-source="hero"]') as HTMLAnchorElement | null;
  if (waHero) {
    try { waHero.href = whatsappWithUtm('hero'); } catch {}
    waHero.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_whatsapp', {props:{source:'hero'}}));
  }
  document.querySelectorAll('a[data-cta="cta_oficina"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_oficina', {props:{source:'hero'}}));
  });
  document.querySelectorAll('a[data-cta="cta_propuesta"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_propuesta', {props:{source:'hero'}}));
  });
  document.querySelectorAll('a[data-cta="cta_email"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_email', {props:{source:'hero'}}));
  });
  document.querySelectorAll('a[data-cta="cta_login"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_login', {props:{source:'hero'}}));
  });
</script>
