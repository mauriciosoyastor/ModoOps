---
import Button from '../ui/Button.astro';
import { contact, hero } from '../../data/business';
---

<section class="relative flex min-h-[min(88vh,52rem)] items-center overflow-hidden text-canvas-white">
  <div class="hero-content-scrim absolute inset-0" aria-hidden="true"></div>

  <div
    class="relative z-10 mx-auto w-full max-w-[var(--width-content)] px-6 py-[calc(var(--spacing-section)*1.4)] md:px-10"
  >
    <h1
      class="max-w-3xl text-[length:var(--text-display)] font-semibold leading-tight tracking-tight text-star-white drop-shadow-[0_2px_24px_rgba(0,0,0,0.85)]"
    >
      {hero.title}
    </h1>
    <p
      class="mt-6 max-w-2xl text-[length:var(--text-body-lg)] text-star-white/90 drop-shadow-[0_1px_12px_rgba(0,0,0,0.75)]"
    >
      {hero.subtitle}
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="#contacto" variant="primary" data-cta="cta_discovery" data-source="hero">Pedir descubrimiento</Button>
      <Button href={contact.whatsapp} variant="ghost-dark" data-cta="cta_whatsapp" data-source="hero">WhatsApp</Button>
      <Button href={`mailto:${contact.email}`} variant="ghost-dark" data-cta="cta_email" data-source="hero">Email</Button>
      <Button href="/login" variant="ghost-light" data-cta="cta_login" data-source="hero">Trabajo en ModoOps</Button>
    </div>
    <p class="mt-4 text-sm text-star-white/70">
      ¿Ya sos cliente? <a href="/app" class="underline underline-offset-4 hover:text-star-white" data-cta="cta_app" data-source="hero">Ir a mi panel</a>
    </p>
  </div>
</section>

<script>
  import { whatsappWithUtm } from '../../data/business';
  const waHero = document.querySelector('a[data-cta="cta_whatsapp"][data-source="hero"]') as HTMLAnchorElement | null;
  if (waHero) {
    try { waHero.href = whatsappWithUtm('hero'); } catch {}
    waHero.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_whatsapp', {props:{source:'hero'}}));
  }
  document.querySelectorAll('a[data-cta="cta_discovery"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_discovery', {props:{source:'hero'}}));
  });
  document.querySelectorAll('a[data-cta="cta_email"][data-source="hero"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_email', {props:{source:'hero'}}));
  });
</script>
