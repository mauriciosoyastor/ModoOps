---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { contact, brand, footer } from '../../data/business';

const socialButtonClass =
  'inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] px-5 py-3 text-sm font-medium text-canvas-white transition-colors';
---

<Section variant="dark" id="contacto">
  <SectionHeading title="Contacto" lead={footer.contactLead} invert />

  <div class="grid gap-8 md:grid-cols-2 md:gap-10">
    <div class="galaxy-card rounded-[var(--radius-card)] p-6 md:p-8">
      <h3 class="text-[length:var(--text-subheading)] font-medium text-core-cream">Escribinos</h3>
      <p class="mt-2 text-sm text-ash-gray">Contanos tu rubro y qué querés ordenar (caja, stock, compras).</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`mailto:${contact.email}?subject=Consulta ModoOps — Descubrimiento`} class:list={[socialButtonClass, 'bg-star-warm hover:bg-star-glow']}>
          {contact.email}
        </a>
        <a
          href={contact.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[socialButtonClass, 'border border-[#25D366]/50 bg-[#25D366]/10 hover:border-[#25D366] hover:bg-[#25D366]/20']}
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp {contact.whatsappLabel}
        </a>
      </div>
      <p class="mt-6 text-sm text-ash-gray">Respuesta en horario comercial. Soporte post go-live según contrato (no WhatsApp ilimitado).</p>
    </div>

    <div class="galaxy-card rounded-[var(--radius-card)] p-6 md:p-8">
      <h3 class="text-[length:var(--text-subheading)] font-medium text-core-cream">Qué incluir en tu mensaje</h3>
      <ul class="mt-4 grid gap-2 text-sm text-ash-gray">
        <li>— Rubro y ciudad</li>
        <li>— Una sucursal / cuántas cajas / cuántos usuarios</li>
        <li>— Qué usás hoy (planillas, sistema actual)</li>
        <li>— Qué querés resolver primero</li>
      </ul>
      <div class="mt-8 border-t border-nebula-cyan/15 pt-6">
        <p class="text-sm font-medium text-core-cream">{brand.name}</p>
        <p class="mt-2 text-sm text-ash-gray">{brand.tagline}</p>
      </div>
    </div>
  </div>

  <p class="mt-12 border-t border-nebula-cyan/15 pt-8 text-center text-xs text-ash-gray">
    {footer.copyright}
  </p>
</Section>
