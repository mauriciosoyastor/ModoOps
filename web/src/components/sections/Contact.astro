---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { contact, brand, footer } from '../../data/business';
---

<Section variant="dark" id="contacto">
  <SectionHeading title="Contacto" lead={footer.contactLead} invert />

  <div class="ct-grid">
    <div class="ct-card">
      <h3 class="ct-card__title">Escribinos</h3>
      <p class="ct-card__lead">Contanos tu rubro y qué querés ordenar (caja, depósito, compras).</p>
      <div class="ct-actions">
        <a
          href={contact.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="cta_whatsapp"
          data-source="contact"
          class="contact-btn contact-btn--primary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ct-icon" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          WhatsApp {contact.whatsappLabel}
        </a>
        <a
          href={`mailto:${contact.email}?subject=Consulta ModoOps — Propuesta`}
          class="ct-mail"
          data-cta="cta_email"
          data-source="contact"
        >
          {contact.email}
        </a>
      </div>
    </div>

    <div class="ct-card">
      <h3 class="ct-card__title">Qué incluir en tu mensaje</h3>
      <ul class="ct-list">
        <li>Rubro y ciudad</li>
        <li>Cajas y usuarios (una sucursal)</li>
        <li>Qué usás hoy (planillas, sistema actual)</li>
        <li>Qué te frena primero</li>
      </ul>
    </div>
  </div>

  <div class="ct-colophon">
    <div>
      <p class="ct-brand" translate="no">{brand.name}</p>
      <p class="ct-tag">{brand.tagline}</p>
    </div>
    <p class="ct-copy">{footer.copyright}</p>
  </div>
</Section>

<script>
  import { whatsappWithUtm } from '../../data/business';
  const waContact = document.querySelector('a[data-cta="cta_whatsapp"][data-source="contact"]') as HTMLAnchorElement | null;
  if (waContact) {
    try { waContact.href = whatsappWithUtm('contact'); } catch {}
    waContact.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_whatsapp', {props:{source:'contact'}}));
  }
  document.querySelectorAll('a[data-cta="cta_email"][data-source="contact"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_email', {props:{source:'contact'}}));
  });
</script>

<style>
  .ct-grid {
    display: grid;
    gap: 0.85rem;
    max-width: 48rem;
  }

  @media (min-width: 720px) {
    .ct-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      align-items: stretch;
    }
  }

  .ct-card {
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius, 14px);
    background: var(--mo-canvas);
    padding: 1.25rem 1.25rem 1.35rem;
  }

  .ct-card__title {
    margin: 0;
    font-family: var(--mo-display);
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--mo-ink);
  }

  .ct-card__lead,
  .ct-list {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--mo-muted);
  }

  .ct-actions {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .ct-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.65rem 1.25rem;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    touch-action: manipulation;
    transition:
      background-color 140ms var(--mo-ease-out, cubic-bezier(0.23, 1, 0.32, 1)),
      transform 160ms var(--mo-ease-out, cubic-bezier(0.23, 1, 0.32, 1));
  }

  .contact-btn--primary {
    border: 0;
    background: var(--mo-accent);
    color: var(--mo-accent-ink);
  }

  .contact-btn:active {
    transform: scale(0.97);
  }

  .ct-mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--mo-ink);
    font-size: 1rem;
    line-height: 1.3;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }


  .ct-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .ct-list li {
    display: grid;
    grid-template-columns: 0.45rem 1fr;
    gap: 0.65rem;
    align-items: start;
  }

  .ct-list li::before {
    content: "";
    width: 0.35rem;
    height: 0.35rem;
    margin-top: 0.45rem;
    border-radius: 999px;
    background: var(--mo-line-strong);
  }

  .ct-colophon {
    max-width: 48rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--mo-line);
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 720px) {
    .ct-colophon {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 1.5rem;
    }
  }

  .ct-brand {
    margin: 0;
    font-family: var(--mo-display);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--mo-ink);
  }

  .ct-tag,
  .ct-copy {
    margin: 0.25rem 0 0;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--mo-muted);
  }

  .ct-copy {
    margin-top: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-btn--primary:hover {
      background: var(--mo-accent-hover);
    }

    .ct-mail:hover {
      color: var(--mo-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-btn {
      transition: background-color 120ms var(--mo-ease-out, cubic-bezier(0.23, 1, 0.32, 1));
    }

    .contact-btn:active {
      transform: none;
      opacity: 0.92;
    }
  }
</style>
