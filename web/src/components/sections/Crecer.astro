---
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { crecer } from '../../data/business';

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
---

<Section variant="linen" id="crecer" embedded={embedded}>
  <SectionHeading title={crecer.title} lead={crecer.lead} />
  <p class="max-w-2xl text-[length:var(--text-body-lg)] text-ash-gray">{crecer.detail}</p>
</Section>
