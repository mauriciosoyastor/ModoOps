---
interface Props {
  variant?: 'dark' | 'linen' | 'white';
  id?: string;
  narrow?: boolean;
  embedded?: boolean;
}

const { variant = 'white', id, narrow = false, embedded = false } = Astro.props;

/* ADR 0011 — capas Tema papel */
const bg = {
  dark: 'lp-section lp-section--wash',
  linen: 'lp-section lp-section--canvas',
  white: 'lp-section lp-section--card',
}[variant];

const inner = narrow ? 'max-w-2xl' : 'max-w-[var(--width-content)]';
---

{
  embedded ? (
    <div id={id} class="w-full text-[var(--mo-ink)]">
      <div class:list={['mx-auto w-full', narrow ? 'max-w-2xl' : 'max-w-none']}>
        <slot />
      </div>
    </div>
  ) : (
    <section id={id} class:list={['px-6 py-[var(--spacing-section)] md:px-10', bg]}>
      <div class:list={['mx-auto w-full', inner]}>
        <slot />
      </div>
    </section>
  )
}

<style>
  .lp-section {
    color: var(--mo-ink);
  }
  .lp-section--wash {
    background: var(--mo-wash);
  }
  .lp-section--canvas {
    background: var(--mo-canvas);
  }
  .lp-section--card {
    background: var(--mo-card);
  }
</style>
