---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost-dark' | 'ghost-light' | 'link';
  class?: string;
  onclick?: string;
  'data-cta'?: string;
  'data-source'?: string;
}

const { href, variant = 'primary', class: className, onclick, 'data-cta': dataCta, 'data-source': dataSource } = Astro.props;

const base = 'btn inline-flex items-center justify-center text-base font-medium';

const variants = {
  /* ADR 0011: Acento ModoOps = --mo-accent (papel) */
  primary:
    'rounded-full bg-[var(--mo-accent)] px-6 py-3 text-[var(--mo-accent-ink)] hover:bg-[var(--mo-accent-hover)]',
  'ghost-dark':
    'rounded-full border border-[color-mix(in_srgb,var(--mo-on-hero)_45%,transparent)] bg-transparent px-6 py-3 text-[var(--mo-on-hero)] hover:border-[var(--mo-on-hero)] hover:bg-[color-mix(in_srgb,var(--mo-on-hero)_12%,transparent)]',
  'ghost-light':
    'rounded-full border border-[var(--mo-line-strong)] bg-transparent px-6 py-3 text-[var(--mo-ink)] hover:border-[var(--mo-accent)] hover:bg-[var(--mo-accent-soft)]',
  link: 'hit-target px-1 py-1 text-sm font-medium underline underline-offset-4 text-[color-mix(in_srgb,var(--mo-on-hero)_78%,transparent)] hover:text-[var(--mo-on-hero)]',
};
---

<a href={href} class:list={[base, variants[variant], className]} onclick={onclick} data-cta={dataCta} data-source={dataSource}>
  <slot />
</a>

<style>
  .btn {
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease,
      opacity 0.15s ease;
    font-family: var(--mo-font);
    text-decoration: none;
    min-height: 44px;
  }
</style>
