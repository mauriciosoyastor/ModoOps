---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost-dark' | 'ghost-light';
  class?: string;
  onclick?: string;
  'data-cta'?: string;
  'data-source'?: string;
}

const { href, variant = 'primary', class: className, onclick, 'data-cta': dataCta, 'data-source': dataSource } = Astro.props;

const base =
  'btn inline-flex items-center justify-center rounded-[var(--radius-button)] px-6 py-4 text-base font-medium hover:opacity-90';

const variants = {
  primary: 'bg-star-warm text-space-void hover:bg-star-glow',
  'ghost-dark': 'border border-canvas-white/50 text-canvas-white bg-transparent hover:border-canvas-white',
  'ghost-light': 'border border-nebula-cyan/60 text-canvas-white bg-transparent hover:border-nebula-cyan',
};
---

<a href={href} class:list={[base, variants[variant], className]} onclick={onclick} data-cta={dataCta} data-source={dataSource}>
  <slot />
</a>

<style>
  /* S1 lote 0: propiedades explícitas, nunca transition-all (prototipo guidelines-hero) */
  .btn {
    transition:
      color 0.15s ease,
      background-color 0.15s ease,
      border-color 0.15s ease,
      opacity 0.15s ease;
  }
</style>
