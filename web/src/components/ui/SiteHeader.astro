---
import { nav, brand } from '../../data/business';
---

<header class="lp-header">
  <div class="lp-header__inner">
    <a href="/" class="lp-header__brand" translate="no">{brand.name}</a>
    <nav aria-label="Secciones" class="lp-header__nav">
      {
        nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
      <a href="/login" class="lp-header__login" data-cta="cta_login" data-source="header">
        Trabajo en ModoOps
      </a>
      <a
        href="#contacto"
        class="lp-header__cta"
        data-cta="cta_propuesta"
        data-source="header"
      >
        Pedir propuesta
      </a>
    </nav>
  </div>
</header>

<style>
  .lp-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--mo-line);
    background: color-mix(in srgb, var(--mo-canvas) 92%, transparent);
  }

  .lp-header__inner {
    max-width: var(--width-content, 70rem);
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }

  @media (min-width: 768px) {
    .lp-header__inner {
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }
  }

  .lp-header__brand {
    font-family: var(--mo-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--mo-ink);
    text-decoration: none;
  }

  .lp-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.1rem;
    font-size: 0.9rem;
  }

  .lp-header__nav a {
    color: var(--mo-muted);
    text-decoration: none;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s ease-out;
  }

  .lp-header__nav a:hover {
    color: var(--mo-ink);
  }

  .lp-header__login {
    min-height: 44px;
  }

  .lp-header__cta {
    min-height: 44px;
    border: 0;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    font-weight: 600;
    /* ADR 0011: Acento ModoOps + tinta del acento */
    background: var(--mo-accent) !important;
    color: var(--mo-accent-ink) !important;
    transition:
      background-color 0.15s ease-out,
      color 0.15s ease-out,
      transform 160ms var(--mo-ease-out, cubic-bezier(0.23, 1, 0.32, 1));
  }

  .lp-header__cta:hover {
    background: var(--mo-accent-hover) !important;
    color: var(--mo-accent-ink) !important;
  }

  .lp-header__cta:active {
    transform: scale(0.97);
  }

  .lp-header__cta:focus-visible {
    outline: 2px solid var(--mo-focus, var(--mo-ink));
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-header__cta {
      transition: background-color 0.12s ease-out, color 0.12s ease-out, opacity 0.12s ease-out;
    }

    .lp-header__cta:active {
      transform: none;
      opacity: 0.92;
    }
  }
</style>

<script>
  document.querySelectorAll('a[data-cta="cta_login"][data-source="header"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_login', {props:{source:'header'}}));
  });
  document.querySelectorAll('a[data-cta="cta_propuesta"][data-source="header"]').forEach((el) => {
    el.addEventListener('click', () => (window as any).plausible && (window as any).plausible('cta_propuesta', {props:{source:'header'}}));
  });
</script>
