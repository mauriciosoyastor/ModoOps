---
import type { Inicio } from "../../lib/bff/inicio.ts";

interface Props {
  inicio: Inicio;
  /** Inicio de producto: cromado quieto. */
  plano?: boolean;
  /** Shell: color denotativo sobre el cromado quieto. */
  color?: boolean;
}

const { inicio, plano = false, color = false } = Astro.props;
const areas = inicio.filas.map((fila) => `"${fila.join(" ")}"`).join(" ");
const usadas = new Set(inicio.filas.flat());
const maxSerie = Math.max(1, ...(inicio.serie?.puntos.map((punto) => punto.valor) ?? [0]));
---

<div class:list={["inicio-mosaico", plano && "inicio-mosaico--plano", color && "inicio-mosaico--color"]} style={`grid-template-areas: ${areas}`}>
  {
    usadas.has("greet") && (
      <section class="bloque saludo" style="grid-area: greet" aria-labelledby="inicio-saludo">
        <h1 id="inicio-saludo">{inicio.saludo}</h1>
        <p>{inicio.bajada}</p>
      </section>
    )
  }
  {
    usadas.has("bar") && inicio.barra && (
      <section class="bloque" style="grid-area: bar" aria-labelledby="inicio-barra">
        <h2 id="inicio-barra">{inicio.barraTitulo}</h2>
        {
          inicio.barra.every((parte) => parte.pct === 0) ? (
            <p class="muted">0</p>
          ) : (
            <div class="pista" aria-hidden="true">
              {inicio.barra.map((parte) => (
                <span class:list={["tramo", parte.tono ? `tramo--${parte.tono}` : parte.href ? "tramo--enlace" : "tramo--quieto"]} style={`width: ${parte.pct}%`}></span>
              ))}
            </div>
          )
        }
        <ul class="leyenda">
          {inicio.barra.map((parte) => (
            <li>
              {parte.href ? (
                <a href={parte.href}>{parte.tono ? <span class:list={["punto", `punto--${parte.tono}`]} aria-hidden="true"></span> : null}{parte.label} {parte.pct}%</a>
              ) : (
                <span>{parte.tono ? <span class:list={["punto", `punto--${parte.tono}`]} aria-hidden="true"></span> : null}{parte.label} {parte.pct}%</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {
    usadas.has("stats") && (
      <section class="bloque numeros" style="grid-area: stats" aria-label="Números del día">
        {inicio.numeros.map((numero) =>
          numero.href ? (
            <a class:list={["numero", numero.tono && `numero--${numero.tono}`]} href={numero.href}>
              <span class="numero__valor">{numero.valor}</span>
              <span class="numero__rotulo">{numero.label}</span>
            </a>
          ) : (
            <p class:list={["numero", numero.tono && `numero--${numero.tono}`]}>
              <span class="numero__valor">{numero.valor}</span>
              <span class="numero__rotulo">{numero.label}</span>
            </p>
          ),
        )}
      </section>
    )
  }
  {
    usadas.has("agenda") && (
      <section class="bloque" style="grid-area: agenda" aria-labelledby="inicio-agenda">
        <h2 id="inicio-agenda">Hoy</h2>
        {inicio.agenda.length === 0 ? (
          <p class="muted">Nada vence hoy.</p>
        ) : (
          <ol class="agenda">
            {inicio.agenda.map((item) => (
              <li>
                {item.href ? <a href={item.href}>{item.titulo}</a> : <span>{item.titulo}</span>}
                {item.detalle ? <span class="muted">{item.detalle}</span> : null}
              </li>
            ))}
          </ol>
        )}
      </section>
    )
  }
  {
    usadas.has("table") && inicio.tabla && (
      <section class="bloque bloque--tabla" style="grid-area: table" aria-labelledby="inicio-tabla">
        <h2 id="inicio-tabla">
          {inicio.tabla.href ? <a href={inicio.tabla.href}>{inicio.tabla.titulo}</a> : inicio.tabla.titulo}
        </h2>
        {inicio.tabla.filas.length === 0 ? (
          <p class="muted">La cola está vacía.</p>
        ) : (
          <div class="table-wrap">
          <table class:list={[plano && "mo-table"]}>
            {!plano && <caption class="muted">{inicio.tabla.filas.length} en la cola.</caption>}
            <thead>
              <tr>
                {inicio.tabla.columnas.map((columna) => (
                  <th scope="col">{columna}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {inicio.tabla.filas.map((fila) => (
                <tr>
                  {fila.celdas.map((celda, i) => (
                    <td>
                      {fila.tonos?.[i] ? <span class:list={["estado", `estado--${fila.tonos[i]}`]}>{celda}</span> : celda}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          </div>
        )}
      </section>
    )
  }
  {
    usadas.has("verdict") && inicio.veredicto && (
      <section class="bloque veredicto" style="grid-area: verdict" aria-labelledby="inicio-veredicto">
        <h2 id="inicio-veredicto">
          {inicio.veredicto.href ? <a href={inicio.veredicto.href}>{inicio.veredicto.titulo}</a> : inicio.veredicto.titulo}
        </h2>
        <p class="veredicto__principal">{inicio.veredicto.principal}</p>
        <p class="veredicto__secundario">{inicio.veredicto.secundario}</p>
      </section>
    )
  }
  {
    usadas.has("series") && inicio.serie && (
      <section class="bloque bloque--serie" style="grid-area: series" aria-labelledby="inicio-serie">
        <h2 id="inicio-serie">
          {inicio.serie.href ? <a href={inicio.serie.href}>{inicio.serie.titulo}</a> : inicio.serie.titulo}
        </h2>
        <ol class="serie">
          {inicio.serie.puntos.map((punto) => (
            <li>
              <span>{punto.label}</span>
              <span class="serie__barra" style={`--valor: ${(punto.valor / maxSerie) * 100}%`}></span>
              <span class="num">{punto.valor}</span>
            </li>
          ))}
        </ol>
      </section>
    )
  }
  {
    usadas.has("comp") && inicio.composicion && (
      <section class="bloque bloque--comp" style="grid-area: comp" aria-labelledby="inicio-composicion">
        <h2 id="inicio-composicion">
          {inicio.composicion.href ? (
            <a href={inicio.composicion.href}>{inicio.composicion.titulo}</a>
          ) : (
            inicio.composicion.titulo
          )}
        </h2>
        <div class="dona" style={`--pct: ${inicio.composicion.partes[0]?.pct ?? 0}%`}>
          <p class="numero">
            <span class="numero__valor">{inicio.composicion.total}</span>
            <span class="numero__rotulo">en total</span>
          </p>
        </div>
        <ul class="leyenda">
          {inicio.composicion.partes.map((parte) => (
            <li>
              <span>{parte.label}</span>
              <span class="num">{parte.pct}%</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>

<style>
  .inicio-mosaico {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(14rem, 18rem) minmax(0, 1fr) minmax(14rem, 17rem);
    align-items: start;
  }
  .bloque {
    background: var(--mo-canvas);
    border: 1px solid var(--mo-line);
    border-radius: var(--mo-radius);
    padding: 1rem;
  }
  .saludo {
    background: transparent;
    border: 0;
    padding: 0.25rem 0;
  }
  .saludo h1 {
    margin: 0;
    font-family: var(--mo-display);
    font-size: clamp(1.85rem, 3vw, 2.4rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--mo-ink);
  }
  .saludo p,
  .bloque h2,
  .muted,
  .numero__rotulo {
    color: var(--mo-muted);
  }
  .bloque h2 {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    font-weight: 650;
  }
  .bloque a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    touch-action: manipulation;
  }
  .numeros {
    display: grid;
    gap: 0.85rem;
  }
  .numero {
    display: grid;
    margin: 0;
    color: inherit;
    text-decoration: none;
  }
  a.numero {
    min-height: 44px;
    align-content: center;
  }
  .numero__valor {
    font-family: var(--mo-display);
    font-size: 2rem;
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--mo-ink);
  }
  .pista {
    display: flex;
    height: 1.75rem;
    overflow: hidden;
    border-radius: var(--mo-radius-sm);
    background: var(--mo-card);
  }
  .tramo--enlace { background: var(--mo-accent); }
  .tramo--quieto { background: var(--mo-line-strong); }
  .pista .tramo:nth-child(2) { background: var(--mo-ink); }
  .pista .tramo:nth-child(3) { background: var(--mo-line-strong); }
  .leyenda,
  .agenda,
  .serie {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .leyenda { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
  .agenda li {
    display: grid;
    gap: 0.1rem;
  }
  .serie li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) 2rem;
    gap: 0.5rem;
    align-items: center;
  }
  .serie__barra {
    height: 0.45rem;
    border-radius: 2px;
    background: linear-gradient(to right, var(--mo-accent) var(--valor), var(--mo-line) var(--valor));
  }
  .num { font-variant-numeric: tabular-nums; text-align: right; }
  table { width: 100%; border-collapse: collapse; }
  caption { text-align: left; margin-bottom: 0.5rem; }
  th, td {
    padding: 0.55rem 0.4rem;
    border-bottom: 1px solid var(--mo-line);
    text-align: left;
  }
  th { color: var(--mo-muted); font-weight: 600; font-size: 0.8rem; }
  .veredicto {
    background: var(--mo-hero);
    color: var(--mo-on-hero);
    border-color: var(--mo-hero);
  }
  .veredicto h2,
  .veredicto a,
  .veredicto__principal,
  .veredicto__secundario { color: inherit; }
  .veredicto__principal {
    margin: 0;
    font-family: var(--mo-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .veredicto__secundario { margin: 0.35rem 0 0; }
  .dona {
    width: 9rem;
    height: 9rem;
    margin: 0 auto;
    border-radius: 50%;
    background: conic-gradient(var(--mo-accent) var(--pct), var(--mo-warn, var(--mo-line-strong)) 0);
    display: grid;
    place-items: center;
  }
  .dona p {
    margin: 0;
    width: 6.2rem;
    height: 6.2rem;
    border-radius: 50%;
    background: var(--mo-canvas);
    display: grid;
    place-items: center;
    align-content: center;
  }
  .inicio-mosaico--plano { gap: 1.25rem 2.5rem; }
  .inicio-mosaico--plano .bloque {
    background: transparent;
    border: 0;
    padding: 0;
  }
  .inicio-mosaico--plano .saludo h1,
  .inicio-mosaico--plano .bloque h2 { text-wrap: balance; }
  .inicio-mosaico--plano .bloque h2 {
    margin: 0 0 0.6rem;
    color: var(--mo-muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .inicio-mosaico--plano .pista { height: 0.65rem; }
  .inicio-mosaico--plano .numeros {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.5rem;
  }
  .inicio-mosaico--plano .bloque a.numero,
  .inicio-mosaico--plano .numero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.2rem;
    align-items: start;
    justify-items: start;
  }
  .inicio-mosaico--plano .numero__rotulo {
    line-height: 1.35;
    text-wrap: pretty;
  }
  .inicio-mosaico--plano .bloque--tabla {
    background: transparent;
    padding: 0;
  }
  .inicio-mosaico--plano .table-wrap {
    overflow: auto;
    scroll-padding-top: 3rem;
    scroll-padding-bottom: 4.5rem;
  }
  .inicio-mosaico--plano .mo-table th,
  .inicio-mosaico--plano .mo-table td {
    white-space: normal;
    overflow-wrap: break-word;
  }
  .inicio-mosaico--plano tbody tr {
    content-visibility: auto;
    contain-intrinsic-size: auto 2.75rem;
  }
  .inicio-mosaico--plano .veredicto {
    background: transparent;
    color: var(--mo-ink);
    border: 0;
    border-left: 3px solid var(--mo-accent);
    border-radius: 0;
    padding: 0.15rem 0 0.15rem 0.85rem;
  }
  .inicio-mosaico--plano .veredicto a,
  .inicio-mosaico--plano .veredicto__principal { color: var(--mo-ink); }
  .inicio-mosaico--plano .veredicto__principal {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  .inicio-mosaico--plano .bloque--serie { min-width: 0; }
  .inicio-mosaico--plano .bloque--serie .num {
    color: var(--mo-muted);
    font-weight: 500;
  }
  .inicio-mosaico--plano .bloque--comp {
    min-width: 0;
    border-left: 0;
    padding-left: 0;
  }
  .inicio-mosaico--plano .bloque--comp .dona { margin: 0; }
  .inicio-mosaico--plano .bloque--comp .numero__valor { font-size: 1.35rem; }
  .inicio-mosaico--plano .bloque--comp .leyenda {
    display: grid;
    justify-items: start;
    margin-top: 0.85rem;
    color: var(--mo-muted);
  }
  .inicio-mosaico--plano .veredicto__secundario { color: var(--mo-muted); }
  .inicio-mosaico--plano .dona {
    width: 6.5rem;
    height: 6.5rem;
    background: conic-gradient(var(--mo-accent) var(--pct), var(--mo-line) 0);
  }
  .inicio-mosaico--plano .dona p {
    width: 5.5rem;
    height: 5.5rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .inicio-mosaico--plano .bloque a:hover { color: var(--mo-ink); }
  }
  @media (max-width: 960px) {
    .inicio-mosaico {
      grid-template-columns: 1fr;
      grid-template-areas: none !important;
    }
    .inicio-mosaico > * { grid-area: auto !important; }
    .inicio-mosaico--plano > .bloque { order: 2; }
    .inicio-mosaico--plano > .saludo,
    .inicio-mosaico--plano > .numeros { order: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .inicio-mosaico { scroll-behavior: auto; }
  }
  .pista .tramo.tramo--accent { background: var(--mo-accent); }
  .pista .tramo.tramo--ok { background: var(--mo-ok); }
  .pista .tramo.tramo--warn { background: var(--mo-warn); }
  .pista .tramo.tramo--ink { background: var(--mo-ink); }
  .pista .tramo.tramo--line { background: var(--mo-line-strong); }
  .punto {
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    flex: none;
  }
  .punto--accent { background: var(--mo-accent); }
  .punto--ok { background: var(--mo-ok); }
  .punto--warn { background: var(--mo-warn); }
  .punto--ink { background: var(--mo-ink); }
  .punto--line { background: var(--mo-line-strong); }
  .estado {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 26px;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--mo-line);
    font-size: 0.75rem;
    font-weight: 650;
  }
  .estado::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
  }
  .estado--ok {
    background: var(--mo-ok-soft);
    color: var(--mo-ok);
    border-color: color-mix(in srgb, var(--mo-ok) 28%, var(--mo-line));
  }
  .estado--ok::before { background: var(--mo-ok); }
  .estado--warn {
    background: color-mix(in srgb, var(--mo-warn) 14%, var(--mo-canvas));
    color: var(--mo-warn);
    border-color: color-mix(in srgb, var(--mo-warn) 30%, var(--mo-line));
  }
  .estado--warn::before { background: var(--mo-warn); }
  .estado--accent {
    background: var(--mo-accent-soft);
    color: var(--mo-accent);
    border-color: color-mix(in srgb, var(--mo-accent) 28%, var(--mo-line));
  }
  .estado--accent::before { background: var(--mo-accent); }
  .inicio-mosaico--color .numero--accent .numero__valor { color: var(--mo-accent); }
  .inicio-mosaico--color .numero--warn .numero__valor { color: var(--mo-warn); }
  .inicio-mosaico--color .veredicto__principal { color: var(--mo-accent); }
  .inicio-mosaico--color .veredicto__secundario { color: var(--mo-warn); }
</style>
