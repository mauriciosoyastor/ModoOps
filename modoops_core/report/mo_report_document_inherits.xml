<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Swap Odoo company layout for modoops brand on shell-facing PDFs. -->

  <template id="report_saleorder_document_modoops"
            inherit_id="sale.report_saleorder_document">
    <xpath expr="//t[@t-call='web.external_layout' or @t-call='modoops_core.report_modoops_layout']" position="attributes">
      <attribute name="t-call">modoops_core.report_modoops_layout</attribute>
    </xpath>
    <xpath expr="//div[hasclass('page')]" position="attributes">
      <attribute name="style">font-family: DejaVu Sans, sans-serif; color: #1a1a1a; font-size: 12px;</attribute>
    </xpath>
  </template>

  <template id="report_purchaseorder_document_modoops"
            inherit_id="purchase.report_purchaseorder_document">
    <xpath expr="//t[@t-call='web.external_layout' or @t-call='modoops_core.report_modoops_layout']" position="attributes">
      <attribute name="t-call">modoops_core.report_modoops_layout</attribute>
    </xpath>
    <xpath expr="//div[hasclass('page')]" position="attributes">
      <attribute name="style">font-family: DejaVu Sans, sans-serif; color: #1a1a1a; font-size: 12px;</attribute>
    </xpath>
  </template>

  <template id="report_purchasequotation_document_modoops"
            inherit_id="purchase.report_purchasequotation_document">
    <xpath expr="//t[@t-call='web.external_layout' or @t-call='modoops_core.report_modoops_layout']" position="attributes">
      <attribute name="t-call">modoops_core.report_modoops_layout</attribute>
    </xpath>
    <xpath expr="//div[hasclass('page')]" position="attributes">
      <attribute name="style">font-family: DejaVu Sans, sans-serif; color: #1a1a1a; font-size: 12px;</attribute>
    </xpath>
  </template>

  <!-- primary=True: do not mutate account.report_invoice_document (breaks
       account_edi_ubl_cii's primary inherit that still looks for
       web.external_layout on the shared base document). -->
  <template id="report_invoice_document_modoops"
            inherit_id="account.report_invoice_document"
            primary="True">
    <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
      <attribute name="t-call">modoops_core.report_modoops_layout</attribute>
    </xpath>
    <xpath expr="//div[hasclass('page')]" position="attributes">
      <attribute name="style">font-family: DejaVu Sans, sans-serif; color: #1a1a1a; font-size: 12px;</attribute>
    </xpath>
  </template>

  <template id="report_invoice_modoops_dispatch"
            inherit_id="account.report_invoice">
    <xpath expr="//t[@t-call='account.report_invoice_document']" position="after">
      <t t-elif="o._get_name_invoice_report() == 'modoops_core.report_invoice_document_modoops'"
         t-call="modoops_core.report_invoice_document_modoops"
         t-lang="lang"/>
    </xpath>
  </template>
</odoo>
