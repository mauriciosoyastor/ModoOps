<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_modoops_tenant_log_list" model="ir.ui.view">
        <field name="name">modoops.tenant.log.list</field>
        <field name="model">modoops.tenant.log</field>
        <field name="arch" type="xml">
            <list string="Logs Control Plane" create="0" edit="0">
                <field name="create_date"/>
                <field name="tenant_id"/>
                <field name="action"/>
                <field name="detail"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_modoops_tenant_log_form" model="ir.ui.view">
        <field name="name">modoops.tenant.log.form</field>
        <field name="model">modoops.tenant.log</field>
        <field name="arch" type="xml">
            <form string="Log" create="0" edit="0">
                <group>
                    <field name="tenant_id"/>
                    <field name="action"/>
                    <field name="detail"/>
                    <field name="user_id"/>
                    <field name="create_date"/>
                </group>
            </form>
        </field>
    </record>
    <record id="action_modoops_tenant_log" model="ir.actions.act_window">
        <field name="name">Logs Tenants</field>
        <field name="res_model">modoops.tenant.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_modoops_logs" name="Logs" parent="menu_modoops_admin" action="action_modoops_tenant_log" sequence="20"/>
</odoo>
