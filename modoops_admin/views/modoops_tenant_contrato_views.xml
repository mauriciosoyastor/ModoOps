<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_modoops_tenant_contrato_search" model="ir.ui.view">
        <field name="name">modoops.tenant.contrato.search</field>
        <field name="model">modoops.tenant.contrato</field>
        <field name="arch" type="xml">
            <search string="Contratos ModoOps">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="tipo"/>
                <field name="state"/>
                <filter string="Vigentes" name="filter_vigente" domain="[('state','=','vigente')]"/>
                <filter string="Listos para cobrar saldo" name="filter_cobrar" domain="[('state','=','vigente'),('hito2_ok','=',True),('saldo_cobrado','=',False)]"/>
                <filter string="Sin anticipo" name="filter_sin_anticipo" domain="[('anticipo_cobrado','=',False)]"/>
                <filter string="Sin fiscal" name="filter_sin_fiscal" domain="[('anexo_fiscal_ok','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="view_modoops_tenant_contrato_tree" model="ir.ui.view">
        <field name="name">modoops.tenant.contrato.tree</field>
        <field name="model">modoops.tenant.contrato</field>
        <field name="arch" type="xml">
            <list string="Contratos ModoOps" sample="1">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="tipo"/>
                <field name="state" widget="badge" decoration-success="state=='vigente'" decoration-muted="state in ('finalizado','borrador')" decoration-danger="state=='rescindido'"/>
                <field name="situacion"/>
                <field name="monto_total_usd"/>
                <field name="saldo_usd"/>
                <field name="saldo_cobrado"/>
                <field name="hito2_ok"/>
                <field name="go_live_date"/>
            </list>
        </field>
    </record>

    <record id="view_modoops_tenant_contrato_form" model="ir.ui.view">
        <field name="name">modoops.tenant.contrato.form</field>
        <field name="model">modoops.tenant.contrato</field>
        <field name="arch" type="xml">
            <form string="Contrato ModoOps">
                <header>
                    <button name="action_marcar_vigente" type="object" string="Marcar vigente (anticipo 50%)" class="oe_highlight" invisible="state != 'borrador'"/>
                    <button name="action_generar_acta_hito2" type="object" string="Generar acta Hito 2" icon="fa-file-text"/>
                    <button name="action_imprimir_acta_pdf" type="object" string="Acta PDF" icon="fa-file-pdf-o"/>
                    <button name="action_marcar_finalizado" type="object" string="Finalizar (Hito 2 + saldo)" class="oe_highlight" invisible="state != 'vigente'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="MO-2026-001"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not situacion_detalle">
                        <field name="situacion_detalle" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <group>
                        <group string="Contrato">
                            <field name="tenant_id"/>
                            <field name="tipo"/>
                            <field name="state" widget="badge"/>
                            <field name="fecha_firma"/>
                            <field name="moneda"/>
                        </group>
                        <group string="Pagos ancla 50/50 USD">
                            <field name="monto_total_usd"/>
                            <field name="anticipo_usd"/>
                            <field name="saldo_usd" readonly="1"/>
                            <field name="anticipo_cobrado"/>
                            <field name="saldo_cobrado"/>
                        </group>
                    </group>
                    <group>
                        <group string="Hitos y fiscal">
                            <field name="hito1_ok"/>
                            <field name="hito2_ok"/>
                            <field name="go_live_date"/>
                            <field name="hipercare_hasta"/>
                            <field name="anexo_fiscal_ok"/>
                        </group>
                        <group string="Horas y abono">
                            <field name="abono_mensual_usd"/>
                            <field name="ajustes_horas_pactadas"/>
                            <field name="ajustes_horas_consumidas"/>
                            <field name="capacitacion_horas_pactadas"/>
                            <field name="capacitacion_horas_dadas"/>
                        </group>
                    </group>
                    <group string="PDF firmado">
                        <field name="contrato_pdf" filename="contrato_pdf_filename"/>
                        <field name="contrato_pdf_filename" invisible="1"/>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1" placeholder="Anexo A lista cerrada, Anexo B fiscal, acta Hito 2..."/>
                    </group>
                    <notebook>
                        <page string="Actividad" name="chatter">
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_modoops_tenant_contrato" model="ir.actions.act_window">
        <field name="name">Contratos ModoOps</field>
        <field name="res_model">modoops.tenant.contrato</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
