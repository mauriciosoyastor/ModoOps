<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_modoops_tenant_tree" model="ir.ui.view">
        <field name="name">modoops.tenant.tree</field>
        <field name="model">modoops.tenant</field>
        <field name="arch" type="xml">
            <list string="Tenants ModoOps">
                <field name="name"/>
                <field name="db_name"/>
                <field name="vertical"/>
                <field name="state" decoration-danger="state=='suspendido'" decoration-muted="state=='baja'"/>
                <field name="abono_due_date"/>
                <field name="last_backup"/>
            </list>
        </field>
    </record>

    <record id="view_modoops_tenant_form" model="ir.ui.view">
        <field name="name">modoops.tenant.form</field>
        <field name="model">modoops.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant ModoOps">
                <header>
                    <button name="action_install_module" type="object" string="Instalar/Quitar módulo" icon="fa-cogs" class="oe_highlight"/>
                    <button name="action_suspend" type="object" string="Suspender (mora)" icon="fa-ban" confirm="¿Confirmar Suspender? Día 8 de mora, gracia vencida. WhatsApp avisado día 1 y 5." invisible="state != 'activo'"/>
                    <button name="action_reactivate" type="object" string="Reactivar" icon="fa-check" invisible="state != 'suspendido'"/>
                    <button name="action_mark_baja" type="object" string="Baja (backup final)" icon="fa-trash" confirm="¿Baja definitiva día 15? Requiere backup final y confirmación explícita. No borra DB automáticamente." invisible="state != 'suspendido'" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Pinturería Centro"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'activo' or not suspend_grace_until">
                        Gracia hasta <field name="suspend_grace_until" readonly="1" nolabel="1" class="d-inline"/> — suspender solo desde día 8.
                    </div>
                    <group>
                        <group string="Infra">
                            <field name="db_name" placeholder="modoops_pintureria_centro"/>
                            <field name="slug"/>
                            <field name="vertical"/>
                            <field name="state" widget="badge" decoration-success="state=='activo'"/>
                        </group>
                        <group string="Gestión">
                            <field name="abono_due_date"/>
                            <field name="suspend_grace_until" readonly="1"/>
                            <field name="last_warning_sent"/>
                            <field name="last_backup"/>
                        </group>
                    </group>
                    <group string="Módulos del Catálogo ModoOps">
                        <field name="modules_installed" placeholder="Mostrador, Depósito Inteligente, Compras, Fiscal AR"/>
                        <div class="text-muted">Solo Catálogo ModoOps. Wizard mock valida; ejecución real vía provision_tenant.py.</div>
                    </group>
                    <group string="Notas">
                        <field name="notes"/>
                    </group>
                    <notebook>
                        <page string="Chatter" name="chatter">
                            <field name="message_ids" widget="mail_thread"/>
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="activity_ids" widget="mail_activity"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_modoops_tenant" model="ir.actions.act_window">
        <field name="name">Tenants ModoOps</field>
        <field name="res_model">modoops.tenant</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
