<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_modoops_tenant_install_wizard_form" model="ir.ui.view">
        <field name="name">modoops.tenant.install.wizard.form</field>
        <field name="model">modoops.tenant.install.wizard</field>
        <field name="arch" type="xml">
            <form string="Instalar/Quitar módulo (Catálogo ModoOps)">
                <group>
                    <field name="tenant_id" readonly="1"/>
                    <field name="module_key" widget="selection"/>
                    <field name="action" widget="radio"/>
                    <field name="preview_command" readonly="1" class="text-muted"/>
                </group>
                <group string="Módulos seleccionados — cards Ancla/Add-on (batch)">
                    <field name="line_ids" nolabel="1">
                        <list string="Módulos" editable="bottom">
                            <field name="module_key" widget="badge" decoration-success="module_key in ['mostrador','deposito','compras','fiscal_ar','contactos','migracion_excel']" decoration-warning="module_key in ['taller','b2b_basico']"/>
                            <field name="preview_command" readonly="1"/>
                        </list>
                        <kanban class="o_kanban_mobile">
                            <field name="module_key"/>
                            <field name="preview_command"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_global_click">
                                        <div class="o_kanban_record p-2">
                                            <strong><field name="module_key"/></strong>
                                            <div class="text-muted small"><field name="preview_command"/></div>
                                            <span t-if="record.module_key.raw_value == 'mostrador'" class="badge bg-success">Ancla</span>
                                            <span t-if="record.module_key.raw_value == 'taller'" class="badge bg-warning">Add-on</span>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </group>
                <group string="Notas">
                    <field name="notes" placeholder="Ticket, validación, motivo (mock no ejecuta odoo-bin real)"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Catálogo ModoOps — Ancla: Mostrador, Depósito, Compras, Fiscal AR, Contactos, Migración Excel — Add-on: Taller, B2B Básico. Validación <code>module_required</code> / <code>depends</code> antes de instalar.
                </div>
                <div class="text-muted">
                    Preview: <code>odoo-bin -d &lt;tenant&gt; -i &lt;modulo&gt;</code> — Mock escribe <code>modules_installed</code> + <code>modoops.tenant.log</code> + <code>mail_thread</code>. Error deps / ya instalado / no instalado → toast + log reintentable.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar (mock)" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_modoops_tenant_install_wizard_line_kanban" model="ir.ui.view">
        <field name="name">modoops.tenant.install.wizard.line.kanban</field>
        <field name="model">modoops.tenant.install.wizard.line</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="module_key"/>
                <field name="preview_command"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record">
                                <strong><field name="module_key"/></strong>
                                <div class="text-muted small"><field name="preview_command"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
